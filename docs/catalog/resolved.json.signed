          {
            "file": "TizenAmbilight.tpk",
            "name": "TizenAmbilight",
            "description": "Real-frame ambilight: reads the TV\u0027s own video plane in memory and drives a WLED strip over UDP. While a streaming app\u0027s DRM withholds the plane, falls back to the TV\u0027s built-in RGB measurement (coarser and slower). Headless background service (.tpk); no Hyperion/HyperHDR needed.",
            "category": "tools",
            "variant": "TizenAmbilight",
            "repo": "RitwickVerma/TizenAmbilight",
            "host": "github",
            "version": "1.0.0",
            "app_id": "dev.ritwickverma.TizenAmbilight",
            "package_id": "dev.ritwickverma.TizenAmbilight",
            "user_settings": {
              "help_url": "https://github.com/RitwickVerma/TizenAmbilight#configuration",
              "file": "res/config.json",
              "fields": [
                {
                  "key": "wled_ip",
                  "label": "WLED controller IP address (e.g. 192.168.1.50)",
                  "type": "text",
                  "required": true,
                  "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$",
                  "find": "\u0022wledIp\u0022: \u0022\u0022",
                  "replace": "\u0022wledIp\u0022: \u0022{value}\u0022",
                  "isNumber": false
                },
                {
                  "key": "led_count",
                  "label": "Number of LEDs on the strip (max 490)",
                  "type": "number",
                  "required": true,
                  "pattern": "^[0-9]{1,3}$",
                  "find": "\u0022ledCount\u0022: 0,",
                  "replace": "\u0022ledCount\u0022: {value},",
                  "isNumber": true
                },
                {
                  "key": "map_offset",
                  "label": "Where the strip\u0027s first LED sits: LEDs counted clockwise from the screen\u0027s top-left corner, seen from the front (0 = it starts at the top-left corner)",
                  "type": "number",
                  "required": true,
                  "pattern": "^[0-9]{1,3}$",
                  "find": "\u0022mapOffset\u0022: 0,",
                  "replace": "\u0022mapOffset\u0022: {value},",
                  "isNumber": true
                },
                {
                  "key": "map_reverse",
                  "label": "Does the strip run counter-clockwise, seen from the front? 0 = no (clockwise), 1 = yes",
                  "type": "number",
                  "required": true,
                  "pattern": "^[01]$",
                  "find": "\u0022mapReverse\u0022: 0,",
                  "replace": "\u0022mapReverse\u0022: {value},",
                  "isNumber": true
                },
                {
                  "key": "ppi_zones",
                  "label": "Optional. Only used while the picture is DRM-protected (e.g. a streaming app): how many spots round the screen edge are measured. 24 is a good default; fewer = each spot updates faster but the colour is coarser (4-73). Leave the default if unsure",
                  "type": "number",
                  "required": false,
                  "pattern": "^([4-9]|[1-6][0-9]|7[0-3])$",
                  "find": "\u0022ppiZones\u0022: 24,",
                  "replace": "\u0022ppiZones\u0022: {value},",
                  "isNumber": true
                }
              ]
            }
          },
