            "version": "0.3.5",
            "app_id": "vetrotvapp.app",
            "package_id": "vetrotvapp",
            "required_version": "3.0",
            "user_settings": {
              "help_url": "https://github.com/andrearicci93/vetro/blob/main/app/docs/INSTALLATION.md",
              "file": "",
              "fields": [
                {
                  "key": "port",
                  "label": "Dashboard port (default 8099; change it if tizen-youtube is installed)",
                  "type": "number",
                  "required": false,
                  "find": "",
                  "replace": "",
                  "targets": [
                    {
                      "file": "config.xml",
                      "find": "\u003Caccess origin=\u0022http://127.0.0.1:8099\u0022 subdomains=\u0022false\u0022/\u003E",
                      "replace": "\u003Caccess origin=\u0022http://127.0.0.1:{value}\u0022 subdomains=\u0022false\u0022/\u003E"
                    },
                    {
                      "file": "index.html",
                      "find": "var BASE = \u0027http://127.0.0.1:8099\u0027;",
                      "replace": "var BASE = \u0027http://127.0.0.1:{value}\u0027;"
                    },
                    {
                      "file": "index.html",
                      "find": "Dashboard at \u003Ccode\u003Ehttp://\u0026lt;TV\u0026gt;:8099/\u003C/code\u003E",
                      "replace": "Dashboard at \u003Ccode\u003Ehttp://\u0026lt;TV\u0026gt;:{value}/\u003C/code\u003E"
                    },
                    {
                      "file": "index.html",
                      "find": "did not answer on port 8099.",
                      "replace": "did not answer on port {value}."
                    },
                    {
                      "file": "service/main.js",
                      "find": "|| buildInfo.port || 8099;",
                      "replace": "|| buildInfo.port || {value};"
                    }
                  ],
                  "default": "8099",
                  "min": 1024,
                  "max": 65535,
                  "disallow": [
                    8001,
                    8002,
                    26101
                  ],
                  "isNumber": true
                }
              ]
            },
            "flags": [
              "root"
            ]
          },
