          },
          {
            "file": "TizenDebugApp-tizen3.wgt",
            "name": "Tizen Debug App",
            "description": "Developer toolkit for troubleshooting apps and monitoring system state on real Samsung Tizen TV hardware. Hybrid web \u002B .NET/C\u002B\u002B build for Tizen 4.0\u002B, plus a web-only build for Tizen 3.0.",
            "category": "tools",
            "group": "Tizen Debug App",
            "variant": "Tizen 3.0",
            "repo": "no-cover/tizendebugapp",
            "host": "github",
            "version": "1.0.0",
            "app_id": "2pUgzM8cvD.TizenDebugApp",
            "package_id": "2pUgzM8cvD",
            "required_version": "3.0"
