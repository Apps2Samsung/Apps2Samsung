            "package_id": "org.baobab.signage",
            "user_settings": {
              "help_url": "https://github.com/Gonqas/baobab#readme",
              "file": "js/config.js",
              "fields": [
                {
                  "key": "api_base_url",
                  "label": "Baobab server URL (e.g. http://192.168.1.10:4000)",
                  "type": "text",
                  "required": true,
                  "pattern": "^https?://[^\\s\u0027\\\u0022\\\\]\u002B$",
                  "find": "API_BASE_URL: \u0027\u0027,",
                  "replace": "API_BASE_URL: \u0027{value}\u0027,",
                  "isNumber": false
                },
                {
                  "key": "screen_key",
                  "label": "Screen key (e.g. display-1)",
                  "type": "text",
                  "required": true,
                  "pattern": "^[A-Za-z0-9._-]\u002B$",
                  "find": "SCREEN_KEY: \u0027\u0027,",
                  "replace": "SCREEN_KEY: \u0027{value}\u0027,",
                  "isNumber": false
                }
              ]
            }
