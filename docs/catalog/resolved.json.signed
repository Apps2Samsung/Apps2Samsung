            "version": "1.0.0",
            "app_id": "HavenHome1.Haven",
            "package_id": "HavenHome1",
            "required_version": "3.0",
            "user_settings": {
              "help_url": "https://github.com/natureglass/haven-tizen-ha#readme",
              "file": "shell-config.js",
              "fields": [
                {
                  "key": "ha_address",
                  "label": "Home Assistant address, for example http://192.168.1.10:8123",
                  "type": "text",
                  "required": true,
                  "pattern": "^https?://[A-Za-z0-9.-]\u002B(:[0-9]\u002B)?$",
                  "find": "base: \u0022\u0022",
                  "replace": "base: \u0022{value}/local/haven/\u0022",
                  "isNumber": false
                },
                {
                  "key": "ha_token",
                  "label": "Home Assistant long-lived access token (your profile, Security tab)",
                  "type": "text",
                  "required": true,
                  "pattern": "^[A-Za-z0-9._-]\u002B$",
                  "find": "haToken: \u0022\u0022",
                  "replace": "haToken: \u0022{value}\u0022",
                  "isNumber": false
                }
              ]
            }
          },
