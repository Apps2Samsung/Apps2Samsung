            "file": "Vetro.wgt",
            "name": "Vetro",
            "description": "TV management dashboard with root integration: app inventory, controls and diagnostics in your browser. After install, set Developer Mode Host PC IP to 127.0.0.1 and restart.",
            "category": "tools",
            "variant": "Vetro",
