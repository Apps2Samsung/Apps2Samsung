            "description": "Calm home screen: an icon dock, rows of films and shows to watch tonight on the apps you have, Up next from Trakt, search and trailers. The Home button, Control Center, sleep timer and app profiles need Vetro. Your country is asked on install; TMDB, Trakt, OMDb, Unsplash and YouTube keys are optional and written into the package.",
            "category": "home",
            "variant": "Settle",
            "repo": "SherrySingh03/settle",
            "host": "github",
            "version": "1.1.1",
            "app_id": "SettleTv01.Settle",
            "package_id": "SettleTv01",
            "required_version": "3.0",
            "user_settings": {
              "help_url": "https://github.com/SherrySingh03/settle/blob/main/docs/SETUP.md#installing-from-the-apps2samsung-catalogue",
              "file": "js/config.local.js",
              "fields": [
                {
                  "key": "region",
                  "label": "Your country, as a 2-letter code (US, GB, IN, DE...): where-to-watch and popular titles",
                  "type": "text",
                  "required": true,
                  "pattern": "^[A-Z]{2}$",
                  "find": "region: \u0022IN\u0022,",
                  "replace": "region: \u0022{value}\u0022,",
                  "isNumber": false
                },
                {
                  "key": "tmdb",
                  "label": "TMDB API key (v3), for the film and show rows, posters and search; optional",
                  "type": "text",
                  "required": false,
                  "pattern": "^[A-Za-z0-9]\u002B$",
                  "find": "tmdb: \u0022\u0022,",
                  "replace": "tmdb: \u0022{value}\u0022,",
                  "isNumber": false
                },
                {
                  "key": "trakt",
                  "label": "Trakt client id, for Up next, your watchlist and personal picks; optional",
                  "type": "text",
                  "required": false,
                  "pattern": "^[A-Za-z0-9]\u002B$",
                  "find": "traktClientId: \u0022\u0022,",
                  "replace": "traktClientId: \u0022{value}\u0022,",
                  "isNumber": false
                },
                {
                  "key": "omdb",
                  "label": "OMDb API key, for IMDb and Rotten Tomatoes ratings; optional",
                  "type": "text",
                  "required": false,
                  "pattern": "^[A-Za-z0-9]\u002B$",
                  "find": "omdb: \u0022\u0022,",
                  "replace": "omdb: \u0022{value}\u0022,",
                  "isNumber": false
                },
                {
                  "key": "unsplash",
                  "label": "Unsplash access key, for the wallpapers; optional",
                  "type": "text",
                  "required": false,
                  "pattern": "^[A-Za-z0-9_-]\u002B$",
                  "find": "unsplash: \u0022\u0022,",
                  "replace": "unsplash: \u0022{value}\u0022,",
                  "isNumber": false
                },
                {
                  "key": "youtube",
                  "label": "YouTube Data API v3 key, for Trending on YouTube above the dock; optional",
                  "type": "text",
                  "required": false,
                  "pattern": "^[A-Za-z0-9_-]\u002B$",
                  "find": "youtube: \u0022\u0022,",
                  "replace": "youtube: \u0022{value}\u0022,",
                  "isNumber": false
                },
                {
                  "key": "vetro_host",
                  "label": "Your TV\u0027s own IP address, only if Control Center says Vetro can\u0027t be reached; optional",
                  "type": "text",
                  "required": false,
                  "pattern": "^[0-9]{1,3}([.][0-9]{1,3}){3}$",
                  "find": "vetroHost: \u0022\u0022",
                  "replace": "vetroHost: \u0022{value}\u0022",
                  "isNumber": false
                },
                {
                  "key": "youtube_screen",
                  "label": "YouTube screen id, for trailers in the YouTube app (see the setup guide); optional",
                  "type": "text",
                  "required": false,
                  "pattern": "^[A-Za-z0-9_-]\u002B$",
                  "find": "screenId: \u0022\u0022",
                  "replace": "screenId: \u0022{value}\u0022",
                  "isNumber": false
                }
              ]
            },
            "preview_image": "https://raw.githubusercontent.com/SherrySingh03/settle/main/docs/img/home.jpg",
            "cert_level": "partner"
          },
