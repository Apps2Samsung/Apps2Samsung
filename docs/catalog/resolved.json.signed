            "app_id": "OpnCrmTV01.opencreamtv",
            "package_id": "OpnCrmTV01",
            "required_version": "5.0",
            "user_settings": {
              "help_url": "https://github.com/opencream-ai/opencream-tv/blob/main/INSTALL.md",
              "file": "js/config.local.js",
              "fields": [
                {
                  "key": "server",
                  "label": "IPTV server address (Xtream Codes), several separated by commas",
                  "type": "text",
                  "required": false,
                  "find": "servers: \u0022__OCTV_SERVER__\u0022,",
                  "replace": "servers: \u0022{value}\u0022,",
                  "default": "__OCTV_SERVER__",
                  "isNumber": false
                },
                {
                  "key": "username",
                  "label": "IPTV username",
                  "type": "text",
                  "required": false,
                  "find": "user: \u0022__OCTV_USER__\u0022,",
                  "replace": "user: \u0022{value}\u0022,",
                  "default": "__OCTV_USER__",
                  "isNumber": false
                },
                {
                  "key": "password",
                  "label": "IPTV password (stored by Apps2Samsung on this computer)",
                  "type": "text",
                  "required": false,
                  "find": "pass: \u0022__OCTV_PASS__\u0022,",
                  "replace": "pass: \u0022{value}\u0022,",
                  "default": "__OCTV_PASS__",
                  "isNumber": false
                },
                {
                  "key": "video_servers",
                  "label": "Optional: servers that deliver video, if your provider names them",
                  "type": "text",
                  "required": false,
                  "find": "streamServers: \u0022__OCTV_BACKUPS__\u0022",
                  "replace": "streamServers: \u0022{value}\u0022",
                  "default": "__OCTV_BACKUPS__",
                  "isNumber": false
                }
              ]
            }
          },
