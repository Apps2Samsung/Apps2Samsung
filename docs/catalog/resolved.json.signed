              "file": "dashboard-url.js",
              "fields": [
                {
                  "key": "dashboard_url",
                  "label": "Dashboard URL (your deployment, including the read key)",
                  "type": "text",
                  "required": true,
                  "pattern": "^https?://[^\\s\u0027\\\u0022\\\\]\u002B$",
                  "find": "window.DASHBOARD_URL = \u0022\u0022;",
                  "replace": "window.DASHBOARD_URL = \u0022{value}\u0022;",
                  "isNumber": false
                }
              ]
            }
