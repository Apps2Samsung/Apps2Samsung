            "file": "APLLauncher-Tizen6.wgt",
            "name": "APL Launcher",
            "description": "Apple-TV-style home screen: Top Shelf, glass dock, Control Center over any app, Settings and Sources. Needs Vetro on a rooted screen: pick the full package on Tizen 7 or newer, the launcher alone on Tizen 6. After install, open it and choose Settings \u203A Remote and Devices \u203A Set Up the Remote Buttons. Optional TMDB, YouTube and Fanart.tv keys are written into the package on install.",
            "category": "tools",
            "group": "APL Launcher",
            "variant": "Tizen 6 (launcher alone)",
            "repo": "Knikt/APL-Launcher-for-TizenOS",
            "host": "github",
            "version": "1.0.22",
            "app_id": "APLauncher.Home",
            "package_id": "APLauncher",
            "required_version": "2.4",
            "user_settings": {
              "help_url": "https://github.com/Knikt/APL-Launcher-for-TizenOS/blob/main/docs/installation.md#optional-api-keys",
              "file": "res/wgt/js/keys.local.js",
              "fields": [
                {
                  "key": "tmdb",
                  "label": "TMDB API key (v3), for the live Top Shelf; optional",
                  "type": "text",
                  "required": false,
                  "pattern": "^[A-Za-z0-9]\u002B$",
                  "find": "tmdb: \u0022\u0022,",
                  "replace": "tmdb: \u0022{value}\u0022,",
                  "isNumber": false
                },
                {
                  "key": "youtube",
                  "label": "YouTube Data API v3 key, for TizenTube\u0027s Top Shelf; optional",
                  "type": "text",
                  "required": false,
                  "pattern": "^[A-Za-z0-9_-]\u002B$",
                  "find": "youtube: \u0022\u0022,",
                  "replace": "youtube: \u0022{value}\u0022,",
                  "isNumber": false
                },
                {
                  "key": "fanart",
                  "label": "Fanart.tv API key, for textless HD backgrounds; optional",
                  "type": "text",
                  "required": false,
                  "pattern": "^[A-Za-z0-9]\u002B$",
                  "find": "fanart: \u0022\u0022,",
                  "replace": "fanart: \u0022{value}\u0022,",
                  "isNumber": false
                }
              ]
            },
            "flags": [
              "self-updating"
            ],
            "cert_level": "partner"
          },
