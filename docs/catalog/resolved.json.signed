                  "label": "Home Assistant address, for example http://192.168.1.10:8123",
                  "type": "text",
                  "required": true,
                  "pattern": "^https?://[A-Za-z0-9.-]\u002B(:[0-9]\u002B)?$",
                  "find": "base: \u0022\u0022",
                  "replace": "base: \u0022{value}/local/haven/\u0022",
                  "isNumber": false
