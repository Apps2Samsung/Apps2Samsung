      "note": "valid.signed against an approved fingerprint that isn't the key's."
    },
    {
      "file": "valid.signed",
      "key": "keys/test.pub.pem",
      "expect": "reject",
      "reason": "rollback",
      "notBefore": "2026-11-07T06:00:00Z",
      "note": "valid.signed after a newer manifest was already accepted."
    },
    {
      "file": "valid.signed",
      "key": "keys/test.pub.pem",
      "expect": "accept",
      "notBefore": "2026-11-07T00:00:00Z",
      "note": "The same manifest again is not a rollback."
    },
    {
      "file": "expired.signed",
      "key": "keys/test.pub.pem",
      "expect": "reject",
      "reason": "expired",
      "note": "Signed more than 7 days before now."
    },
    {
      "file": "future.signed",
