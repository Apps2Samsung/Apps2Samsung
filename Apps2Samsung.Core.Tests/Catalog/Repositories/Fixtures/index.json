{
  "now": "2026-11-07T12:00:00Z",
  "cases": [
    {
      "file": "valid.signed",
      "key": "keys/test.pub.pem",
      "expect": "accept",
      "note": "Two providers, signed with the test key. The first ships two builds of one version (current and legacy): variants, not a duplicate."
    },
    {
      "file": "tampered.signed",
      "key": "keys/test.pub.pem",
      "expect": "reject",
      "reason": "signature",
