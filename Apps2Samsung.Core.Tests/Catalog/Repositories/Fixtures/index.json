    },
    {
      "file": "bad-signature.signed",
      "key": "keys/test.pub.pem",
      "expect": "reject",
      "reason": "signature",
      "note": "Correct payload, signed with a different key."
    },
    {
      "file": "no-signature.signed",
      "key": "keys/test.pub.pem",
      "expect": "reject",
      "reason": "no-signature",
      "note": "The bare JSON without a signature line."
    },
    {
      "file": "weak-key.signed",
      "key": "keys/weak.pub.pem",
      "expect": "reject",
      "reason": "key",
      "note": "Signed and checked with a 2048-bit key; at least 3072 is required."
    },
    {
      "file": "valid.signed",
      "key": "keys/test.pub.pem",
      "expect": "reject",
      "reason": "fingerprint",
