<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Portable shared core for the desktop (Avalonia) and mobile (MAUI) heads.
         net10.0 only: a plain net10 library is consumable by both a net10 desktop
         app and a net10-android MAUI app, and its IL runs on MonoVM at runtime on
         Android (proven by the tizen-sdb probe). Multi-targeting -android here would
         force the desktop CI runners to install the Android workload just to restore. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Apps2Samsung</RootNamespace>
    <AssemblyName>Apps2Samsung.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <!-- The Tizen SDB protocol engine, in-process: backs Sdb/InProcessSdbEngine, which both heads
         run on (#549). Declared once, here, so the two heads can't drift apart on the version.
         The package ships lib/net10.0 and lib/net10.0-android36.0; Core compiles against net10.0
         while the MAUI head's own restore resolves the -android asset (with its Android-specific
         cert/socket branches) at build/run time. -->
    <PackageReference Include="TizenSdb.Core" Version="1.1.4" />
    <!-- TizenSdb.Core pulls System.Security.Cryptography.Xml 10.0.9, which carries five
         high-severity .NET DoS advisories (NU1903, all fixed in 10.0.10). Pin the patched version
         here so neither head ships the vulnerable one; drop this once tizen-sdb bumps it upstream. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <!-- The translated strings, embedded so both heads read one copy through
         Localization/LocalizationCatalog (a MAUI head can't read an Avalonia avares:// resource).
         The files deliberately stay in the desktop head's Assets folder: that is the path Crowdin
         syncs (crowdin.yml), and moving them would orphan the existing translations. -->
    <EmbeddedResource Include="..\Jellyfin2Samsung-CrossOS\Assets\Localization\*.json"
                      LogicalName="Apps2Samsung.Core.Localization.%(Filename).json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Offline copy of the community app-ID catalogue (Catalog/SamsungTvAppCatalog): the launcher
         list and the installed-apps icons both come from tizen-community-packages, and a phone with
         no network still has to show something. Embedded rather than per-head assets for the same
         reason the language files are. Refreshed by hand from the upstream file. -->
    <EmbeddedResource Include="Catalog\Data\samsung-tv-app-ids.json"
                      LogicalName="Apps2Samsung.Core.Catalog.samsung-tv-app-ids.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Apps2Samsung Debug agent (Agent/DebugAgentPackage): a three-file Tizen web app the
         toolbox installs on a TV with Developer Mode and drives over the web inspector, to reach the
         apps neither the remote channel nor SDB can launch (tizen-community-packages#34). Embedded so
         the agent a build installs is the one its client code was written against. -->
    <EmbeddedResource Include="Agent\Wgt\*"
                      LogicalName="Apps2Samsung.Core.DebugAgent.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
