<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Apps2Samsung.Extensions"
        xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:viewModels="clr-namespace:Apps2Samsung.ViewModels"
        xmlns:models="clr-namespace:Apps2Samsung.Models;assembly=Apps2Samsung.Core"
        x:Class="Apps2Samsung.Views.InstalledAppsWindow"
        xmlns:appicon="using:Apps2Samsung.Helpers"
        Icon="{x:Static appicon:AppIcon.Current}"
        x:Name="Root"
        x:DataType="viewModels:InstalledAppsViewModel"
        Width="560" MinWidth="460"
        Height="620" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Title="{l:Localize lblInstalledApps}">

    <Window.Styles>
        <StyleInclude Source="avares://Avalonia.Themes.Fluent/FluentTheme.xaml"/>
        <StyleInclude Source="avares://Apps2Samsung/Styles/Buttons.axaml"/>
        <StyleInclude Source="avares://Apps2Samsung/Styles/TextBlocks.axaml"/>
    </Window.Styles>

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="16">
        <DockPanel LastChildFill="True">

            <!-- Header -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{l:Localize lblInstalledApps}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TvLabel}" FontSize="12" Opacity="0.6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button Content="{l:Localize lblRemoveLeftover}" Command="{Binding RemoveLeftoverCommand}"
                            ToolTip.Tip="{l:Localize lblRemoveLeftoverHint}"
                            IsEnabled="{Binding !IsDebugging}"/>
                    <Button Content="↻" Command="{Binding LoadCommand}" ToolTip.Tip="{l:Localize lblRefresh}"
                            IsVisible="{Binding !IsDebugging}"/>
                    <Button Command="{Binding StopDebugCommand}" ToolTip.Tip="{l:Localize lblStopDebugging}"
                            IsVisible="{Binding IsDebugging}" Background="#FF6B6B">
                        <fa:SymbolIcon Symbol="StopFilled" Width="16" Height="16" Foreground="White"/>
                    </Button>
                    <Button Content="✕" Command="{Binding CloseCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Status -->
            <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" FontSize="12" Opacity="0.7" Margin="0,4,0,8"/>

            <!-- Busy indicator -->
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                         IsVisible="{Binding IsProgressVisible}"/>

            <!-- Install leftovers: sdbd's staging folder, where every pushed package still sits. Read and
                 cleared by the debug agent (attached on the first click). Only package files go. -->
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0" IsVisible="{Binding HasSdb}">
                <TextBlock Classes="section" Text="{l:Localize lblToolboxStaging}"/>
                <TextBlock Classes="hint" Text="{l:Localize lblToolboxStagingHint}"/>
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Content="{l:Localize lblToolboxStagingCheck}"
                            Command="{Binding CheckStagingCommand}" IsEnabled="{Binding !IsDebugging}"/>
                    <Button Grid.Column="1" Content="{l:Localize lblToolboxStagingClear}"
                            Command="{Binding ClearStagingCommand}" IsEnabled="{Binding HasStagedPackages}"/>
                    <TextBlock Grid.Column="2" Text="{Binding StagingStatus}" FontSize="12" Opacity="0.8"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
                <ScrollViewer MaxHeight="150" IsVisible="{Binding IsStagingListed}">
                    <ItemsControl ItemsSource="{Binding StagedFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:StagedFileRow">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4,1">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11" Opacity="0.55"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- App list -->
            <ScrollViewer IsEnabled="{Binding !IsDebugging}">
                <ScrollViewer.Styles>
                    <Style Selector="ScrollViewer[IsEnabled=False]">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Style>
                </ScrollViewer.Styles>
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:InstalledAppViewModel">
                            <Border Margin="0,3" Padding="12"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    
                                    <!-- App Icon or initials fallback -->
                                    <Panel Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center">
                                        <!-- Fallback placeholder -->
                                        <Border Background="{Binding App.FallbackColor}"
                                                IsVisible="{Binding App.MissingIcon}">
                                            <TextBlock Text="{Binding App.Initials}" 
                                                       Foreground="White" FontWeight="Bold" FontSize="20"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Actual icon -->
                                        <Image Source="{Binding IconBitmap}" Stretch="UniformToFill" 
                                               IsVisible="{Binding App.HasIcon}"/>
                                    </Panel>

                                    <!-- App info -->
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding App.DisplayName}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding App.TizenId}" FontSize="11" Opacity="0.55"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding App.Version, StringFormat='v{0}'}" FontSize="11" Opacity="0.55"/>
                                            <TextBlock Text="{Binding App.SizeDisplay}" FontSize="11" Opacity="0.55"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Row actions. Material Design Icons paths rather than FluentAvalonia symbols
                                         so the Android head can draw the very same shapes (MAUI has no Fluent symbol
                                         font, and Fluent has no bug glyph — its "Code" stand-in rendered as a bare < >). -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button ToolTip.Tip="{l:Localize lblRun}"
                                                Command="{ReflectionBinding $parent[Window].DataContext.LaunchCommand}"
                                                CommandParameter="{Binding App}">
                                            <PathIcon Width="16" Height="16" Data="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                                        </Button>
                                        <Button ToolTip.Tip="{l:Localize lblStop}"
                                                Command="{ReflectionBinding $parent[Window].DataContext.StopCommand}"
                                                CommandParameter="{Binding App}">
                                            <PathIcon Width="16" Height="16" Data="M18,18H6V6H18V18Z"/>
                                        </Button>
                                        <Button ToolTip.Tip="{l:Localize lblDebug}"
                                                Command="{ReflectionBinding $parent[Window].DataContext.DebugCommand}"
                                                CommandParameter="{Binding App}">
                                            <PathIcon Width="16" Height="16" Data="M14,12H10V10H14M14,16H10V14H14M20,8H17.19C16.74,7.22 16.12,6.55 15.37,6.04L17,4.41L15.59,3L13.42,5.17C12.96,5.06 12.5,5 12,5C11.5,5 11.04,5.06 10.59,5.17L8.41,3L7,4.41L8.62,6.04C7.88,6.55 7.26,7.22 6.81,8H4V10H6.09C6.04,10.33 6,10.66 6,11V12H4V14H6V15C6,15.34 6.04,15.67 6.09,16H4V18H6.81C7.85,19.79 9.78,21 12,21C14.22,21 16.15,19.79 17.19,18H20V16H17.91C17.96,15.67 18,15.34 18,15V14H20V12H18V11C18,10.66 17.96,10.33 17.91,10H20V8Z"/>
                                        </Button>
                                        <Button ToolTip.Tip="{l:Localize lblUninstall}"
                                                IsVisible="{Binding App.IsRemovable}"
                                                Command="{ReflectionBinding $parent[Window].DataContext.UninstallCommand}"
                                                CommandParameter="{Binding App}">
                                            <PathIcon Width="16" Height="16" Foreground="#FF6B6B" Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>
    </Border>
</Window>
