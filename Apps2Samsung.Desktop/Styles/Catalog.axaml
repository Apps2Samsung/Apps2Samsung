<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia">
	<!-- The catalog (#755): the search field, the category chips, the grouped list rows and the
	     loading skeleton. Every colour is a design token. -->
	<Style Selector="TextBox.search">
		<Setter Property="Background" Value="{DynamicResource FillBrush}"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="Padding" Value="12,9"/>
		<Setter Property="FontSize" Value="15"/>
		<Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
	</Style>
	<Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
		<Setter Property="BorderThickness" Value="2"/>
	</Style>

	<Style Selector="ToggleButton.catchip">
		<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="CornerRadius" Value="999"/>
		<Setter Property="Padding" Value="13,6"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="ToggleButton.catchip:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource FillBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
	</Style>
	<Style Selector="ToggleButton.catchip:checked /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource InkBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
	</Style>
	<Style Selector="ToggleButton.catchip:checked:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource InkBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
	</Style>

	<!-- the sidebar (#755): one toggle per section, the one in force on accent-soft -->
	<Style Selector="ToggleButton.nav">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="Padding" Value="12,9"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="HorizontalContentAlignment" Value="Left"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="ToggleButton.nav:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource FillBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
	</Style>
	<Style Selector="ToggleButton.nav:checked /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
	</Style>
	<Style Selector="ToggleButton.nav:checked:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
	</Style>
	<Style Selector="ToggleButton.nav fa|SymbolIcon">
		<Setter Property="Width" Value="18"/>
		<Setter Property="Height" Value="18"/>
	</Style>

	<!-- a list row: the whole row is the button -->
	<Style Selector="Button.row">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="CornerRadius" Value="0"/>
		<Setter Property="Padding" Value="16,11"/>
		<Setter Property="MinHeight" Value="52"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>
	<Style Selector="Button.row:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource FillBrush}"/>
	</Style>
	<Style Selector="Button.row:pressed /template/ ContentPresenter">
		<Setter Property="Background" Value="{DynamicResource HairBrush}"/>
	</Style>
	<Style Selector="Border.tile">
		<Setter Property="Width" Value="44"/>
		<Setter Property="Height" Value="44"/>
		<Setter Property="CornerRadius" Value="11"/>
	</Style>
	<Style Selector="Border.tile > TextBlock">
		<Setter Property="FontSize" Value="20"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style Selector="Border.hairline">
		<Setter Property="Height" Value="1"/>
		<Setter Property="Margin" Value="16,0,0,0"/>
		<Setter Property="Background" Value="{DynamicResource HairBrush}"/>
	</Style>

	<!-- a loading placeholder row, shimmering -->
	<Style Selector="Border.skeleton">
		<Setter Property="Height" Value="66"/>
		<Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
		<Style.Animations>
			<Animation Duration="0:0:1.4" IterationCount="Infinite" Easing="SineEaseInOut">
				<KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
				<KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.45"/></KeyFrame>
				<KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
			</Animation>
		</Style.Animations>
	</Style>
</Styles>
