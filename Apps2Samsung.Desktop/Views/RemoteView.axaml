<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Extensions"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:viewModels="clr-namespace:Apps2Samsung.ViewModels"
             x:Class="Apps2Samsung.Views.RemoteView"
             x:DataType="viewModels:RemoteViewModel"
             Focusable="True">
    <!-- The Remote section in the v3 language (#755, option C), hosted in the main window's content
         area: Navigation (the round d-pad with an ink OK, Back / Home / Menu / Source / Info / Exit)
         and Media (the volume and channel rockers, Mute and Play-pause, the transport row, the number
         keys) side by side. Status, Keyboard and Power sit in the window's toolbar; the physical
         keyboard mapping lives in the code-behind. -->
    <UserControl.Styles>
        <!-- a key: surface on the page background -->
        <Style Selector="Button.key">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.key:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        </Style>
        <Style Selector="Button.key:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FillBrush}"/>
        </Style>
        <Style Selector="Button.key.text">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.key.power">
            <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
        </Style>
        <Style Selector="Button.key.power:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
        </Style>
        <Style Selector="Button.key.wake">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.key.wake:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <!-- an arrow on the d-pad: the ring is the key, the arrow only lights up under the pointer -->
        <Style Selector="Button.arrow">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="CornerRadius" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.arrow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FillBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        </Style>
        <Style Selector="Button.ok">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="CornerRadius" Value="50"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ok:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BgBrush}"/>
        </Style>

        <!-- the + and - ends of a rocker -->
        <Style Selector="Button.rocker">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.rocker:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FillBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.section">
            <Setter Property="Background" Value="{DynamicResource FillBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Button.key.small">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Grid.keys[IsEnabled=False]">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Margin="0,0,0,16" VerticalAlignment="Top"
              Classes="keys" IsEnabled="{Binding IsConnected}">

            <!-- Navigation -->
            <Border Grid.Column="0" Classes="section" VerticalAlignment="Top">
                <StackPanel Spacing="14">
                    <TextBlock Classes="grouptitle" Margin="0" Text="{l:Localize lblRemoteNavigation}"/>

                    <!-- The d-pad: a 220 px ring with a 92 px ink OK in the middle -->
                    <Panel Width="220" Height="220" HorizontalAlignment="Center">
                        <Ellipse Fill="{DynamicResource SurfaceBrush}"/>
                        <Button Classes="arrow" Content="▲" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"
                                Command="{Binding SendKeyCommand}" CommandParameter="KEY_UP"/>
                        <Button Classes="arrow" Content="▼" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                Command="{Binding SendKeyCommand}" CommandParameter="KEY_DOWN"/>
                        <Button Classes="arrow" Content="◀" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                                Command="{Binding SendKeyCommand}" CommandParameter="KEY_LEFT"/>
                        <Button Classes="arrow" Content="▶" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                Command="{Binding SendKeyCommand}" CommandParameter="KEY_RIGHT"/>
                        <Button Classes="ok" Width="92" Height="92" CornerRadius="46" Content="{l:Localize lblRemoteOk}"
                                Command="{Binding SendKeyCommand}" CommandParameter="KEY_ENTER"/>
                    </Panel>

                    <!-- Back / Home / Menu, Source / Info / Exit -->
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Button Grid.Row="0" Grid.Column="0" Classes="key text small" Content="{l:Localize lblRemoteBack}"
                                Command="{Binding SendKeyCommand}" CommandParameter="KEY_RETURN"/>
                        <Button Grid.Row="0" Grid.Column="1" Classes="key text small" Content="{l:Localize lblRemoteHome}"
                                Command="{Binding SendKeyCommand}" CommandParameter="KEY_HOME"/>
                        <Button Grid.Row="0" Grid.Column="2" Classes="key text small" Content="{l:Localize lblRemoteMenu}"
                                Command="{Binding SendKeyCommand}" CommandParameter="KEY_MENU"/>
                        <Button Grid.Row="1" Grid.Column="0" Classes="key text small" Content="{l:Localize lblRemoteSource}"
                                Command="{Binding SendKeyCommand}" CommandParameter="KEY_SOURCE"/>
                        <Button Grid.Row="1" Grid.Column="1" Classes="key text small" Content="{l:Localize lblRemoteInfo}"
                                Command="{Binding SendKeyCommand}" CommandParameter="KEY_INFO"/>
                        <Button Grid.Row="1" Grid.Column="2" Classes="key text small" Content="{l:Localize lblRemoteExit}"
                                Command="{Binding SendKeyCommand}" CommandParameter="KEY_EXIT"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Media -->
            <Border Grid.Column="1" Classes="section" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <TextBlock Classes="grouptitle" Margin="0" Text="{l:Localize lblRemoteMedia}"/>

                    <!-- Volume and channel rockers -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="2">
                            <StackPanel Spacing="0">
                                <Button Classes="rocker" Content="+" Height="44" Command="{Binding SendKeyCommand}" CommandParameter="KEY_VOLUP"
                                        ToolTip.Tip="{l:Localize lblRemoteVolumeUp}"/>
                                <TextBlock Classes="caption" Text="{l:Localize lblRemoteVolume}"/>
                                <Button Classes="rocker" Content="−" Height="44" Command="{Binding SendKeyCommand}" CommandParameter="KEY_VOLDOWN"
                                        ToolTip.Tip="{l:Localize lblRemoteVolumeDown}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="2">
                            <StackPanel Spacing="0">
                                <Button Classes="rocker" Content="+" Height="44" Command="{Binding SendKeyCommand}" CommandParameter="KEY_CHUP"
                                        ToolTip.Tip="{l:Localize lblRemoteChannelUp}"/>
                                <TextBlock Classes="caption" Text="{l:Localize lblRemoteChannel}"/>
                                <Button Classes="rocker" Content="−" Height="44" Command="{Binding SendKeyCommand}" CommandParameter="KEY_CHDOWN"
                                        ToolTip.Tip="{l:Localize lblRemoteChannelDown}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Mute, Play-pause -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Classes="key text small" Content="{l:Localize lblRemoteMute}"
                                Command="{Binding SendKeyCommand}" CommandParameter="KEY_MUTE"/>
                        <Button Grid.Column="1" Classes="key small" Content="⏯" Command="{Binding PlayPauseCommand}"
                                ToolTip.Tip="{l:Localize lblRemotePlayPause}"/>
                    </Grid>

                    <!-- Transport: previous, rewind, stop, fast-forward, next -->
                    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                        <Button Grid.Column="0" Classes="key small" Content="⏮" Command="{Binding SendKeyCommand}" CommandParameter="KEY_REWIND_"/>
                        <Button Grid.Column="1" Classes="key small" Content="⏪" Command="{Binding SendKeyCommand}" CommandParameter="KEY_REWIND"/>
                        <Button Grid.Column="2" Classes="key small" Content="⏹" Command="{Binding SendKeyCommand}" CommandParameter="KEY_STOP"
                                ToolTip.Tip="{l:Localize lblRemoteStop}"/>
                        <Button Grid.Column="3" Classes="key small" Content="⏩" Command="{Binding SendKeyCommand}" CommandParameter="KEY_FF"/>
                        <Button Grid.Column="4" Classes="key small" Content="⏭" Command="{Binding SendKeyCommand}" CommandParameter="KEY_FF_"/>
                    </Grid>

                    <!-- The number keys -->
                    <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6"
                          ToolTip.Tip="{l:Localize lblRemoteNumpad}">
                        <Button Grid.Row="0" Grid.Column="0" Classes="key small" Content="1" Command="{Binding SendKeyCommand}" CommandParameter="KEY_1"/>
                        <Button Grid.Row="0" Grid.Column="1" Classes="key small" Content="2" Command="{Binding SendKeyCommand}" CommandParameter="KEY_2"/>
                        <Button Grid.Row="0" Grid.Column="2" Classes="key small" Content="3" Command="{Binding SendKeyCommand}" CommandParameter="KEY_3"/>
                        <Button Grid.Row="0" Grid.Column="3" Classes="key small" Content="4" Command="{Binding SendKeyCommand}" CommandParameter="KEY_4"/>
                        <Button Grid.Row="0" Grid.Column="4" Classes="key small" Content="5" Command="{Binding SendKeyCommand}" CommandParameter="KEY_5"/>
                        <Button Grid.Row="1" Grid.Column="0" Classes="key small" Content="6" Command="{Binding SendKeyCommand}" CommandParameter="KEY_6"/>
                        <Button Grid.Row="1" Grid.Column="1" Classes="key small" Content="7" Command="{Binding SendKeyCommand}" CommandParameter="KEY_7"/>
                        <Button Grid.Row="1" Grid.Column="2" Classes="key small" Content="8" Command="{Binding SendKeyCommand}" CommandParameter="KEY_8"/>
                        <Button Grid.Row="1" Grid.Column="3" Classes="key small" Content="9" Command="{Binding SendKeyCommand}" CommandParameter="KEY_9"/>
                        <Button Grid.Row="1" Grid.Column="4" Classes="key small" Content="0" Command="{Binding SendKeyCommand}" CommandParameter="KEY_0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>

</UserControl>
