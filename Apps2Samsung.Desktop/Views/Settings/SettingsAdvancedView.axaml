<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Extensions"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:viewModels="clr-namespace:Apps2Samsung.ViewModels"
             x:Class="Apps2Samsung.Views.Settings.SettingsAdvancedView"
             x:DataType="viewModels:AppSettingsViewModel">
	<!-- Settings > Advanced: the network interface, the GitHub token and extra TV device IDs. -->
	<Border Classes="group">
		<StackPanel>
			<StackPanel Spacing="6" Margin="14,10">
				<TextBlock Classes="settinglabel" Text="{Binding LblLocalIP}"/>
				<ComboBox Classes="clean" HorizontalAlignment="Stretch"
				          ItemsSource="{Binding NetworkInterfaces}"
				          SelectedItem="{Binding SelectedNetworkInterface, Mode=TwoWay}"
				          DisplayMemberBinding="{Binding DisplayText}"/>
			</StackPanel>
			<Border Classes="rowline"/>
			<StackPanel Spacing="6" Margin="14,10">
				<TextBlock Classes="settinglabel" Text="{Binding LblGitHubToken}"/>
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
					<TextBox Grid.Column="0" Classes="clean" Text="{Binding GitHubToken}"
					         PasswordChar="{Binding GitHubTokenPasswordChar}" Watermark="ghp_xxxxxxxxxxxxxxxxxxxx"/>
					<ToggleButton Grid.Column="1" IsChecked="{Binding ShowGitHubToken}" VerticalAlignment="Center"
					              Width="36" Height="36" CornerRadius="8" Padding="0" ToolTip.Tip="{l:Localize lblShowHideToken}">
						<Panel>
							<fa:SymbolIcon Symbol="View" Width="16" Height="16" IsVisible="{Binding !ShowGitHubToken}"/>
							<fa:SymbolIcon Symbol="Cancel" Width="16" Height="16" IsVisible="{Binding ShowGitHubToken}"/>
						</Panel>
					</ToggleButton>
				</Grid>
				<TextBlock Classes="hint" Text="{Binding LblGitHubTokenHint}"/>
			</StackPanel>
			<Border Classes="rowline"/>
			<StackPanel Spacing="6" Margin="14,10">
				<TextBlock Classes="settinglabel" Text="{Binding LblManualDuids}"/>
				<TextBox Classes="clean" Text="{Binding ManualDuids}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
				         Watermark="{l:Localize lblDuidsWatermark}"/>
				<TextBlock Classes="hint" Text="{Binding LblManualDuidsHint}"/>
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>
