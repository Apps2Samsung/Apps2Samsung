<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Apps2Samsung.ViewModels"
             x:Class="Apps2Samsung.Views.Settings.SettingsLanguageView"
             x:DataType="viewModels:AppSettingsViewModel">
	<!-- Settings > Language: the UI language and right-to-left reading. -->
	<Border Classes="group">
		<StackPanel>
			<Grid Classes="setting" ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBlock Classes="settinglabel" Text="{Binding LblLanguage}" VerticalAlignment="Center"/>
				<ComboBox Grid.Column="1" Classes="clean" MinWidth="180" VerticalAlignment="Center"
				          ItemsSource="{Binding AvailableLanguages}"
				          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Name}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</Grid>
			<Border Classes="rowline"/>
			<Grid Classes="setting" ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBlock Classes="settinglabel" Text="{Binding LblRTL}" VerticalAlignment="Center"/>
				<ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Center" IsChecked="{Binding RtlReading}"/>
			</Grid>
		</StackPanel>
	</Border>
</UserControl>
