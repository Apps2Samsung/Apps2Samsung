<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Extensions"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:viewModels="clr-namespace:Apps2Samsung.ViewModels"
             xmlns:views="clr-namespace:Apps2Samsung.Views"
             x:Class="Apps2Samsung.Views.Settings.SettingsBackupView"
             x:DataType="viewModels:AppSettingsViewModel">
	<!-- Settings > Backup and diagnostics: export / import settings and certificates, and the logs. -->
	<StackPanel Spacing="18">
		<StackPanel Spacing="6">
			<TextBlock Classes="grouptitle" Text="{l:Localize lblBackupRestore}"/>
			<Border Classes="group" Padding="14,12">
				<StackPanel Spacing="10">
					<TextBlock Classes="hint" Text="{l:Localize lblBackupRestoreHint}"/>
					<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
						<Button Grid.Column="0" Classes="plain" Padding="10,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
						        Content="{l:Localize lblExportBackup}" Command="{Binding ExportBackupCommand}"/>
						<Button Grid.Column="1" Classes="plain" Padding="10,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
						        Content="{l:Localize lblImportBackup}" Command="{Binding ImportBackupCommand}"/>
					</Grid>
					<TextBlock Classes="hint" Text="{Binding BackupStatus}"
					           IsVisible="{Binding BackupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
				</StackPanel>
			</Border>
		</StackPanel>

		<StackPanel Spacing="6">
			<TextBlock Classes="grouptitle" Text="{l:Localize lblDiagnostics}"/>
			<Border Classes="group">
				<StackPanel>
					<!-- The log viewer (#755): this session's log or an earlier one, filtered and searchable. -->
					<Button Classes="row" Command="{Binding $parent[views:SettingsView].((viewModels:SettingsViewModel)DataContext).ViewLogCommand}">
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
							<fa:SymbolIcon Symbol="Document" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
							<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
								<TextBlock Text="{l:Localize lblViewDebugLog}" FontSize="14" Foreground="{DynamicResource InkBrush}"/>
								<TextBlock Classes="hint" Text="{l:Localize hintViewDebugLog}"/>
							</StackPanel>
						</Grid>
					</Button>
					<Border Classes="rowline"/>
					<Button Classes="row" Command="{Binding OpenLogsFolderCommand}">
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
							<fa:SymbolIcon Symbol="Folder" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/>
							<TextBlock Grid.Column="1" Text="{Binding LblOpenLogsFolder}" FontSize="14" VerticalAlignment="Center"
							           Foreground="{DynamicResource InkBrush}"/>
						</Grid>
					</Button>
				</StackPanel>
			</Border>
		</StackPanel>
	</StackPanel>
</UserControl>
