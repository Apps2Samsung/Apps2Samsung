<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Extensions"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:viewModels="clr-namespace:Apps2Samsung.ViewModels"
             xmlns:models="clr-namespace:Apps2Samsung.Models;assembly=Apps2Samsung.Core"
             x:Class="Apps2Samsung.Views.InstalledAppsView"
             x:DataType="viewModels:InstalledAppsViewModel">
    <!-- The "On the TV" section (#755, option C), hosted in the main window's content area under the
         toolbar (status, Refresh, ⋯). The apps as grouped lists: tile, name, version and size, Open,
         and a ⋯ with Run / Stop / Debug console / Uninstall; right-click a row for the same menu. -->
    <DockPanel LastChildFill="True">

        <!-- Busy indicator -->
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     IsVisible="{Binding IsProgressVisible}"/>

        <!-- Host PC IP 127.0.0.1 and TV-Store closed: the list comes through TV-Store's relay, so say so
             and open TV-Store on the TV from here (#1041 follow-up) -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding ShowRelayNotice}" Background="{DynamicResource WarnSoftBrush}"
                BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding RelayNotice}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}"/>
                <Button Grid.Column="1" Classes="primary" VerticalAlignment="Center" Content="{l:Localize lblOpenTvStore}"
                        Command="{Binding OpenTvStoreCommand}" IsEnabled="{Binding !IsOpeningTvStore}"/>
            </Grid>
        </Border>

        <!-- apps on this TV that moved to their author's repository (#1018): add it, with the key the official catalog names -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Moved}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:InstalledAppsViewModel+MovedRow">
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{l:Localize lblMovedTitle}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                                    <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="primary" VerticalAlignment="Center" Content="{l:Localize lblMovedAdd}"
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.AddMovedRepositoryCommand}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding MovedStatus}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource BadBrush}"
                       IsVisible="{Binding MovedStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <ScrollViewer IsEnabled="{Binding !IsDebugging}">
            <ScrollViewer.Styles>
                <Style Selector="ScrollViewer[IsEnabled=False]">
                    <Setter Property="Opacity" Value="0.4"/>
                </Style>
                <Style Selector="Button.removedline">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
                <Style Selector="Button.removedline:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="Grid.approw:pointerover">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                </Style>
            </ScrollViewer.Styles>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="16"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:InstalledAppGroup">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="grouptitle" Text="{Binding Title}"/>
                            <Border Classes="group">
                                <ItemsControl ItemsSource="{Binding Apps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:InstalledAppViewModel">
                                            <StackPanel>
                                                <Grid Classes="approw" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12" Background="Transparent">
                                                    <Grid.ContextFlyout>
                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                            <MenuItem Header="{l:Localize lblRun}"
                                                                      Command="{ReflectionBinding $parent[UserControl].DataContext.LaunchCommand}"
                                                                      CommandParameter="{Binding App}"/>
                                                            <MenuItem Header="{l:Localize lblStop}"
                                                                      Command="{ReflectionBinding $parent[UserControl].DataContext.StopCommand}"
                                                                      CommandParameter="{Binding App}"/>
                                                            <MenuItem Header="{l:Localize lblDebug}"
                                                                      Command="{ReflectionBinding $parent[UserControl].DataContext.DebugCommand}"
                                                                      CommandParameter="{Binding App}"/>
                                                            <MenuItem Header="{l:Localize lblUninstall}" IsVisible="{Binding App.IsRemovable}"
                                                                      Foreground="{DynamicResource BadBrush}"
                                                                      Command="{ReflectionBinding $parent[UserControl].DataContext.UninstallCommand}"
                                                                      CommandParameter="{Binding App}"/>
                                                        </MenuFlyout>
                                                    </Grid.ContextFlyout>
                                                    <Panel Width="38" Height="38" Margin="14,7,0,7" VerticalAlignment="Center">
                                                        <Border CornerRadius="10" Background="{Binding App.FallbackColor}" IsVisible="{Binding !HasIconBitmap}">
                                                            <TextBlock Text="{Binding App.Initials}" Foreground="{DynamicResource GlassInkBrush}" FontWeight="Bold" FontSize="17"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border CornerRadius="10" ClipToBounds="True" IsVisible="{Binding HasIconBitmap}">
                                                            <Image Source="{Binding IconBitmap}" Stretch="UniformToFill"/>
                                                        </Border>
                                                    </Panel>
                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding App.DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource InkBrush}"/>
                                                        <TextBlock Text="{Binding App.Subline}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource MutedBrush}"/>
                                                        <!-- What the catalog says about this app, when it is in there (#820). -->
                                                        <TextBlock Text="{Binding App.CatalogLine}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{Binding ShowCatalogLine}" Foreground="{DynamicResource MutedBrush}"/>
                                                        <!-- removed from the catalogue (#1033, direction C): a quiet line; why opens under it.
                                                             No Update, no link to the app, no uninstall prompt. -->
                                                        <Button Classes="removedline" IsVisible="{Binding IsRemoved}" HorizontalAlignment="Left">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <fa:SymbolIcon Symbol="Important" FontSize="12" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding App.CatalogLine}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <Button.Flyout>
                                                                <Flyout Placement="BottomEdgeAlignedLeft">
                                                                    <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="12" Padding="14,12" MaxWidth="380">
                                                                        <StackPanel Spacing="6">
                                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="999" Padding="8,1">
                                                                                    <TextBlock Text="{Binding RemovedBadge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}"/>
                                                                                </Border>
                                                                                <TextBlock Text="{Binding RemovedOn}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding RemovedReason}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}"/>
                                                                            <TextBlock Text="{Binding RemovedNote}" IsVisible="{Binding HasRemovedNote}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}"/>
                                                                            <TextBlock Text="{Binding RemovedFooter}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Classes="pill" Content="{l:Localize lblUpdate}" VerticalAlignment="Center"
                                                            IsVisible="{Binding App.HasUpdate}"
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.UpdateCommand}"
                                                            CommandParameter="{Binding App}"/>
                                                    <Button Grid.Column="3" Classes="pill" Content="{l:Localize lblOpenApp}" VerticalAlignment="Center"
                                                            Command="{ReflectionBinding $parent[UserControl].DataContext.LaunchCommand}"
                                                            CommandParameter="{Binding App}"/>
                                                    <Button Grid.Column="4" Classes="more" Content="⋯" Margin="0,0,10,0" VerticalAlignment="Center"
                                                            ToolTip.Tip="{Binding App.TizenId}" Click="OnMoreClick"/>
                                                </Grid>
                                                <Border Classes="rowline" Margin="64,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>
