<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Apps2Samsung.Extensions"
        x:Class="Apps2Samsung.Views.MainWindow"
        xmlns:appicon="using:Apps2Samsung.Helpers"
        Icon="{x:Static appicon:AppIcon.Current}"
		x:DataType="viewModels:MainWindowViewModel"
        xmlns:viewModels="clr-namespace:Apps2Samsung.ViewModels"
		xmlns:helpers="clr-namespace:Apps2Samsung.Helpers.Converters"
		xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
		xmlns:controls="clr-namespace:Apps2Samsung.Views.Controls"
        Width="820" Height="740"
        MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Title="Apps2Samsung">
	<Window.Resources>
		<helpers:TvLogStatusToBrushConverter x:Key="TvLogStatusToBrushConverter"/>
		<helpers:StringEqualsConverter x:Key="StringEquals"/>
		<helpers:StringNotEqualsConverter x:Key="StringNotEquals"/>
	</Window.Resources>

	<Window.Styles>
		<StyleInclude Source="avares://Avalonia.Themes.Fluent/FluentTheme.xaml"/>
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
		<StyleInclude Source="avares://Apps2Samsung/Styles/Buttons.axaml"/>
		<StyleInclude Source="avares://Apps2Samsung/Styles/TextBlocks.axaml"/>
		<StyleInclude Source="avares://Apps2Samsung/Styles/ComboBoxes.axaml"/>
		<StyleInclude Source="avares://Apps2Samsung/Styles/Catalog.axaml"/>
	</Window.Styles>

	<Grid ColumnDefinitions="188,*">
		<!-- Sidebar: the four sections (#755). Settings keeps its window until its own redesign. -->
		<Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
		        BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,0,1,0" Padding="12,16">
			<DockPanel>
				<StackPanel DockPanel.Dock="Top" Spacing="4">
					<TextBlock Text="Apps2Samsung" FontWeight="Bold" FontSize="15" Margin="12,0,8,16"/>
					<ToggleButton Classes="nav" IsChecked="{Binding IsInstallSection, Mode=OneWay}"
					              Command="{Binding ShowSectionCommand}" CommandParameter="Install">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<fa:SymbolIcon Symbol="Download"/><TextBlock Text="{Binding LblInstall}"/>
						</StackPanel>
					</ToggleButton>
					<ToggleButton Classes="nav" IsChecked="{Binding IsOnTheTvSection, Mode=OneWay}"
					              Command="{Binding ShowSectionCommand}" CommandParameter="OnTheTv">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<fa:SymbolIcon Symbol="ViewAll"/><TextBlock Text="{Binding LblOnTheTv}"/>
						</StackPanel>
					</ToggleButton>
					<ToggleButton Classes="nav" IsChecked="{Binding IsRemoteSection, Mode=OneWay}"
					              Command="{Binding ShowSectionCommand}" CommandParameter="Remote">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<fa:SymbolIcon Symbol="Play"/><TextBlock Text="{Binding LblRemoteTab}"/>
						</StackPanel>
					</ToggleButton>
					<ToggleButton Classes="nav" IsChecked="False" Command="{Binding OpenSettingsCommand}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<fa:SymbolIcon Symbol="Settings"/><TextBlock Text="{Binding LblSettingsTab}"/>
						</StackPanel>
					</ToggleButton>
				</StackPanel>
				<StackPanel DockPanel.Dock="Bottom" Spacing="8">
					<ToggleButton Classes="nav" IsChecked="{Binding DarkMode}">
						<Panel>
							<TextBlock Text="&#x2600;" FontSize="16" IsVisible="{Binding DarkMode}"/>
							<TextBlock Text="&#x1F319;" FontSize="14" IsVisible="{Binding !DarkMode}"/>
						</Panel>
					</ToggleButton>
					<TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="8,0" Text="{Binding FooterText}"/>
				</StackPanel>
				<Panel/>
			</DockPanel>
		</Border>

		<!-- Content: one section at a time -->
		<Panel Grid.Column="1">
			<ScrollViewer IsVisible="{Binding IsInstallSection}">
				<StackPanel Spacing="14" Margin="20">
			<!-- VPN / tunnel adapter warning -->
			<Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="6" Padding="12,10"
			        BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1"
			        IsVisible="{Binding HasVpnWarning}">
				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
					<fa:SymbolIcon Grid.Column="0" Symbol="Important" Width="18" Height="18" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Top"/>
					<TextBlock Grid.Column="1" Text="{Binding VpnWarning}" Foreground="{DynamicResource WarnBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
				</Grid>
			</Border>

			<!-- The TV: name, model + IP, an LED with the status line, the install bar, and the
			     actions for the selected set as chips on its screen (#755). -->
			<controls:TvCard State="{Binding TvCard}">
				<controls:TvCard.Actions>
					<WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
						<Button Classes="chip solid" Content="{l:Localize lblRescan}" Command="{Binding RefreshDevicesCommand}"/>
						<Button Classes="chip" Content="{l:Localize lblInstalledApps}" Command="{Binding ShowInstalledAppsCommand}"/>
						<Button Classes="chip" Content="{l:Localize lblTvInformation}" Command="{Binding ShowDeviceInfoCommand}"/>
						<Button Classes="chip" Content="{l:Localize lblRemote}" Command="{Binding ShowRemoteCommand}"/>
						<Button Classes="chip" Content="{l:Localize lblToolbox}" Command="{Binding ShowTvToolboxCommand}"/>
					</WrapPanel>
				</controls:TvCard.Actions>
			</controls:TvCard>

			<!-- TV Selection (rescan is a chip on the card) -->
			<Grid ColumnDefinitions="100,*" ColumnSpacing="8">
				<TextBlock Classes="label"
						   Text="{Binding LblSelectTv}"
						   VerticalAlignment="Center"
						   Grid.Column="0"/>
				<ComboBox Classes="clean"
						  Grid.Column="1"
						  HorizontalAlignment="Stretch"
						  ItemsSource="{Binding AvailableDevices}"
						  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding DisplayText}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</Grid>

			<!-- The catalog (#755): search, category chips, the grouped list; a row opens the app sheet. -->
			<StackPanel Spacing="10">
				<TextBox Classes="search" Text="{Binding SearchText, Mode=TwoWay}" Watermark="{Binding LblSearchApps}"/>

				<ItemsControl ItemsSource="{Binding CategoryChips}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="viewModels:MainWindowViewModel+CategoryChip">
							<ToggleButton Classes="catchip" IsChecked="{Binding IsSelected, Mode=OneWay}"
							              Command="{Binding $parent[ItemsControl].((viewModels:MainWindowViewModel)DataContext).SelectCategoryCommand}"
							              CommandParameter="{Binding}">
								<StackPanel Orientation="Horizontal" Spacing="4">
									<TextBlock Text="{Binding Label}"/>
									<TextBlock Text="{Binding Count}" Opacity="0.6"/>
								</StackPanel>
							</ToggleButton>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<Border CornerRadius="12" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}">
					<Panel>
						<!-- skeleton while the catalog loads -->
						<StackPanel IsVisible="{Binding IsLoading}">
							<Border Classes="skeleton"/>
							<Border Classes="hairline"/>
							<Border Classes="skeleton"/>
							<Border Classes="hairline"/>
							<Border Classes="skeleton"/>
						</StackPanel>
						<TextBlock Text="{Binding LblNoAppMatches}" Margin="16,14" Foreground="{DynamicResource MutedBrush}"
						           IsVisible="{Binding IsCatalogEmpty}"/>
						<ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
							<ItemsControl ItemsSource="{Binding CatalogRows}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="viewModels:MainWindowViewModel+CatalogRow">
										<StackPanel>
											<Button Classes="row"
											        Command="{Binding $parent[ItemsControl].((viewModels:MainWindowViewModel)DataContext).OpenAppCommand}"
											        CommandParameter="{Binding}">
												<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
													<Border Classes="tile" Background="{Binding TileBrush}">
														<TextBlock Text="{Binding Letter}" Foreground="{DynamicResource OnAccentBrush}"/>
													</Border>
													<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
														<TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource InkBrush}"/>
														<TextBlock Text="{Binding Subline}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
													</StackPanel>
													<PathIcon Grid.Column="2" Width="8" Height="13" Opacity="0.35" VerticalAlignment="Center"
													          Foreground="{DynamicResource InkBrush}"
													          Data="M1,1 L7,6.5 L1,12"/>
												</Grid>
											</Button>
											<Border Classes="hairline"/>
										</StackPanel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</Panel>
				</Border>

				<TextBlock Text="{Binding LblYourOwnPackage}" FontSize="15" FontWeight="SemiBold" Margin="4,8,4,0"
				           Foreground="{DynamicResource MutedBrush}"/>
				<Border CornerRadius="12" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}">
					<Button Classes="row" Command="{Binding InstallOwnFileCommand}">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
							<Border Classes="tile" Background="{DynamicResource FillBrush}">
								<fa:SymbolIcon Symbol="Folder" Width="20" Height="20" Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
								<TextBlock Text="{Binding lblCustomWgt}" FontWeight="Medium" Foreground="{DynamicResource InkBrush}"/>
								<TextBlock Text="{Binding CustomFileSubline}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
							</StackPanel>
							<PathIcon Grid.Column="2" Width="8" Height="13" Opacity="0.35" VerticalAlignment="Center"
							          Foreground="{DynamicResource InkBrush}" Data="M1,1 L7,6.5 L1,12"/>
						</Grid>
					</Button>
				</Border>
				<TextBlock Text="{Binding CatalogFoot}" FontSize="13" Margin="4,0" Foreground="{DynamicResource MutedBrush}"/>
			</StackPanel>


					<!-- Cancel a running Samsung sign-in -->
					<Button Classes="icon" HorizontalAlignment="Center"
							IsVisible="{Binding IsSamsungLoginActive}"
							Command="{Binding CancelSamsungLoginCommand}">
						<fa:SymbolIcon Symbol="Cancel" Width="20" Height="20"/>
					</Button>
				</StackPanel>
			</ScrollViewer>
			<Panel IsVisible="{Binding IsOnTheTvSection}" Margin="20">
				<ContentControl Content="{Binding InstalledAppsVm}"/>
				<TextBlock Text="{Binding LblSelectTvFirst}" Foreground="{DynamicResource MutedBrush}"
				           IsVisible="{Binding InstalledAppsVm, Converter={x:Static ObjectConverters.IsNull}}"/>
			</Panel>
			<Panel IsVisible="{Binding IsRemoteSection}" Margin="20">
				<ContentControl Content="{Binding RemoteVm}"/>
				<TextBlock Text="{Binding LblSelectTvFirst}" Foreground="{DynamicResource MutedBrush}"
				           IsVisible="{Binding RemoteVm, Converter={x:Static ObjectConverters.IsNull}}"/>
			</Panel>
		</Panel>
	</Grid>
</Window>
