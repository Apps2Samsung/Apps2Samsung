<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Apps2Samsung.Extensions"
        x:Class="Apps2Samsung.Views.MainWindow"
        xmlns:appicon="using:Apps2Samsung.Helpers"
        Icon="{x:Static appicon:AppIcon.Current}"
		x:DataType="viewModels:MainWindowViewModel"
        xmlns:viewModels="clr-namespace:Apps2Samsung.ViewModels"
		xmlns:helpers="clr-namespace:Apps2Samsung.Helpers.Converters"
		xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
		xmlns:controls="clr-namespace:Apps2Samsung.Views.Controls"
        Width="820" Height="740"
        MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Title="Apps2Samsung">
	<Window.Resources>
		<helpers:TvLogStatusToBrushConverter x:Key="TvLogStatusToBrushConverter"/>
		<helpers:StringEqualsConverter x:Key="StringEquals"/>
		<helpers:StringNotEqualsConverter x:Key="StringNotEquals"/>
	</Window.Resources>

	<Window.Styles>
		<StyleInclude Source="avares://Avalonia.Themes.Fluent/FluentTheme.xaml"/>
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
		<StyleInclude Source="avares://Apps2Samsung/Styles/Buttons.axaml"/>
		<StyleInclude Source="avares://Apps2Samsung/Styles/TextBlocks.axaml"/>
		<StyleInclude Source="avares://Apps2Samsung/Styles/ComboBoxes.axaml"/>
		<StyleInclude Source="avares://Apps2Samsung/Styles/Catalog.axaml"/>
		<StyleInclude Source="avares://Apps2Samsung/Styles/Sections.axaml"/>
	</Window.Styles>

	<Grid ColumnDefinitions="188,*">
		<!-- Sidebar (#755, option C): the TV in use on top (its name and status; with more than one
		     TV found it gets a ▾ and opens the TV picker), the four sections, and the version, licence and theme switch at the foot. -->
		<Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
		        BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,0,1,0" Padding="10,14">
			<DockPanel>
				<StackPanel DockPanel.Dock="Top" Spacing="4">
					<Button Classes="settingsrow" Background="{DynamicResource FillBrush}" CornerRadius="10" Padding="10,8" Margin="0,0,0,12"
					        Command="{Binding ChangeTvCommand}" IsHitTestVisible="{Binding CanSwitchTv}">
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
							<Border Classes="icontile" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrush}">
								<Viewbox Width="17" Height="15">
									<Canvas Width="28" Height="24">
										<Path Classes="tileicon" StrokeThickness="2.6" Data="M4.5,2 H23.5 A2.5,2.5 0 0 1 26,4.5 V14.5 A2.5,2.5 0 0 1 23.5,17 H4.5 A2.5,2.5 0 0 1 2,14.5 V4.5 A2.5,2.5 0 0 1 4.5,2 Z M10,21 H18"/>
									</Canvas>
								</Viewbox>
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center">
								<StackPanel Orientation="Horizontal" Spacing="5">
									<TextBlock Text="{Binding TvCard.Name}" FontSize="14" FontWeight="Bold" MaxWidth="104"
									           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource InkBrush}"/>
									<PathIcon Width="10" Height="7" Data="M1,1.5 L5,5.5 L9,1.5" Foreground="{DynamicResource AccentBrush}"
									          VerticalAlignment="Center" IsVisible="{Binding CanSwitchTv}"/>
								</StackPanel>
								<StackPanel Orientation="Horizontal" Spacing="5">
									<Ellipse Width="7" Height="7" Fill="{Binding TvLedBrush}" VerticalAlignment="Center"/>
									<TextBlock Text="{Binding TvCard.Message}" FontSize="12" MaxWidth="110" TextTrimming="CharacterEllipsis"
									           Foreground="{DynamicResource MutedBrush}" ToolTip.Tip="{Binding TvCard.Message}"/>
								</StackPanel>
							</StackPanel>
						</Grid>
					</Button>
					<ToggleButton Classes="nav" IsChecked="{Binding IsInstallSection, Mode=OneWay}"
					              Command="{Binding ShowSectionCommand}" CommandParameter="Install">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<fa:SymbolIcon Symbol="Download"/><TextBlock Text="{Binding LblInstall}"/>
						</StackPanel>
					</ToggleButton>
					<ToggleButton Classes="nav" IsChecked="{Binding IsOnTheTvSection, Mode=OneWay}"
					              Command="{Binding ShowSectionCommand}" CommandParameter="OnTheTv">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<fa:SymbolIcon Symbol="ViewAll"/><TextBlock Text="{Binding LblOnTheTv}"/>
						</StackPanel>
					</ToggleButton>
					<ToggleButton Classes="nav" IsChecked="{Binding IsRemoteSection, Mode=OneWay}"
					              Command="{Binding ShowSectionCommand}" CommandParameter="Remote">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<fa:SymbolIcon Symbol="Play"/><TextBlock Text="{Binding LblRemoteTab}"/>
						</StackPanel>
					</ToggleButton>
					<ToggleButton Classes="nav" IsChecked="{Binding IsSettingsSection, Mode=OneWay}"
					              Command="{Binding ShowSectionCommand}" CommandParameter="Settings">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<fa:SymbolIcon Symbol="Settings"/><TextBlock Text="{Binding LblSettingsTab}"/>
						</StackPanel>
					</ToggleButton>
				</StackPanel>
				<Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="8,0,0,0">
					<StackPanel VerticalAlignment="Center" ToolTip.Tip="{Binding FooterText}">
						<TextBlock Text="{Binding VersionText}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
						<controls:LicenseFooter/>
					</StackPanel>
					<ToggleButton Grid.Column="1" Classes="nav" Padding="8" VerticalAlignment="Center" IsChecked="{Binding DarkMode}">
						<Panel>
							<TextBlock Text="&#x2600;" FontSize="16" IsVisible="{Binding DarkMode}"/>
							<TextBlock Text="&#x1F319;" FontSize="14" IsVisible="{Binding !DarkMode}"/>
						</Panel>
					</ToggleButton>
				</Grid>
				<Panel/>
			</DockPanel>
		</Border>

		<!-- Content: one section at a time, each with its toolbar on top -->
		<Panel Grid.Column="1">

			<!-- Install -->
			<DockPanel IsVisible="{Binding IsInstallSection}">
				<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="20,16,20,0">
					<TextBox Classes="search tool" Text="{Binding SearchText, Mode=TwoWay}" Watermark="{Binding LblSearchApps}"/>
					<Button Grid.Column="1" Classes="tool" Content="{l:Localize lblInstallAFile}" ToolTip.Tip="{Binding CustomFileSubline}"
					        Command="{Binding InstallOwnFileCommand}"/>
					<Button Grid.Column="2" Classes="tool square" Content="⋯" FontSize="18" ToolTip.Tip="{l:Localize lblMore}">
						<Button.Flyout>
							<MenuFlyout Placement="BottomEdgeAlignedRight">
								<MenuItem Header="{l:Localize lblChangeTv}" Command="{Binding ChangeTvCommand}" IsVisible="{Binding CanSwitchTv}"/>
								<MenuItem Header="{l:Localize lblRescanForTvs}" Command="{Binding RefreshDevicesCommand}"/>
								<MenuItem Header="{l:Localize lblAddTvByIp}" Command="{Binding AddTvByIpCommand}"/>
								<MenuItem Header="{l:Localize lblTvInformation}" Command="{Binding ShowDeviceInfoCommand}"/>
								<MenuItem Header="{l:Localize lblToolbox}" Command="{Binding ShowTvToolboxCommand}"/>
								<!-- What the catalog lists (#850): turning 18+ on asks "I am 18 or older" first and
								     the check springs back when declined. -->
								<Separator/>
								<MenuItem Header="{Binding Settings.Application.LblShowAdultApps}" ToggleType="CheckBox"
								          IsChecked="{Binding Settings.Application.ShowAdultApps, Mode=TwoWay}"
								          ToolTip.Tip="{l:Localize hintShowAdultApps}"/>
								<MenuItem Header="{Binding Settings.Application.LblShowRootApps}" ToggleType="CheckBox"
								          IsChecked="{Binding Settings.Application.ShowRootApps, Mode=TwoWay}"
								          ToolTip.Tip="{l:Localize hintShowRootApps}"/>
							</MenuFlyout>
						</Button.Flyout>
					</Button>
				</Grid>
				<ScrollViewer>
					<StackPanel Spacing="14" Margin="20,14,20,20">
						<!-- VPN / tunnel adapter warning -->
						<Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="6" Padding="12,10"
						        BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1"
						        IsVisible="{Binding HasVpnWarning}">
							<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
								<fa:SymbolIcon Grid.Column="0" Symbol="Important" Width="18" Height="18" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Top"/>
								<TextBlock Grid.Column="1" Text="{Binding VpnWarning}" Foreground="{DynamicResource WarnBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
							</Grid>
						</Border>

						<!-- The TV: name, model + IP, an LED with the status line and the install bar (#755).
						     Its actions live in the toolbar's ⋯ and the sidebar's TV picker. A TV that isn't
						     ready yet: clicking the card opens the Developer Mode guide. -->
						<controls:TvCard State="{Binding TvCard}" Command="{Binding OpenTvGuideCommand}"/>

						<!-- Cancel a running Samsung sign-in -->
						<Button Classes="icon" HorizontalAlignment="Center"
						        IsVisible="{Binding IsSamsungLoginActive}"
						        Command="{Binding CancelSamsungLoginCommand}">
							<fa:SymbolIcon Symbol="Cancel" Width="20" Height="20"/>
						</Button>

						<!-- The catalog (#755): the grouped list; a row opens the app sheet. -->
						<StackPanel Spacing="10">
								<!-- skeleton while the catalog loads -->
								<Border CornerRadius="12" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}" IsVisible="{Binding IsLoading}">
									<StackPanel>
										<Border Classes="skeleton"/>
										<Border Classes="hairline"/>
										<Border Classes="skeleton"/>
										<Border Classes="hairline"/>
										<Border Classes="skeleton"/>
									</StackPanel>
								</Border>
								<Border CornerRadius="12" Background="{DynamicResource SurfaceBrush}" Padding="16,14" IsVisible="{Binding IsCatalogEmpty}">
									<TextBlock Text="{Binding LblNoAppMatches}" Foreground="{DynamicResource MutedBrush}"/>
								</Border>
								<!-- one short group per category, two across; "Show all" expands it; a search is one flat group -->
								<ItemsControl ItemsSource="{Binding CatalogGroupsView}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<UniformGrid Columns="{Binding $parent[ItemsControl].((viewModels:MainWindowViewModel)DataContext).CatalogColumns}"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="viewModels:MainWindowViewModel+CatalogGroupView">
											<StackPanel Spacing="6" IsVisible="{Binding !IsEmpty}" Margin="0,0,14,14" VerticalAlignment="Top">
												<Grid ColumnDefinitions="*,Auto" Margin="4,8,4,0">
													<StackPanel Orientation="Horizontal" Spacing="6">
														<TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
														<TextBlock Text="{Binding Count}" FontSize="15" Foreground="{DynamicResource MutedBrush}" Opacity="0.7"/>
													</StackPanel>
													<Button Grid.Column="1" Classes="link" Content="{Binding ToggleText}" IsVisible="{Binding CanToggle}"
													        Command="{Binding $parent[ItemsControl].((viewModels:MainWindowViewModel)DataContext).ToggleGroupCommand}"
													        CommandParameter="{Binding}"/>
												</Grid>
												<Border CornerRadius="12" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}">
													<ItemsControl ItemsSource="{Binding Rows}">
														<ItemsControl.ItemTemplate>
															<DataTemplate x:DataType="viewModels:MainWindowViewModel+CatalogRow">
																<StackPanel>
																	<Button Classes="row"
																	        Command="{Binding $parent[ItemsControl;1].((viewModels:MainWindowViewModel)DataContext).OpenAppCommand}"
																	        CommandParameter="{Binding}">
																		<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
																			<Border Classes="tile" Background="{Binding TileBrush}">
																				<TextBlock Text="{Binding Letter}" Foreground="{DynamicResource OnAccentBrush}"/>
																			</Border>
																			<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
																				<StackPanel Orientation="Horizontal" Spacing="6">
																					<TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource InkBrush}"/>
																					<!-- adult-only (#850): shown only once the user opted in under Settings > Installing -->
																					<Border IsVisible="{Binding IsAdult}" Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnBrush}"
																					        BorderThickness="1" CornerRadius="6" Padding="5,0" VerticalAlignment="Center" ToolTip.Tip="{l:Localize lblAdultOnly}">
																						<TextBlock Text="{l:Localize lblAdultBadge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}"/>
																					</Border>
																					<!-- gains root on the TV: the install asks first -->
																					<Border IsVisible="{Binding IsRoot}" Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnBrush}"
																					        BorderThickness="1" CornerRadius="6" Padding="5,0" VerticalAlignment="Center" ToolTip.Tip="{l:Localize lblRootPackage}">
																						<TextBlock Text="{l:Localize lblRootBadge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}"/>
																					</Border>
																					<!-- the selected TV runs none of the app's builds (TV-Store#47) -->
																					<Border IsVisible="{Binding HasNeedsTizen}" Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnBrush}"
																					        BorderThickness="1" CornerRadius="6" Padding="5,0" VerticalAlignment="Center">
																						<TextBlock Text="{Binding NeedsTizen}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}"/>
																					</Border>
																				</StackPanel>
																				<TextBlock Text="{Binding Subline}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
																			</StackPanel>
																			<PathIcon Grid.Column="2" Width="8" Height="13" Opacity="0.35" VerticalAlignment="Center"
																			          Foreground="{DynamicResource InkBrush}" Data="M1,1 L7,6.5 L1,12"/>
																		</Grid>
																	</Button>
																	<Border Classes="hairline"/>
																</StackPanel>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</Border>
											</StackPanel>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

								<TextBlock Text="{Binding CatalogFoot}" FontSize="13" Margin="4,0" Foreground="{DynamicResource MutedBrush}"/>
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</DockPanel>

			<!-- On the TV -->
			<DockPanel IsVisible="{Binding IsOnTheTvSection}">
				<Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Margin="20,16,20,0" MinHeight="36"
				      IsVisible="{Binding InstalledAppsVm, Converter={x:Static ObjectConverters.IsNotNull}}">
					<TextBlock DataContext="{Binding InstalledAppsVm}" x:DataType="viewModels:InstalledAppsViewModel" Text="{Binding StatusText}" FontSize="13" VerticalAlignment="Center"
					           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
					<Button Grid.Column="1" Classes="tool" Content="{l:Localize lblRefresh}" DataContext="{Binding InstalledAppsVm}" x:DataType="viewModels:InstalledAppsViewModel" Command="{Binding LoadCommand}"
					        IsVisible="{Binding !IsDebugging}"/>
					<Button Grid.Column="2" Classes="tool square" ToolTip.Tip="{l:Localize lblStopDebugging}"
					        DataContext="{Binding InstalledAppsVm}" x:DataType="viewModels:InstalledAppsViewModel"
					        Command="{Binding StopDebugCommand}" IsVisible="{Binding IsDebugging}">
						<fa:SymbolIcon Symbol="StopFilled" Width="16" Height="16" Foreground="{DynamicResource BadBrush}"/>
					</Button>
					<Button Grid.Column="3" Classes="tool square" Content="⋯" FontSize="18" ToolTip.Tip="{l:Localize lblMore}">
						<Button.Flyout>
							<MenuFlyout Placement="BottomEdgeAlignedRight">
								<MenuItem Header="{l:Localize lblCheckForUpdates}" Command="{Binding InstalledAppsVm.CheckForUpdatesCommand}"
								          IsEnabled="{Binding !InstalledAppsVm.IsDebugging}"/>
								<!-- Size / Name / Newest installed; apps with an update stay on top (#888). -->
								<MenuItem Header="{Binding InstalledAppsVm.SortHeader}">
									<MenuItem Header="{l:Localize lblSortSize}" ToggleType="Radio" GroupName="installedOrder"
									          IsChecked="{Binding InstalledAppsVm.IsSortSize, Mode=OneWay}"
									          Command="{Binding InstalledAppsVm.SortCommand}" CommandParameter="Size"/>
									<MenuItem Header="{l:Localize lblSortName}" ToggleType="Radio" GroupName="installedOrder"
									          IsChecked="{Binding InstalledAppsVm.IsSortName, Mode=OneWay}"
									          Command="{Binding InstalledAppsVm.SortCommand}" CommandParameter="Name"/>
									<MenuItem Header="{l:Localize lblSortNewest}" ToggleType="Radio" GroupName="installedOrder"
									          IsChecked="{Binding InstalledAppsVm.IsSortNewest, Mode=OneWay}"
									          Command="{Binding InstalledAppsVm.SortCommand}" CommandParameter="Newest"/>
								</MenuItem>
								<MenuItem Header="{l:Localize lblRemoveLeftover}" Command="{Binding InstalledAppsVm.RemoveLeftoverCommand}"
								          IsEnabled="{Binding !InstalledAppsVm.IsDebugging}" ToolTip.Tip="{l:Localize lblRemoveLeftoverHint}"/>
								<MenuItem Header="{l:Localize lblTvInformation}" Command="{Binding ShowDeviceInfoCommand}"/>
							</MenuFlyout>
						</Button.Flyout>
					</Button>
				</Grid>
				<Panel Margin="20,14,20,20">
					<ContentControl Content="{Binding InstalledAppsVm}"/>
					<TextBlock Text="{Binding LblSelectTvFirst}" Foreground="{DynamicResource MutedBrush}"
					           IsVisible="{Binding InstalledAppsVm, Converter={x:Static ObjectConverters.IsNull}}"/>
				</Panel>
			</DockPanel>

			<!-- Remote -->
			<DockPanel IsVisible="{Binding IsRemoteSection}">
				<Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10" Margin="20,16,20,0" MinHeight="36"
				      DataContext="{Binding RemoteVm}" x:DataType="viewModels:RemoteViewModel"
				      IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
					<Panel Width="14" VerticalAlignment="Center">
						<fa:ProgressRing IsIndeterminate="True" Width="14" Height="14" BorderThickness="2"
						                 Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsBusy}"/>
						<Panel IsVisible="{Binding !IsBusy}" HorizontalAlignment="Center">
							<Ellipse Width="8" Height="8" Fill="{DynamicResource OkBrush}" IsVisible="{Binding IsStatusOk}"/>
							<Ellipse Width="8" Height="8" Fill="{DynamicResource WarnBrush}" IsVisible="{Binding IsStatusWarn}"/>
							<Ellipse Width="8" Height="8" Fill="{DynamicResource BadBrush}" IsVisible="{Binding IsStatusBad}"/>
						</Panel>
					</Panel>
					<StackPanel Grid.Column="1" VerticalAlignment="Center">
						<TextBlock Text="{Binding StatusText}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}"/>
						<TextBlock Text="{l:Localize lblRemoteKeyboardHint}" FontSize="12" TextTrimming="CharacterEllipsis"
						           Foreground="{DynamicResource MutedBrush}"/>
					</StackPanel>
					<!-- Live typing: the laptop keyboard is forwarded to the TV. d-pad mode presses every
					     character on the app's own grid (works where typed text is ignored); direct mode
					     sends text (fast, but only where the TV accepts it). Icons rather than words, and never
					     focusable: with focus, Space toggled the very button that was forwarding it. -->
					<ToggleButton Grid.Column="2" Classes="tool square" Content="✥" FontSize="17"
					              Focusable="False"
					              IsEnabled="{Binding IsConnected}"
					              IsChecked="{Binding IsLiveDpad, Mode=TwoWay}"
					              ToolTip.Tip="{l:Localize lblRemoteLiveDpad}"/>
					<ToggleButton Grid.Column="3" Classes="tool square" Content="⌨" FontSize="17"
					              Focusable="False"
					              IsEnabled="{Binding IsConnected}"
					              IsChecked="{Binding IsLiveDirect, Mode=TwoWay}"
					              ToolTip.Tip="{l:Localize lblRemoteLiveDirect}"/>
					<Button Grid.Column="4" Classes="tool" Focusable="False" Content="{l:Localize lblRemoteKeyboard}" IsEnabled="{Binding IsConnected}">
						<Button.Flyout>
							<Flyout Placement="BottomEdgeAlignedRight">
								<StackPanel Spacing="8" Width="380">
									<TextBlock Text="{l:Localize lblRemoteTypeOnTv}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
										<TextBox Grid.Column="0" Classes="search" Text="{Binding TextToSend}"
										         Watermark="{l:Localize lblRemoteTextPlaceholder}"/>
										<Button Grid.Column="1" Classes="primary" CornerRadius="10" Padding="16,8"
										        Content="{l:Localize lblRemoteSend}" Command="{Binding SendTextCommand}"/>
									</Grid>
									<!-- Apps that paint their own keyboard (YouTube, Netflix, TizenTube) ignore typed text
									     altogether, so the alternative is to press their keys with the d-pad. -->
									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
										<TextBlock Text="{l:Localize lblRemoteTypeOnAppKeyboard}" FontSize="12" TextWrapping="Wrap"
										           VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}"/>
										<ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
										              IsChecked="{Binding TypeOnAppKeyboard}"/>
									</Grid>
									<TextBlock Text="{l:Localize lblRemoteKeyboardModeHint}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
									<!-- Which app's keyboard: a grid walk is only correct for the app its profile was
									     measured on, so the app is picked explicitly and remembered. -->
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
										<TextBlock Text="{l:Localize lblRemoteKeyboardProfile}" FontSize="12" VerticalAlignment="Center"
										           Foreground="{DynamicResource InkBrush}"/>
										<ComboBox Grid.Column="1" Classes="clean" HorizontalAlignment="Stretch"
										          ItemsSource="{Binding KeyboardProfileChoices}"
										          SelectedItem="{Binding SelectedKeyboardProfile, Mode=TwoWay}"/>
									</Grid>
									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
										<TextBlock Text="{l:Localize lblRemoteKeyboardClearFirst}" FontSize="12" TextWrapping="Wrap"
										           VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}"/>
										<ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
										              IsChecked="{Binding ClearBeforeTyping}"/>
									</Grid>
									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
										<TextBlock Text="{l:Localize lblRemoteKeyboardSubmitAfter}" FontSize="12" TextWrapping="Wrap"
										           VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}"/>
										<ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
										              IsChecked="{Binding SubmitAfterTyping}"/>
									</Grid>
									<Button Classes="tool" HorizontalAlignment="Left" CornerRadius="10" Padding="14,7"
									        Content="{l:Localize lblRemoteKeyboardClear}"
									        Command="{Binding ClearFieldCommand}"/>
									<Expander Header="{l:Localize lblRemoteKeyboardProfileSave}" HorizontalAlignment="Stretch">
										<StackPanel Spacing="6">
											<TextBox Text="{Binding KeyboardProfileJson, Mode=TwoWay}"
											         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="220"
											         FontFamily="monospace" FontSize="11"/>
											<Button Classes="primary" CornerRadius="10" Padding="14,7" HorizontalAlignment="Right"
											        Content="{l:Localize lblRemoteKeyboardProfileSave}"
											        Command="{Binding SaveKeyboardProfileCommand}"/>
											<TextBlock Text="{l:Localize lblRemoteKeyboardProfileHint}" FontSize="12" TextWrapping="Wrap"
											           Foreground="{DynamicResource MutedBrush}"/>
										</StackPanel>
									</Expander>
									<TextBlock Text="{l:Localize lblRemoteTextHint}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
								</StackPanel>
							</Flyout>
						</Button.Flyout>
					</Button>
					<Button Grid.Column="5" Classes="tool square power" Focusable="False" Content="⏻" FontSize="17" IsEnabled="{Binding !IsBusy}"
					        Command="{Binding PowerOrWakeCommand}" ToolTip.Tip="{l:Localize lblRemotePowerWake}"/>
				</Grid>
				<Panel Margin="20,14,20,0">
					<ContentControl Content="{Binding RemoteVm}"/>
					<TextBlock Text="{Binding LblSelectTvFirst}" Foreground="{DynamicResource MutedBrush}"
					           IsVisible="{Binding RemoteVm, Converter={x:Static ObjectConverters.IsNull}}"/>
				</Panel>
			</DockPanel>

			<!-- Settings: list + detail, in the window -->
			<ContentControl IsVisible="{Binding IsSettingsSection}" Content="{Binding Settings}"
			                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
		</Panel>
	</Grid>
</Window>
