<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Extensions"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Apps2Samsung.ViewModels"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d"
             x:Class="Apps2Samsung.Views.ImmiTvSettingsView"
             x:DataType="viewModels:ImmiTvSettingsViewModel">

	<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,20,16">
		<StackPanel Spacing="16">

			<!-- ImmiTV-only notice -->
			<Border Background="#FFF3CD"
					CornerRadius="4"
					Padding="10,8"
					BorderBrush="#FFE69C"
					BorderThickness="1">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<fa:SymbolIcon Symbol="Important" Width="16" Height="16" Foreground="#856404" VerticalAlignment="Center"/>
					<TextBlock Text="{Binding LblImmiTvOnlyNotice}"
							   Foreground="#856404"
							   FontSize="12"
							   FontWeight="SemiBold"
							   TextWrapping="Wrap"
							   VerticalAlignment="Center"/>
				</StackPanel>
			</Border>

			<StackPanel Spacing="8">
				<TextBlock Text="{Binding LblImmiTvSettings}"
						   FontSize="15"
						   FontWeight="SemiBold"
						   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
				<TextBlock Text="{Binding LblImmiTvHint}"
						   FontSize="12"
						   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
						   TextWrapping="Wrap"/>
			</StackPanel>

			<StackPanel Spacing="12">
				<!-- Server URL -->
				<Grid ColumnDefinitions="180,*" ColumnSpacing="12">
					<TextBlock Grid.Column="0"
							   Text="{Binding LblImmiTvServerUrl}"
							   Classes="label"
							   VerticalAlignment="Center"/>
					<TextBox Grid.Column="1"
							 Text="{Binding ServerUrl}"
							 Watermark="http://192.168.1.10:2283"
							 Classes="clean"
							 HorizontalAlignment="Stretch"/>
				</Grid>

				<!-- Email -->
				<Grid ColumnDefinitions="180,*" ColumnSpacing="12">
					<TextBlock Grid.Column="0"
							   Text="{Binding LblImmiTvEmail}"
							   Classes="label"
							   VerticalAlignment="Center"/>
					<TextBox Grid.Column="1"
							 Text="{Binding Email}"
							 Watermark="you@example.com"
							 Classes="clean"
							 HorizontalAlignment="Stretch"/>
				</Grid>

				<!-- Password -->
				<Grid ColumnDefinitions="180,*" ColumnSpacing="12">
					<TextBlock Grid.Column="0"
							   Text="{Binding LblImmiTvPassword}"
							   Classes="label"
							   VerticalAlignment="Center"/>
					<Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
						<TextBox Grid.Column="0"
								 Text="{Binding Password}"
								 PasswordChar="{Binding PasswordChar}"
								 Watermark="{Binding LblImmiTvPassword}"
								 Classes="clean"
								 HorizontalAlignment="Stretch"/>
						<ToggleButton Grid.Column="1"
									  IsChecked="{Binding ShowSecrets}"
									  VerticalAlignment="Center"
									  Width="36"
									  Height="36"
									  CornerRadius="4"
									  Padding="0"
									  ToolTip.Tip="{l:Localize lblShowHideToken}">
							<Panel>
								<fa:SymbolIcon Symbol="View" Width="16" Height="16" IsVisible="{Binding !ShowSecrets}"/>
								<fa:SymbolIcon Symbol="Cancel" Width="16" Height="16" IsVisible="{Binding ShowSecrets}"/>
							</Panel>
						</ToggleButton>
					</Grid>
				</Grid>

				<!-- API key -->
				<Grid ColumnDefinitions="180,*" ColumnSpacing="12">
					<TextBlock Grid.Column="0"
							   Text="{Binding LblImmiTvApiKey}"
							   Classes="label"
							   VerticalAlignment="Center"/>
					<TextBox Grid.Column="1"
							 Text="{Binding ApiKey}"
							 PasswordChar="{Binding PasswordChar}"
							 Watermark="{Binding LblImmiTvApiKey}"
							 Classes="clean"
							 HorizontalAlignment="Stretch"/>
				</Grid>
				<TextBlock Text="{Binding LblImmiTvApiKeyHint}"
						   FontSize="12"
						   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
						   TextWrapping="Wrap"/>
			</StackPanel>

			<!-- bottom slack: ScrollViewer under-measures wrapping content, so guarantee the last row clears the fold -->
			<Border Height="40"/>
		</StackPanel>
	</ScrollViewer>
</UserControl>
