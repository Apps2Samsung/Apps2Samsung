<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Apps2Samsung.Views"
        xmlns:appicon="using:Apps2Samsung.Helpers"
        x:Class="Apps2Samsung.Views.UserSourceWindow"
        x:DataType="views:UserSourceWindow"
        Icon="{x:Static appicon:AppIcon.Current}"
        Title="{Binding TitleText}"
        Width="480" Height="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
	<!-- Settings > Installing > Your sources > Add a source (also the catalog's ⋯): a GitHub repository
	     or release, or a direct .wgt/.tpk link, listed in the catalog from the next refresh. See UserSources. -->
	<Window.Styles>
		<StyleInclude Source="avares://Apps2Samsung/Styles/Buttons.axaml"/>
		<StyleInclude Source="avares://Apps2Samsung/Styles/Catalog.axaml"/>
		<Style Selector="TextBox.field">
			<Setter Property="MinHeight" Value="40"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="FontSize" Value="14"/>
		</Style>
		<Style Selector="ComboBox.field">
			<Setter Property="MinHeight" Value="40"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>
		<Style Selector="TextBlock.fieldlabel">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
		</Style>
		<Style Selector="TextBlock.fieldhint">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
		</Style>
		<Style Selector="TextBlock.fielderror">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
			<Setter Property="IsVisible" Value="False"/>
		</Style>
	</Window.Styles>

	<Panel>
	<DockPanel x:Name="FormPanel">
		<StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="16,8,16,16">
			<TextBlock x:Name="BusyText" FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" IsVisible="False"/>
			<Button Classes="primary" Content="{Binding AddText}" Click="OnAddClick"
			        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="50" CornerRadius="12"/>
			<Button Classes="link" Content="{Binding CancelText}" Click="OnCancelClick" HorizontalAlignment="Center"/>
		</StackPanel>

		<ScrollViewer>
			<StackPanel Margin="16,8,16,8" Spacing="14">
				<Border Height="5" Width="36" CornerRadius="3" Background="{DynamicResource HairBrush}" HorizontalAlignment="Center"/>

				<Grid ColumnDefinitions="44,*" ColumnSpacing="12">
					<Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}">
						<!-- a link -->
						<Path Width="22" Height="22" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2"
						      StrokeLineCap="Round" StrokeJoin="Round"
						      Data="M10,14 L14,10 M8,16 L6,18 A3,3 0 0 1 2,14 L6,10 A3,3 0 0 1 10,10 M16,8 L18,6 A3,3 0 0 1 22,10 L18,14 A3,3 0 0 1 14,14"/>
					</Border>
					<TextBlock Grid.Column="1" Text="{Binding TitleText}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
					           TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}"/>
				</Grid>

				<TextBlock Text="{Binding HintText}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>

				<Border CornerRadius="12" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}" Padding="16,14">
					<StackPanel Spacing="12">
						<StackPanel Spacing="5">
							<TextBlock Classes="fieldlabel" Text="{Binding UrlLabel}"/>
							<TextBox x:Name="UrlBox" Classes="field"/>
							<TextBlock Classes="fieldhint" Text="{Binding UrlHint}"/>
							<TextBlock x:Name="UrlError" Classes="fielderror"/>
						</StackPanel>
						<StackPanel Spacing="5">
							<TextBlock Classes="fieldlabel" Text="{Binding NameLabel}"/>
							<TextBox x:Name="NameBox" Classes="field"/>
							<TextBlock x:Name="NameError" Classes="fielderror"/>
						</StackPanel>
						<StackPanel Spacing="5">
							<TextBlock Classes="fieldlabel" Text="{Binding CategoryLabel}"/>
							<ComboBox x:Name="CategoryBox" Classes="field" DisplayMemberBinding="{Binding Name, x:DataType=views:UserSourceWindow+Choice}"/>
						</StackPanel>
						<StackPanel Spacing="5">
							<CheckBox x:Name="PartnerBox" Content="{Binding PartnerLabel}"/>
							<TextBlock Classes="fieldhint" Text="{Binding PartnerHint}"/>
						</StackPanel>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>

	<!-- A signed repository (#1018), step 2: check the publisher's key before it is trusted. Also the
	     review of a key that changed. Mockup row 1, B. -->
	<DockPanel x:Name="KeyPanel" IsVisible="False">
		<StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="16,8,16,16">
			<Button x:Name="TrustButton" Classes="primary" Click="OnTrustClick"
			        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="50" CornerRadius="12"/>
			<Button x:Name="RejectButton" Classes="link" Click="OnCancelClick" HorizontalAlignment="Center" Foreground="{DynamicResource BadBrush}"/>
		</StackPanel>
		<ScrollViewer>
			<StackPanel Margin="16,8,16,8" Spacing="14">
				<TextBlock x:Name="KeyTitle" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}"/>
				<TextBlock x:Name="KeyHint" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>

				<Grid x:Name="WasRow" ColumnDefinitions="56,*" IsVisible="False">
					<TextBlock x:Name="WasLabel" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
					<TextBlock x:Name="WasText" Grid.Column="1" FontSize="13" FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap"
					           TextDecorations="Strikethrough" Foreground="{DynamicResource MutedBrush}"/>
				</Grid>

				<Border CornerRadius="12" Background="{DynamicResource SurfaceBrush}" Padding="16,16">
					<StackPanel Spacing="12" HorizontalAlignment="Stretch">
						<TextBlock x:Name="NowLabel" FontSize="13" Foreground="{DynamicResource MutedBrush}" IsVisible="False"/>
						<ItemsControl x:Name="FingerprintGroups" HorizontalAlignment="Center">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="4"/>
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="x:String">
									<TextBlock Text="{Binding}" FontFamily="Consolas, Menlo, monospace" FontSize="17" Margin="8,4"
									           HorizontalAlignment="Center" Foreground="{DynamicResource InkBrush}"/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<Button x:Name="CopyButton" Classes="chip" HorizontalAlignment="Center" Click="OnCopyClick"/>
					</StackPanel>
				</Border>

				<Border CornerRadius="12" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}">
					<StackPanel>
						<Grid ColumnDefinitions="44,*" ColumnSpacing="12" Margin="16,12">
							<Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource TileGamesBrush}">
								<TextBlock x:Name="RepoLetter" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
								           Foreground="{DynamicResource OnAccentBrush}"/>
							</Border>
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
								<TextBlock x:Name="RepoName" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}"/>
								<TextBlock x:Name="RepoBy" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
							</StackPanel>
						</Grid>
						<Border Height="1" Background="{DynamicResource HairBrush}"/>
						<Grid ColumnDefinitions="Auto,*" Margin="16,12">
							<TextBlock x:Name="FromLabel" Foreground="{DynamicResource MutedBrush}"/>
							<TextBlock x:Name="FromText" Grid.Column="1" HorizontalAlignment="Right" Foreground="{DynamicResource InkBrush}"/>
						</Grid>
					</StackPanel>
				</Border>

				<TextBlock x:Name="SignedMeans" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>
	</Panel>
</Window>
