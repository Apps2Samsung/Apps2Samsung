<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Extensions"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:viewModels="clr-namespace:Apps2Samsung.ViewModels"
             xmlns:settings="clr-namespace:Apps2Samsung.Views.Settings"
             xmlns:controls="clr-namespace:Apps2Samsung.Views.Controls"
             x:Class="Apps2Samsung.Views.SettingsView"
             x:DataType="viewModels:SettingsViewModel">
	<!-- The Settings section in the main window (#755, option C), list + detail: the update card and
	     the five pages on the left, the chosen page on the right. A per-app page (or App icons),
	     opened from App customization, takes the whole width with a way back. -->
	<UserControl.Styles>
		<!-- Carried over from the Settings window: keep scrollbars visible (the Fluent default fades
		     to a near-invisible overlay, making long pages look unscrollable), and no horizontal
		     scrolling, so content is measured at its wrapped width and the last row stays reachable. -->
		<Style Selector="ScrollViewer">
			<Setter Property="AllowAutoHide" Value="False"/>
			<Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
			<Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
		</Style>
	</UserControl.Styles>

	<Panel>
		<Grid ColumnDefinitions="236,*" IsVisible="{Binding !HasPushedPage}">

			<!-- the list -->
			<Border Grid.Column="0" BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,0,1,0">
				<ScrollViewer>
					<StackPanel Spacing="16" Margin="12,16">

						<!-- update card -->
						<Border Classes="group" Padding="12">
							<StackPanel Spacing="10">
								<StackPanel>
									<TextBlock Text="Apps2Samsung" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource InkBrush}"/>
									<TextBlock Text="{Binding VersionText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}"/>
									<TextBlock Text="{Binding UpdateStatus}" FontSize="12" TextWrapping="Wrap"
									           Foreground="{DynamicResource MutedBrush}"
									           IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
								</StackPanel>
								<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
									<Button Grid.Column="0" Classes="pill" Content="{Binding LblCheckForUpdates}"
									        Command="{Binding CheckForUpdatesCommand}"/>
									<TextBlock Grid.Column="1" Text="{Binding LblBetaUpdates}" FontSize="12" HorizontalAlignment="Right"
									           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource InkBrush}"
									           ToolTip.Tip="{l:Localize hintBetaUpdates}"/>
									<ToggleSwitch Grid.Column="2" IsChecked="{Binding Application.IncludeBetaUpdates}"
									              MinWidth="0" VerticalAlignment="Center" ToolTip.Tip="{l:Localize hintBetaUpdates}"/>
								</Grid>
							</StackPanel>
						</Border>

						<ItemsControl ItemsSource="{Binding MainRows}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate><StackPanel Spacing="2"/></ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="viewModels:SettingsRow">
									<settings:SettingsRowButton/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<ItemsControl ItemsSource="{Binding MoreRows}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate><StackPanel Spacing="2"/></ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="viewModels:SettingsRow">
									<settings:SettingsRowButton/>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<!-- Contribute (#820): each row opens a page in the browser -->
						<ItemsControl ItemsSource="{Binding ContributeRows}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate><StackPanel Spacing="2"/></ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="viewModels:SettingsLinkRow">
									<Button Classes="settingsrow"
									        Command="{Binding $parent[UserControl].((viewModels:SettingsViewModel)DataContext).OpenLinkCommand}"
									        CommandParameter="{Binding Url}" ToolTip.Tip="{Binding Url}">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
											<Border Classes="icontile" Background="{Binding TileBrush}" VerticalAlignment="Center">
												<Viewbox Width="15" Height="15">
													<Canvas Width="24" Height="24">
														<Path Classes="tileicon" Data="{Binding IconData}"/>
													</Canvas>
												</Viewbox>
											</Border>
											<StackPanel Grid.Column="1" VerticalAlignment="Center">
												<TextBlock Classes="settingsrowlabel" Text="{Binding Label}" FontSize="14" Foreground="{DynamicResource InkBrush}"/>
												<TextBlock Text="{Binding Summary}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
											</StackPanel>
										</Grid>
									</Button>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<controls:LicenseFooter Margin="8,0"/>
					</StackPanel>
				</ScrollViewer>
			</Border>

			<!-- the page -->
			<DockPanel Grid.Column="1">
				<TextBlock DockPanel.Dock="Top" Text="{Binding PageTitle}" FontSize="17" FontWeight="Bold"
				           Foreground="{DynamicResource InkBrush}" Margin="20,18,20,10"/>
				<ScrollViewer>
					<Panel Margin="20,0,20,20">
						<settings:SettingsInstallingView DataContext="{Binding Application}" IsVisible="{Binding $parent[UserControl].((viewModels:SettingsViewModel)DataContext).IsInstallingPage}"/>
						<settings:SettingsLanguageView DataContext="{Binding Application}" IsVisible="{Binding $parent[UserControl].((viewModels:SettingsViewModel)DataContext).IsLanguagePage}"/>
						<settings:SettingsBackupView DataContext="{Binding Application}" IsVisible="{Binding $parent[UserControl].((viewModels:SettingsViewModel)DataContext).IsBackupPage}"/>
						<settings:SettingsAdvancedView DataContext="{Binding Application}" IsVisible="{Binding $parent[UserControl].((viewModels:SettingsViewModel)DataContext).IsAdvancedPage}"/>

						<!-- App customization: the apps with settings, then App icons -->
						<StackPanel Spacing="16" IsVisible="{Binding IsAppCustomizationPage}">
							<StackPanel Spacing="6">
								<TextBlock Classes="grouptitle" Text="{Binding LblPerApp}"/>
								<Border Classes="group">
									<ItemsControl ItemsSource="{Binding AppRows}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="viewModels:SettingsAppRow">
												<StackPanel>
													<Button Classes="row" Command="{Binding $parent[UserControl].((viewModels:SettingsViewModel)DataContext).OpenAppCommand}"
													        CommandParameter="{Binding}">
														<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
															<Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource TileMediaBrush}">
																<TextBlock Text="{Binding Letter}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource GlassInkBrush}"
																           HorizontalAlignment="Center" VerticalAlignment="Center"/>
															</Border>
															<TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
															           VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}"/>
															<PathIcon Grid.Column="2" Width="8" Height="13" Opacity="0.35" VerticalAlignment="Center"
															          Foreground="{DynamicResource InkBrush}" Data="M1,1 L7,6.5 L1,12"/>
														</Grid>
													</Button>
													<Border Classes="rowline" Margin="62,0,0,0"/>
												</StackPanel>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</Border>
								<TextBlock Classes="hint" Text="{Binding LblAppCustomizationHint}" Margin="4,0"/>
							</StackPanel>
							<StackPanel Spacing="6">
								<TextBlock Classes="grouptitle" Text="{Binding LblAllApps}"/>
								<Border Classes="group">
									<Button Classes="row" Command="{Binding OpenAppCommand}" CommandParameter="{Binding AppIconsRow}">
										<Grid ColumnDefinitions="*,Auto">
											<TextBlock Text="{Binding AppIconsRow.DisplayName}" FontSize="14" VerticalAlignment="Center"
											           Foreground="{DynamicResource InkBrush}"/>
											<PathIcon Grid.Column="1" Width="8" Height="13" Opacity="0.35" VerticalAlignment="Center"
											          Foreground="{DynamicResource InkBrush}" Data="M1,1 L7,6.5 L1,12"/>
										</Grid>
									</Button>
								</Border>
							</StackPanel>
						</StackPanel>
					</Panel>
				</ScrollViewer>
			</DockPanel>
		</Grid>

		<!-- a per-app page, full width -->
		<DockPanel IsVisible="{Binding HasPushedPage}">
			<Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="12,12,20,4">
				<Button Classes="link" Command="{Binding CloseAppCommand}" VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<PathIcon Width="7" Height="12" Data="M6,1 L1,6 L6,11" Foreground="{DynamicResource AccentBrush}"/>
						<TextBlock Text="{l:Localize lblAppCustomization}"/>
					</StackPanel>
				</Button>
				<TextBlock Grid.Column="1" Text="{Binding PushedPage.DisplayName}" FontSize="17" FontWeight="Bold"
				           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}" Margin="0,0,120,0"/>
			</Grid>
			<ContentControl Content="{Binding PushedPage.Content}" Margin="20,0,0,0"
			                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
		</DockPanel>
	</Panel>
</UserControl>
