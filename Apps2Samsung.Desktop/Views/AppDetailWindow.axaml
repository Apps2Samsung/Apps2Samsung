<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Apps2Samsung.Extensions"
        xmlns:vm="clr-namespace:Apps2Samsung.ViewModels"
        xmlns:models="clr-namespace:Apps2Samsung.Models;assembly=Apps2Samsung.Core"
        xmlns:appicon="using:Apps2Samsung.Helpers"
        x:Class="Apps2Samsung.Views.AppDetailWindow"
        x:DataType="vm:AppDetailViewModel"
        Icon="{x:Static appicon:AppIcon.Current}"
        Title="{Binding Name}"
        Width="460" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource BgBrush}">
	<!-- The app sheet (#755): preview, description (#835), category line, the version or variant list, Install. -->
	<Window.Styles>
		<StyleInclude Source="avares://Apps2Samsung/Styles/Buttons.axaml"/>
		<Style Selector="ListBoxItem">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="MinHeight" Value="48"/>
		</Style>
		<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource FillBrush}"/>
		</Style>
		<Style Selector="Border.radio">
			<Setter Property="Width" Value="22"/>
			<Setter Property="Height" Value="22"/>
			<Setter Property="CornerRadius" Value="11"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
		</Style>
		<Style Selector="ListBoxItem:selected Border.radio">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
			<Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
		</Style>
	</Window.Styles>

	<ScrollViewer>
		<StackPanel Margin="16,8,16,16" Spacing="10">
			<Border Height="5" Width="36" CornerRadius="3" Background="{DynamicResource HairBrush}" HorizontalAlignment="Center"/>
			<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
				<!-- the letter tile, or the app's icon from the catalog (#1000), as in the list -->
				<Panel Width="44" Height="44" VerticalAlignment="Center">
					<Border CornerRadius="11" Background="{Binding TileBrush}" IsVisible="{Binding !HasIcon}">
						<TextBlock Text="{Binding Letter}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"
						           HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<Border CornerRadius="11" ClipToBounds="True" IsVisible="{Binding HasIcon}">
						<Image Source="{Binding Icon}" Stretch="UniformToFill"/>
					</Border>
				</Panel>
				<TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
					<!-- adult-only (#850) -->
					<Border IsVisible="{Binding IsAdult}" Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnBrush}"
					        BorderThickness="1" CornerRadius="7" Padding="7,2" VerticalAlignment="Center" ToolTip.Tip="{l:Localize lblAdultOnly}">
						<TextBlock Text="{l:Localize lblAdultBadge}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}"/>
					</Border>
					<!-- gains root on the TV: the install asks first -->
					<Border IsVisible="{Binding IsRoot}" Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnBrush}"
					        BorderThickness="1" CornerRadius="7" Padding="7,2" VerticalAlignment="Center" ToolTip.Tip="{l:Localize lblRootPackage}">
						<TextBlock Text="{l:Localize lblRootBadge}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}"/>
					</Border>
					<!-- the Tizen the selected build asks for (TV-Store#47): a warning when this TV is too old for it -->
					<Border IsVisible="{Binding HasTizenBadgeWarn}" Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnBrush}"
					        BorderThickness="1" CornerRadius="7" Padding="7,2" VerticalAlignment="Center">
						<TextBlock Text="{Binding TizenBadgeText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}"/>
					</Border>
					<Border IsVisible="{Binding HasTizenBadgeMute}" Background="{DynamicResource FillBrush}" BorderBrush="{DynamicResource HairBrush}"
					        BorderThickness="1" CornerRadius="7" Padding="7,2" VerticalAlignment="Center">
						<TextBlock Text="{Binding TizenBadgeText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
					</Border>
				</StackPanel>
				<!-- the star: a favorite leads the Install screen's list -->
				<Button Grid.Column="3" Classes="icon" Content="{Binding FavoriteGlyph}" FontSize="18" ToolTip.Tip="{Binding FavoriteText}"
				        Command="{Binding ToggleFavoriteCommand}" Width="36" Height="36" CornerRadius="18"/>
			</Grid>

			<Border CornerRadius="12" ClipToBounds="True" Background="{DynamicResource FillBrush}" IsVisible="{Binding HasPreview}">
				<Image Source="{Binding Preview}" Stretch="UniformToFill" MaxHeight="240"/>
			</Border>

			<!-- what the app is, from the catalog (#835); then the category line the list row shows -->
			<TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" IsVisible="{Binding HasDescription}"/>
			<TextBlock Text="{Binding Subline}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
			<!-- where it comes from (#1018), as the list row shows it -->
			<StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSourceLine}" ToolTip.Tip="{Binding Source.Tip}">
				<Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
				      IsVisible="{Binding IsRepositoryLine}" Stroke="{DynamicResource AccentBrush}"
				      Data="M12,22 C12,22 20,18 20,12 L20,5 L12,2 L4,5 L4,12 C4,18 12,22 12,22 Z M9,12 L11,14 L15,10"/>
				<Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="2.2" StrokeLineCap="Round" VerticalAlignment="Center"
				      IsVisible="{Binding IsUnverifiedLine}" Stroke="{DynamicResource WarnBrush}"
				      Data="M12,3 A9,9 0 1 1 11.99,3 Z M12,8 L12,12 M12,16 L12,16.01"/>
				<Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="2.2" StrokeLineCap="Round" VerticalAlignment="Center"
				      IsVisible="{Binding IsBlocked}" Stroke="{DynamicResource MutedBrush}"
				      Data="M5,11 L19,11 L19,21 L5,21 Z M8,11 L8,7 A4,4 0 0 1 16,7 L16,11"/>
				<TextBlock Text="{Binding Source.Text}" TextWrapping="Wrap" Classes.repo="{Binding IsRepositoryLine}"
				           Classes.unverified="{Binding IsUnverifiedLine}" Foreground="{DynamicResource MutedBrush}"/>
			</StackPanel>

			<!-- who makes it and where its source, releases and licence live (#820) -->
			<StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSource}">
				<!-- the name is a link: every app by this developer, as a catalog search (#888) -->
				<HyperlinkButton Content="{Binding AuthorText}" ToolTip.Tip="{Binding AuthorTip}" Click="OnAuthorClick"
				                 IsVisible="{Binding HasAuthor}" Padding="0" MinHeight="0" FontSize="13" VerticalAlignment="Center"/>
				<TextBlock Text="·" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding HasAuthor}"/>
				<HyperlinkButton Content="{Binding SourceCodeText}" NavigateUri="{Binding SourceUri}" ToolTip.Tip="{Binding SourceUri}"
				                 Padding="0" MinHeight="0" FontSize="13" VerticalAlignment="Center"/>
			</StackPanel>

			<Border IsVisible="{Binding RequiresPartner}" Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnBrush}"
			        BorderThickness="1" CornerRadius="10" Padding="12,10">
				<StackPanel Spacing="2">
					<TextBlock Text="{Binding PartnerNeededTitle}" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"/>
					<TextBlock Text="{Binding PartnerNeededBody}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource WarnBrush}"/>
				</StackPanel>
			</Border>

			<!-- another package id on this TV (#839), for a set that has this app's own id blocked -->
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4,4,4,0">
				<StackPanel Spacing="2">
					<TextBlock Text="{Binding NewPackageIdText}" FontSize="13" Foreground="{DynamicResource InkBrush}"/>
					<TextBlock Text="{Binding NewPackageIdHint}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
				</StackPanel>
				<ToggleSwitch Grid.Column="1" IsChecked="{Binding NewPackageId}" MinWidth="0" VerticalAlignment="Center"/>
			</Grid>

			<!-- back to the package's own id (#839): only for an app that was renamed on a TV before -->
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4,4,4,0" IsVisible="{Binding HasPackageIdRename}">
				<StackPanel Spacing="2">
					<TextBlock Text="{Binding OwnPackageIdText}" FontSize="13" Foreground="{DynamicResource InkBrush}"/>
					<TextBlock Text="{Binding OwnPackageIdHint}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
				</StackPanel>
				<ToggleSwitch Grid.Column="1" IsChecked="{Binding OwnPackageId}" MinWidth="0" VerticalAlignment="Center"/>
			</Grid>

			<Grid ColumnDefinitions="*,Auto" Margin="4,10,4,0">
				<TextBlock Text="{Binding VersionsTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"
				           VerticalAlignment="Center"/>
				<TextBlock Grid.Column="1" Text="{Binding Published}" FontSize="15" Foreground="{DynamicResource MutedBrush}"
				           IsVisible="{Binding !CanShowAllVersions}"/>
				<!-- an app with a version history: older versions on request -->
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanShowAllVersions}">
					<TextBlock Text="{Binding ShowAllVersionsText}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}"/>
					<ToggleSwitch IsChecked="{Binding ShowAllVersions}" MinWidth="0" VerticalAlignment="Center"/>
				</StackPanel>
			</Grid>
			<Border CornerRadius="12" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}">
				<ListBox ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
				         Background="Transparent" BorderThickness="0" MaxHeight="300">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="models:Asset">
							<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="16,11">
								<Border Classes="radio" VerticalAlignment="Center"/>
								<TextBlock Grid.Column="1" Text="{Binding LongDisplayText}" TextWrapping="Wrap" VerticalAlignment="Center"
								           Foreground="{DynamicResource InkBrush}"/>
								<!-- the Tizen this build asks for, from the catalog (TV-Store#47) -->
								<TextBlock Grid.Column="2" Text="{Binding RequiredVersionText}" IsVisible="{Binding HasRequiredVersion}" FontSize="12"
								           VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Border>

			<!-- other sources offering an app of this name (#1018): each opens its own sheet -->
			<StackPanel Spacing="6" IsVisible="{Binding HasAlsoOffered}">
				<TextBlock Text="{Binding AlsoOfferedTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
				<Border CornerRadius="12" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}">
					<ItemsControl ItemsSource="{Binding AlsoOffered}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:AppDetailViewModel+OtherSource">
								<Button Classes="row" Click="OnOtherSourceClick" Tag="{Binding Release}">
									<Grid ColumnDefinitions="*,Auto">
										<TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}"/>
										<PathIcon Grid.Column="1" Width="8" Height="13" Opacity="0.35" VerticalAlignment="Center"
										          Foreground="{DynamicResource InkBrush}" Data="M1,1 L7,6.5 L1,12"/>
									</Grid>
								</Button>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Border>
				<TextBlock Text="{Binding SourcesUpdateHint}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
			</StackPanel>

			<!-- a repository that could not be checked now: listed, not installable (#1018) -->
			<Border IsVisible="{Binding IsBlocked}" Background="{DynamicResource FillBrush}" CornerRadius="10" Padding="12,8">
				<TextBlock Text="{Binding BlockedText}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}"/>
			</Border>

			<!-- why Install is off: this TV is too old for the selected build (TV-Store#47) -->
			<Border IsVisible="{Binding HasTizenHint}" Background="{DynamicResource WarnSoftBrush}" CornerRadius="10" Padding="12,8">
				<TextBlock Text="{Binding TizenHint}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}"/>
			</Border>
			<Button Classes="primary" Name="InstallButton" Content="{Binding InstallText}" IsEnabled="{Binding CanInstall}"
			        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="50" CornerRadius="12" Margin="0,6,0,0"
			        Click="OnInstallClick"/>
		</StackPanel>
	</ScrollViewer>
</Window>
