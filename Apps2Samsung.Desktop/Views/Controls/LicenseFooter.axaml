<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Extensions"
             x:Class="Apps2Samsung.Views.Controls.LicenseFooter">
	<!-- The licence line under the sidebar (#820): the licence label opens the
	     licence, the name opens the website. -->
	<UserControl.Styles>
		<Style Selector="TextBlock">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="HyperlinkButton">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</UserControl.Styles>
	<!-- Two lines of their own (#1123): as one wrapping row the separators ended up alone at a line end. -->
	<StackPanel>
		<StackPanel Orientation="Horizontal">
			<TextBlock x:Name="CopyrightText"/>
			<HyperlinkButton x:Name="LicenseLink" Content="{l:Localize lblLicense}"/>
		</StackPanel>
		<WrapPanel>
			<HyperlinkButton x:Name="AuthorLink"/>
			<TextBlock Text=" · "/>
			<TextBlock Text="{l:Localize lblSinceMay2025}"/>
		</WrapPanel>
	</StackPanel>
</UserControl>
