<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Extensions"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Apps2Samsung.ViewModels"
             xmlns:models="clr-namespace:Apps2Samsung.Models"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d"
             x:Class="Apps2Samsung.Views.CameraPipSettingsView"
             x:DataType="viewModels:CameraPipSettingsViewModel">

	<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,20,16">
		<StackPanel Spacing="16">

			<!-- Camera PiP-only notice -->
			<Border Background="{DynamicResource WarnSoftBrush}"
					CornerRadius="4"
					Padding="10,8"
					BorderBrush="{DynamicResource WarnBrush}"
					BorderThickness="1">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<fa:SymbolIcon Symbol="Important" Width="16" Height="16" Foreground="{DynamicResource WarnBrush}" VerticalAlignment="Center"/>
					<TextBlock Text="{Binding LblCameraPipOnlyNotice}"
							   Foreground="{DynamicResource WarnBrush}"
							   FontSize="12"
							   FontWeight="SemiBold"
							   TextWrapping="Wrap"
							   VerticalAlignment="Center"/>
				</StackPanel>
			</Border>

			<StackPanel Spacing="8">
				<TextBlock Text="{Binding LblCameraPipSettings}"
						   FontSize="15"
						   FontWeight="SemiBold"
						   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
				<TextBlock Text="{Binding LblCameraPipHint}"
						   FontSize="12"
						   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
						   TextWrapping="Wrap"/>
			</StackPanel>

			<!-- Empty state -->
			<TextBlock Text="{Binding LblNoCameras}"
					   FontSize="12"
					   FontStyle="Italic"
					   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
					   IsVisible="{Binding !HasCameras}"/>

			<!-- Camera rows: name on the first line, the two stream URLs under it -->
			<ItemsControl ItemsSource="{Binding Cameras}" IsVisible="{Binding HasCameras}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="models:CameraPipCameraEntry">
						<Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
								BorderThickness="1"
								CornerRadius="4"
								Padding="10"
								Margin="0,0,0,8">
							<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
								<TextBox Grid.Row="0" Grid.Column="0"
										 Text="{Binding Name}"
										 Watermark="{Binding $parent[ItemsControl].((viewModels:CameraPipSettingsViewModel)DataContext).LblCameraName}"
										 Classes="clean"/>
								<Button Grid.Row="0" Grid.Column="1"
										Classes="secondary"
										Command="{Binding $parent[ItemsControl].((viewModels:CameraPipSettingsViewModel)DataContext).RemoveCameraCommand}"
										CommandParameter="{Binding}"
										Padding="8,6"
										VerticalAlignment="Center"
										ToolTip.Tip="{l:Localize lblRemove}">
									<fa:SymbolIcon Symbol="Delete" Width="16" Height="16"/>
								</Button>
								<TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
										 Text="{Binding VideoUrl}"
										 Watermark="{Binding $parent[ItemsControl].((viewModels:CameraPipSettingsViewModel)DataContext).LblCameraVideoUrl}"
										 Classes="clean"/>
								<TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
										 Text="{Binding MjpegUrl}"
										 Watermark="{Binding $parent[ItemsControl].((viewModels:CameraPipSettingsViewModel)DataContext).LblCameraMjpegUrl}"
										 Classes="clean"/>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<TextBlock Text="{Binding LblCameraPipUrlsHint}"
					   FontSize="12"
					   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
					   TextWrapping="Wrap"/>

			<!-- Add camera (hidden at the app's limit of four) -->
			<Button Classes="primary"
					Command="{Binding AddCameraCommand}"
					IsVisible="{Binding CanAddCamera}"
					HorizontalAlignment="Left"
					Padding="12,6">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<fa:SymbolIcon Symbol="Add" Width="16" Height="16"/>
					<TextBlock Text="{Binding LblAddCamera}"/>
				</StackPanel>
			</Button>
			<TextBlock Text="{Binding LblCameraPipMaxCameras}"
					   FontSize="12"
					   FontStyle="Italic"
					   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
					   IsVisible="{Binding !CanAddCamera}"/>

			<!-- Mosaic style -->
			<StackPanel Spacing="6">
				<Grid ColumnDefinitions="180,*" ColumnSpacing="12">
					<TextBlock Grid.Column="0"
							   Text="{Binding LblCameraPipMosaicStyle}"
							   Classes="label"
							   VerticalAlignment="Center"/>
					<ComboBox Grid.Column="1"
							  Classes="clean"
							  ItemsSource="{Binding MosaicStyles}"
							  SelectedItem="{Binding SelectedMosaicStyle, Mode=TwoWay}"
							  HorizontalAlignment="Stretch">
						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="viewModels:MosaicStyleOption">
								<TextBlock Text="{Binding Name}"/>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</Grid>
				<TextBlock Text="{Binding LblCameraPipMosaicStyleHint}"
						   FontSize="12"
						   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
						   TextWrapping="Wrap"/>
			</StackPanel>

			<!-- Sound -->
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<TextBlock Grid.Column="0"
						   Text="{Binding LblCameraPipSound}"
						   Classes="label"
						   VerticalAlignment="Center"
						   TextWrapping="Wrap"/>
				<ToggleSwitch Grid.Column="1" IsChecked="{Binding Sound}"/>
			</Grid>

			<!-- bottom slack: ScrollViewer under-measures wrapping content, so guarantee the last row clears the fold -->
			<Border Height="40"/>
		</StackPanel>
	</ScrollViewer>
</UserControl>
