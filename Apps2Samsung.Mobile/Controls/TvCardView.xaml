<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Apps2Samsung.Mobile.Controls.TvCardView">
    <!-- The TV drawn as a device (#755, "the hero"): a bezel around a dark glass screen with a
         reflection, a stand under it. What the screen says comes from a TvCardState (Core), the same
         one the desktop head draws; this control only paints it. Every colour is a design token. -->
    <VerticalStackLayout>
        <Border BackgroundColor="{DynamicResource BezelColor}" StrokeThickness="0"
                StrokeShape="RoundRectangle 18" Padding="7">
            <Border BackgroundColor="{DynamicResource GlassColor}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 12" MinimumHeightRequest="150" Padding="18,18,18,16">
                <Grid>
                    <!-- glass reflection -->
                    <Border InputTransparent="True" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                            Margin="-18,-18,-18,-16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <!-- colours set in code: a GradientStop has no parent to resolve a
                                     DynamicResource through -->
                                <GradientStop x:Name="SheenStart" Offset="0" />
                                <GradientStop x:Name="SheenEnd" Offset="0.34" />
                                <GradientStop Color="Transparent" Offset="0.35" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <VerticalStackLayout x:Name="Screen" VerticalOptions="End" Spacing="4" AnchorY="1">
                        <Label x:Name="NameLabel" FontSize="23" FontAttributes="Bold" LineBreakMode="WordWrap"
                               TextColor="{DynamicResource GlassInkColor}" />
                        <Label x:Name="SubLabel" FontSize="15" LineBreakMode="WordWrap"
                               TextColor="{DynamicResource GlassMutedColor}" />
                        <Grid x:Name="StateRow" ColumnDefinitions="Auto,*" ColumnSpacing="9" Margin="0,8,0,0">
                            <shapes:Ellipse x:Name="Led" WidthRequest="10" HeightRequest="10"
                                            VerticalOptions="Start" Margin="0,5,0,0"
                                            Fill="{DynamicResource GlassMutedBrush}" />
                            <Label x:Name="MessageLabel" Grid.Column="1" FontSize="15" LineBreakMode="WordWrap"
                                   TextColor="{DynamicResource GlassInkColor}" />
                        </Grid>
                        <ProgressBar x:Name="Progress" IsVisible="False" Margin="0,10,0,0" HeightRequest="6"
                                     ProgressColor="{DynamicResource LedBusyColor}"
                                     BackgroundColor="{DynamicResource GlassTrackColor}" />
                        <ContentView x:Name="ActionsHost" Margin="0,14,0,0" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Border>
        <!-- the stand: a neck 34 % wide, a wider foot under it -->
        <Grid ColumnDefinitions="33*,34*,33*">
            <BoxView Grid.Column="1" HeightRequest="9" Color="{DynamicResource BezelColor}" CornerRadius="0,0,10,10" />
        </Grid>
        <Grid ColumnDefinitions="23*,54*,23*" Margin="0,9,0,0">
            <BoxView Grid.Column="1" HeightRequest="4" Color="{DynamicResource BezelColor}" CornerRadius="4" Opacity="0.55" />
        </Grid>
    </VerticalStackLayout>
</ContentView>
