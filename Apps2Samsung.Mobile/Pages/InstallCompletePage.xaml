<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             x:Class="Apps2Samsung.Mobile.Pages.InstallCompletePage"
             Shell.NavBarIsVisible="False"
             Title="{l:Localize InstallationSuccessful}"
             BackgroundColor="{DynamicResource BgColor}">

    <Grid Padding="20" VerticalOptions="Center">
        <Border Padding="20" StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Stroke="{DynamicResource HairBrush}"
                BackgroundColor="{DynamicResource SurfaceColor}">
            <VerticalStackLayout Spacing="14" HorizontalOptions="Fill">

                <Label Text="✅" FontSize="40" HorizontalOptions="Center" />

                <Label x:Name="MessageLabel" FontSize="16" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" HorizontalOptions="Center" />

                <Label Text="{l:Localize lbleasyRight}" FontSize="14" Opacity="0.7"
                       HorizontalTextAlignment="Center" HorizontalOptions="Center" />

                <!-- Ko-fi QR on a white tile -->
                <Border BackgroundColor="White" Padding="8" StrokeThickness="0"
                        StrokeShape="RoundRectangle 6" HorizontalOptions="Center">
                    <Image x:Name="QrImage" WidthRequest="160" HeightRequest="160" Aspect="AspectFit" />
                </Border>

                <!-- Two equal columns, like the progress sheet's footer: a stack layout never shrinks
                     its children, so on a phone the wide Ko-fi button pushed Close off the card. -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <Button Grid.Column="0" Text="{l:Localize lblValidation}" Padding="12,12" CornerRadius="12" HeightRequest="48" LineBreakMode="TailTruncation" Clicked="OnKoFiClicked" />
                    <Button Grid.Column="1" Text="{l:Localize btn_Close}" Style="{StaticResource PlainButton}" Padding="12,12" CornerRadius="12" HeightRequest="48" Clicked="OnCloseClicked" />
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
