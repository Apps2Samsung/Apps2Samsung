<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             xmlns:controls="clr-namespace:Apps2Samsung.Mobile.Controls"
             x:Class="Apps2Samsung.Mobile.Pages.SettingsTvAppPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgColor}">

    <!-- Settings > App customization > TVApp: the channels (m3u8) written into the package, in play order. -->
    <Grid RowDefinitions="Auto,*">
        <controls:TopBarView x:Name="TopBar" Grid.Row="0" BackText="{l:Localize lblAppCustomization}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,20" Spacing="8">
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource RowHint}"
                               Text="{l:Localize hintTvAppChannels}" />
                        <VerticalStackLayout x:Name="ChannelsContainer" Spacing="8" />
                        <Button Text="{l:Localize lblAddChannel}" HorizontalOptions="Start" Style="{StaticResource SoftButton}"
                                Padding="14,8" Clicked="OnAddChannel" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
