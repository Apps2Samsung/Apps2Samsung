<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Apps2Samsung.Mobile.Pages.InstallPage"
             Title="Install">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Border Padding="16" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=#F2F4F7, Dark=#232323}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Installing to" FontSize="12" Opacity="0.6" />
                    <Label x:Name="TargetNameLabel" FontSize="17" FontAttributes="Bold" />
                    <Label x:Name="TargetIpLabel" FontSize="13" Opacity="0.6" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="2">
                <Label Text="App" FontSize="12" Opacity="0.6" />
                <Label Text="Jellyfin" FontSize="16" FontAttributes="Bold" />
                <Label Text="Media-server client for Samsung Tizen TVs." FontSize="13" Opacity="0.7" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Package URL (advanced)" FontSize="12" Opacity="0.6" />
                <Entry x:Name="WgtUrlEntry"
                       Text="https://github.com/jeppevinkel/jellyfin-tizen-builds/releases/latest/download/Jellyfin.wgt"
                       Keyboard="Url" FontSize="12" />
            </VerticalStackLayout>

            <Button x:Name="InstallBtn" Text="Install" Clicked="OnInstallClicked" HorizontalOptions="Fill" />

            <HorizontalStackLayout x:Name="ProgressRow" IsVisible="False" Spacing="10">
                <ActivityIndicator x:Name="Busy" IsRunning="False" />
                <Label x:Name="StatusLabel" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Border x:Name="ResultCard" IsVisible="False" Padding="16" StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=#F2F4F7, Dark=#232323}">
                <Label x:Name="ResultLabel" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
