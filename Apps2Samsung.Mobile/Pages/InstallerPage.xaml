<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             x:Class="Apps2Samsung.Mobile.Pages.InstallerPage"
             Title="Apps2Samsung"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource BgColor}">

    <ScrollView>
        <!-- Single card, mirroring the desktop window. -->
        <Border Margin="12" Padding="16" StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Stroke="{DynamicResource HairBrush}"
                BackgroundColor="{DynamicResource SurfaceColor}">
            <VerticalStackLayout Spacing="14">

                <!-- Brand: logo + name (the desktop's title bar) -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" Padding="0,2">
                    <Image Source="a2s_logo.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center" />
                    <Label Text="Apps2Samsung" FontSize="19" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Header banner -->
                <Border BackgroundColor="{DynamicResource AccentColor}" Padding="24,18" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                    <Label Text="{l:Localize lblAppInstallerTitle}"
                           TextColor="{DynamicResource OnAccentColor}" FontAttributes="Bold"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </Border>

                <!-- Category / App / Version / TV. Label above a full-width picker: next to it the
                     picker kept only ~160dp on a 360dp phone once the round "?" and rescan buttons
                     took their 44dp, and long names ("Jellyfin - AVPlay - 10.10z SmartHub") were cut.
                     Those two buttons are now text actions on the label line. -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="{l:Localize lblCategory}" FontSize="14" FontAttributes="Bold" />
                    <Border Padding="8,0" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                            Stroke="{DynamicResource HairBrush}"
                            BackgroundColor="{DynamicResource Surface2Color}">
                        <Picker x:Name="CategoryPicker" Title="{l:Localize lblAllCategories}" BackgroundColor="Transparent"
                                SelectedIndexChanged="OnCategoryChanged" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="{l:Localize lblApp}" FontSize="14" FontAttributes="Bold" />
                    <Border Padding="8,0" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                            Stroke="{DynamicResource HairBrush}"
                            BackgroundColor="{DynamicResource Surface2Color}">
                        <Picker x:Name="AppPicker" Title="{l:Localize lblSelectAnApp}" BackgroundColor="Transparent"
                                SelectedIndexChanged="OnAppChanged" />
                    </Border>
                </VerticalStackLayout>

                <!-- Version, or Variant for a folded community app; "App details" opens the catalog ("?") -->
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" x:Name="VersionCaption" Text="{l:Localize lblVersion}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{l:Localize lblAppDetails}" Clicked="OnCatalogClicked"
                                FontSize="13" FontAttributes="Bold" BackgroundColor="Transparent" BorderWidth="0"
                                TextColor="{DynamicResource MutedColor}"
                                Padding="8,0" MinimumHeightRequest="32" HorizontalOptions="End" VerticalOptions="Center" />
                    </Grid>
                    <Border Padding="8,0" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                            Stroke="{DynamicResource HairBrush}"
                            BackgroundColor="{DynamicResource Surface2Color}">
                        <Picker x:Name="VersionPicker" BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <!-- TV selection; "Rescan" replaces the round refresh button -->
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{l:Localize lblSelectTv}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1" x:Name="RefreshBtn" Text="{l:Localize lblRescan}" Clicked="OnRefreshClicked"
                                FontSize="13" FontAttributes="Bold" BackgroundColor="Transparent" BorderWidth="0"
                                TextColor="{DynamicResource MutedColor}"
                                Padding="8,0" MinimumHeightRequest="32" HorizontalOptions="End" VerticalOptions="Center" />
                    </Grid>
                    <Border Padding="8,0" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                            Stroke="{DynamicResource HairBrush}"
                            BackgroundColor="{DynamicResource Surface2Color}">
                        <Picker x:Name="TvPicker" Title="{l:Localize lblScanToFindTvs}" BackgroundColor="Transparent"
                                SelectedIndexChanged="OnTvChanged" />
                    </Border>
                </VerticalStackLayout>

                <!-- Quick peek at what's already on the selected TV.
                     Three chips in an even Grid rather than a row of flat text buttons: the labels
                     need roughly 330dp of width, more than the ~304dp a 360dp phone leaves inside the
                     card, so they used to wrap onto a second line and read as stray links. Even
                     columns keep this a single row whatever the font scale or the wording these
                     strings come back with from Crowdin - a long translation wraps inside its own
                     chip - and the borders match the pickers above. -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="{l:Localize lblInstalledApps}"
                            Clicked="OnShowInstalledAppsClicked"
                            FontSize="12" LineBreakMode="WordWrap"
                            BackgroundColor="{DynamicResource Surface2Color}"
                            BorderWidth="1" CornerRadius="8"
                            BorderColor="{DynamicResource HairColor}"
                            TextColor="{DynamicResource InkColor}"
                            Padding="4,8" MinimumHeightRequest="44" />
                    <Button Grid.Column="1" Text="{l:Localize lblTvInformation}"
                            Clicked="OnShowDeviceInfoClicked"
                            FontSize="12" LineBreakMode="WordWrap"
                            BackgroundColor="{DynamicResource Surface2Color}"
                            BorderWidth="1" CornerRadius="8"
                            BorderColor="{DynamicResource HairColor}"
                            TextColor="{DynamicResource InkColor}"
                            Padding="4,8" MinimumHeightRequest="44" />
                    <Button Grid.Column="2" Text="{l:Localize lblRemote}"
                            Clicked="OnShowRemoteClicked"
                            FontSize="12" LineBreakMode="WordWrap"
                            BackgroundColor="{DynamicResource Surface2Color}"
                            BorderWidth="1" CornerRadius="8"
                            BorderColor="{DynamicResource HairColor}"
                            TextColor="{DynamicResource InkColor}"
                            Padding="4,8" MinimumHeightRequest="44" />
                    <Button Grid.Column="3" Text="{l:Localize lblToolbox}"
                            Clicked="OnShowTvToolboxClicked"
                            FontSize="12" LineBreakMode="WordWrap"
                            BackgroundColor="{DynamicResource Surface2Color}"
                            BorderWidth="1" CornerRadius="8"
                            BorderColor="{DynamicResource HairColor}"
                            TextColor="{DynamicResource InkColor}"
                            Padding="4,8" MinimumHeightRequest="44" />
                </Grid>

                <!-- Status bar -->
                <Border BackgroundColor="{DynamicResource AccentColor}" Padding="16" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                    <Label x:Name="StatusLabel" Text="{l:Localize Ready}"
                           TextColor="{DynamicResource OnAccentColor}" HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                </Border>

                <!-- Action -->
                <Grid ColumnDefinitions="*,44" ColumnSpacing="8">
                    <Button Grid.Column="0" x:Name="InstallBtn" Text="{l:Localize DownloadAndInstall}"
                            Clicked="OnInstallClicked" HorizontalOptions="Fill" />
                    <Button Grid.Column="1" x:Name="SettingsBtn" Text="⚙" FontSize="18"
                            BackgroundColor="Transparent" BorderWidth="1"
                            BorderColor="{DynamicResource HairColor}"
                            TextColor="{DynamicResource InkColor}"
                            Padding="0" WidthRequest="44" HeightRequest="44" CornerRadius="22"
                            Clicked="OnSettingsClicked" />
                </Grid>

                <Label Text="{l:Localize lblLicenseFooter}"
                       HorizontalOptions="Center" FontSize="11" Opacity="0.55" />
                <Label x:Name="VersionLabel"
                       HorizontalOptions="Center" FontSize="11" Opacity="0.55" />

            </VerticalStackLayout>
        </Border>
    </ScrollView>

</ContentPage>
