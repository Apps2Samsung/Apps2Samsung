<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             xmlns:controls="clr-namespace:Apps2Samsung.Mobile.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Apps2Samsung.Mobile.Pages.InstallerPage"
             Title="Apps2Samsung"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgColor}">

    <!-- The Install screen (#755): the top bar (logo, the TV with ▾, ⋯), the TV card, then the
         catalog as a grouped list with search, one short group per category. A row opens the app
         sheet; "Your own package" takes a .wgt / .tpk from the phone. Every colour is a design token. -->
    <Grid RowDefinitions="Auto,*">
        <controls:TopBarView x:Name="TopBar" Grid.Row="0" ShowLogo="True" TvTitle="True" Action="More"
                             TitleTapped="OnChangeTvClicked" MoreTapped="OnMoreClicked" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,20" Spacing="14">

                <!-- The TV: name, model + IP, an LED with the status line. What to do with it sits in
                     the top bar now (▾ picks another, ⋯ has Rescan / TV information / Toolbox). -->
                <controls:TvCardView x:Name="TvCard" />

                <!-- How many apps had an update when On the TV last read this TV (#1067); opens On the TV. -->
                <Border x:Name="UpdatesRow" IsVisible="False" Padding="14,12" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{DynamicResource OkSoftColor}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnUpdatesRowTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <shapes:Path Data="M12,4 L12,15 M7,10 L12,15 L17,10 M5,20 L19,20" Stroke="{DynamicResource OkBrush}" StrokeThickness="2.2"
                                     StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                        <Label x:Name="UpdatesRowLabel" Grid.Column="1" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="{l:Localize lblUpdateAll}" FontSize="14" FontAttributes="Bold"
                               TextColor="{DynamicResource OkColor}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- No TV after a scan: what to check, and the two ways forward. -->
                <Border x:Name="NoTvCard" IsVisible="False" Padding="16,20" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                        BackgroundColor="{DynamicResource SurfaceColor}">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="NoTvTitle" Text="{l:Localize lblNoTvYetTitle}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label x:Name="NoTvHint" Text="{l:Localize lblNoTvYetHint}" FontSize="13" TextColor="{DynamicResource MutedColor}"
                               HorizontalTextAlignment="Center" />
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,4,0,0">
                            <Button Text="{l:Localize lblRescan}" Clicked="OnNoTvRescanClicked" HeightRequest="40" CornerRadius="20"
                                    Padding="16,0" FontAttributes="Bold" BackgroundColor="{DynamicResource AccentColor}"
                                    TextColor="{DynamicResource OnAccentColor}" />
                            <Button x:Name="NoTvAddBtn" Text="{l:Localize lblAddTvByIp}" Clicked="OnNoTvAddClicked" HeightRequest="40" CornerRadius="20"
                                    Padding="16,0" BackgroundColor="{DynamicResource AccentSoftColor}"
                                    TextColor="{DynamicResource AccentColor}" />
                            <!-- Takes Add by IP's place while the OS blocks local network access (#824):
                                 a hand-typed IP runs into the same block, Settings is where it is lifted. -->
                            <Button x:Name="NoTvSettingsBtn" IsVisible="False" Text="{l:Localize lblOpenSettings}" Clicked="OnNoTvSettingsClicked"
                                    HeightRequest="40" CornerRadius="20" Padding="16,0" BackgroundColor="{DynamicResource AccentSoftColor}"
                                    TextColor="{DynamicResource AccentColor}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Catalog -->
                <VerticalStackLayout Spacing="10">
                    <Border Padding="12,0" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                            BackgroundColor="{DynamicResource FillColor}">
                        <Entry x:Name="SearchEntry" Placeholder="{l:Localize lblSearchApps}" BackgroundColor="Transparent"
                               ReturnType="Search" TextChanged="OnSearchChanged" />
                    </Border>

                    <!-- one short group per category, "Show all" expands it; a search is one flat group -->
                    <VerticalStackLayout x:Name="CatalogList" Spacing="6" />

                    <Label Text="{l:Localize lblYourOwnPackage}" Style="{StaticResource GroupTitle}" />
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource SurfaceColor}">
                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12" Padding="16,11" MinimumHeightRequest="52">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOwnFileTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 11"
                                    BackgroundColor="{DynamicResource FillColor}">
                                <Label Text="📁" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{l:Localize lblCustomWgt}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Text="{l:Localize lblInstallOwnFile}" FontSize="13" TextColor="{DynamicResource MutedColor}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <shapes:Path Grid.Column="2" Data="M1,1 L7,6.5 L1,12" Stroke="{DynamicResource InkBrush}" StrokeThickness="2"
                                         Opacity="0.35" WidthRequest="8" HeightRequest="13" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Label x:Name="CatalogFoot" Style="{StaticResource Footnote}" />
                </VerticalStackLayout>

                <controls:LicenseFooter />
                <Label x:Name="VersionLabel"
                       HorizontalOptions="Center" FontSize="11" Opacity="0.55" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
