<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             xmlns:controls="clr-namespace:Apps2Samsung.Mobile.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Apps2Samsung.Mobile.Pages.SettingsPage"
             Title="{l:Localize lblSettingsShort}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgColor}">

    <ContentPage.Resources>
        <!-- a hub row: coloured icon tile, label over a one-line summary, chevron -->
        <Style x:Key="HubRow" TargetType="Grid">
            <Setter Property="ColumnDefinitions" Value="30,*,Auto" />
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinimumHeightRequest" Value="60" />
        </Style>
        <Style x:Key="HubTile" TargetType="Border">
            <Setter Property="WidthRequest" Value="30" />
            <Setter Property="HeightRequest" Value="30" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 8" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="HubIcon" TargetType="shapes:Path">
            <Setter Property="Stroke" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="StrokeThickness" Value="2.2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="WidthRequest" Value="18" />
            <Setter Property="HeightRequest" Value="18" />
            <Setter Property="Aspect" Value="Uniform" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="HubSummary" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{DynamicResource MutedColor}" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
        <Style x:Key="Chevron" TargetType="shapes:Path">
            <Setter Property="Stroke" Value="{DynamicResource InkBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Opacity" Value="0.35" />
            <Setter Property="WidthRequest" Value="8" />
            <Setter Property="HeightRequest" Value="13" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="HubDivider" TargetType="BoxView" BasedOn="{StaticResource RowDivider}">
            <Setter Property="Margin" Value="58,0,0,0" />
        </Style>
    </ContentPage.Resources>

    <!-- The Settings hub (#755): one screen. The update card (version, where it stands, Check) with
         the Beta toggle, then five rows that each push a page of their own: Installing, App
         customization, Language, Backup and diagnostics, Advanced. The licence line and the version
         close the page, as on the Install tab. -->
    <Grid RowDefinitions="Auto,*">
        <controls:TopBarView Grid.Row="0" Title="{l:Localize lblSettingsTab}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,20" Spacing="22">

                <!-- updates -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12" Padding="16,14">
                            <Image Grid.Column="0" Source="a2s_logo.png" WidthRequest="44" HeightRequest="44" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Apps2Samsung" FontSize="16" FontAttributes="Bold" />
                                <!-- its own line, wrapping: a test build's version is long (3.0.0-beta.787+b2a6ca8) -->
                                <Label x:Name="AppVersionLabel" FontSize="13" LineBreakMode="CharacterWrap" />
                                <HorizontalStackLayout Spacing="5">
                                    <shapes:Ellipse x:Name="UpdateDot" WidthRequest="7" HeightRequest="7" VerticalOptions="Center" IsVisible="False" />
                                    <Label x:Name="UpdateStateLabel" Style="{StaticResource HubSummary}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Button Grid.Column="2" x:Name="CheckUpdatesBtn" Text="{l:Localize lblCheck}" Style="{StaticResource SoftButton}"
                                    CornerRadius="16" HeightRequest="32" MinimumHeightRequest="32" Padding="14,0" FontSize="14"
                                    VerticalOptions="Center" Clicked="OnCheckUpdatesClicked" />
                        </Grid>
                        <BoxView Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource SettingRow}">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{l:Localize lblBetaUpdates}" FontSize="16" />
                                <Label Style="{StaticResource RowHint}" Text="{l:Localize hintBetaUpdates}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" x:Name="BetaUpdatesSwitch" OnColor="{DynamicResource AccentColor}"
                                    VerticalOptions="Center" Toggled="OnBetaToggled" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- what the app does -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource HubRow}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInstallingTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource HubTile}" BackgroundColor="{DynamicResource AccentColor}">
                                <shapes:Path Style="{StaticResource HubIcon}" Data="M12,3 L12,15 M7,10 L12,15 L17,10 M4,19 L20,19" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{l:Localize lblSettingsInstalling}" FontSize="16" />
                                <Label x:Name="InstallingSummary" Style="{StaticResource HubSummary}" />
                            </VerticalStackLayout>
                            <shapes:Path Grid.Column="2" Style="{StaticResource Chevron}" Data="M1,1 L7,6.5 L1,12" />
                        </Grid>
                        <BoxView Style="{StaticResource HubDivider}" />
                        <Grid Style="{StaticResource HubRow}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAppsTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource HubTile}" BackgroundColor="{DynamicResource TileMediaColor}">
                                <shapes:Path Style="{StaticResource HubIcon}" Data="M4,4 L10,4 L10,10 L4,10 Z M14,4 L20,4 L20,10 L14,10 Z M4,14 L10,14 L10,20 L4,20 Z M14,14 L20,14 L20,20 L14,20 Z" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{l:Localize lblAppCustomization}" FontSize="16" />
                                <Label Text="{l:Localize hintSettingsApps}" Style="{StaticResource HubSummary}" />
                            </VerticalStackLayout>
                            <shapes:Path Grid.Column="2" Style="{StaticResource Chevron}" Data="M1,1 L7,6.5 L1,12" />
                        </Grid>
                        <BoxView Style="{StaticResource HubDivider}" />
                        <Grid Style="{StaticResource HubRow}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLanguageTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource HubTile}" BackgroundColor="{DynamicResource TileGamesColor}">
                                <shapes:Path Style="{StaticResource HubIcon}" Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M3,12 L21,12 M12,3 C15.5,6.5 15.5,17.5 12,21 M12,3 C8.5,6.5 8.5,17.5 12,21" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{l:Localize lblLanguage}" FontSize="16" />
                                <Label x:Name="LanguageSummary" Style="{StaticResource HubSummary}" />
                            </VerticalStackLayout>
                            <shapes:Path Grid.Column="2" Style="{StaticResource Chevron}" Data="M1,1 L7,6.5 L1,12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- keeping it working -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource HubRow}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackupTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource HubTile}" BackgroundColor="{DynamicResource TileToolsColor}">
                                <shapes:Path Style="{StaticResource HubIcon}" Data="M4,8 L20,8 L20,20 L4,20 Z M3,4 L21,4 L21,8 L3,8 Z M10,12 L14,12" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{l:Localize lblBackupAndDiagnostics}" FontSize="16" />
                                <Label Text="{l:Localize hintSettingsBackup}" Style="{StaticResource HubSummary}" />
                            </VerticalStackLayout>
                            <shapes:Path Grid.Column="2" Style="{StaticResource Chevron}" Data="M1,1 L7,6.5 L1,12" />
                        </Grid>
                        <BoxView Style="{StaticResource HubDivider}" />
                        <Grid Style="{StaticResource HubRow}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAdvancedTapped" />
                            </Grid.GestureRecognizers>
                            <Border Style="{StaticResource HubTile}" BackgroundColor="{DynamicResource TileOtherColor}">
                                <shapes:Path Style="{StaticResource HubIcon}" Data="M8,7 L3,12 L8,17 M16,7 L21,12 L16,17" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="{l:Localize lblAdvanced}" FontSize="16" />
                                <Label Text="{l:Localize hintSettingsAdvanced}" Style="{StaticResource HubSummary}" />
                            </VerticalStackLayout>
                            <shapes:Path Grid.Column="2" Style="{StaticResource Chevron}" Data="M1,1 L7,6.5 L1,12" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- the same footer as the Install tab -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="{l:Localize lblLicenseFooter}"
                           HorizontalOptions="Center" FontSize="11" Opacity="0.55" />
                    <Label x:Name="VersionLabel"
                           HorizontalOptions="Center" FontSize="11" Opacity="0.55" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
