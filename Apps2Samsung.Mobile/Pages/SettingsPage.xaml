<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             xmlns:controls="clr-namespace:Apps2Samsung.Mobile.Controls"
             x:Class="Apps2Samsung.Mobile.Pages.SettingsPage"
             Title="{l:Localize lblSettingsShort}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgColor}">

    <ContentPage.Resources>
        <Style x:Key="Divider" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="Color" Value="{DynamicResource HairColor}" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style x:Key="ToggleRow" TargetType="Grid">
            <Setter Property="ColumnDefinitions" Value="*,Auto" />
            <Setter Property="ColumnSpacing" Value="12" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <!-- A tab root (#755): page title, then the sections as grouped-list cards on the page
             background; no card around the whole page and no banner. -->
        <VerticalStackLayout Padding="16,10,16,20" Spacing="8">
            <Label Text="{l:Localize lblSettingsTab}" Style="{StaticResource PageTitle}" Margin="4,8,4,6" />
            <VerticalStackLayout Spacing="8">

                <!-- GitHub Token -->
                <controls:ExpanderSection Title="{l:Localize lblGitHubToken}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,44" ColumnSpacing="8">
                            <Border Grid.Column="0" Padding="8,0" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                                    Stroke="{DynamicResource HairBrush}"
                                    BackgroundColor="{DynamicResource Surface2Color}">
                                <Entry x:Name="TokenEntry" IsPassword="True" Placeholder="ghp_xxxxxxxxxxxxxxxxx"
                                       BackgroundColor="Transparent" Unfocused="OnTokenUnfocused" />
                            </Border>
                            <Button Grid.Column="1" x:Name="TokenEyeBtn" Text="👁" FontSize="16"
                                    BackgroundColor="Transparent" BorderWidth="1"
                                    BorderColor="{DynamicResource HairColor}"
                                    TextColor="{DynamicResource InkColor}"
                                    Padding="0" WidthRequest="44" HeightRequest="44" CornerRadius="6"
                                    Clicked="OnToggleTokenVisibility" />
                        </Grid>
                        <Label Style="{StaticResource Hint}"
                               Text="{l:Localize hintGitHubToken}" />
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <BoxView Style="{StaticResource Divider}" />

                <!-- Jellyfin server -->
                <controls:ExpanderSection Title="Jellyfin">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Hint}"
                               Text="{l:Localize hintConfigureJellyfinServer}" />
                        <Button Text="{l:Localize lblConfigureJellyfinServer}" HorizontalOptions="Start"
                                BackgroundColor="Transparent" BorderWidth="1" CornerRadius="6" Padding="14,8"
                                BorderColor="{DynamicResource HairColor}"
                                TextColor="{DynamicResource InkColor}"
                                Clicked="OnJellyfinClicked" />
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <BoxView Style="{StaticResource Divider}" />

                <!-- Language: the shared Core catalog serves the same 28 translations as the desktop -->
                <controls:ExpanderSection Title="{l:Localize lblLanguage}">
                    <VerticalStackLayout Spacing="8">
                        <Grid Style="{StaticResource ToggleRow}">
                            <Label Grid.Column="0" Text="{l:Localize lblLanguage}" VerticalOptions="Center" />
                            <Picker Grid.Column="1" x:Name="LanguagePicker" SelectedIndexChanged="OnLanguageChanged"
                                    HorizontalOptions="End" WidthRequest="140" />
                        </Grid>
                        <Label Style="{StaticResource Hint}" Text="{l:Localize hintLanguage}" />
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <BoxView Style="{StaticResource Divider}" />

                <!-- Install options -->
                <controls:ExpanderSection Title="{l:Localize lblInstallOptions}">
                    <VerticalStackLayout Spacing="8">
                        <Grid Style="{StaticResource ToggleRow}">
                            <Label Grid.Column="0" Text="{l:Localize lblDeletePrevious}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" x:Name="RemoveOldSwitch" OnColor="{DynamicResource AccentColor}" Toggled="OnToggle" />
                        </Grid>
                        <Grid Style="{StaticResource ToggleRow}">
                            <Label Grid.Column="0" Text="{l:Localize lblOverrideExistingApp}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" x:Name="TryOverwriteSwitch" OnColor="{DynamicResource AccentColor}" Toggled="OnToggle" />
                        </Grid>
                        <Grid Style="{StaticResource ToggleRow}">
                            <Label Grid.Column="0" Text="{l:Localize lblLaunchOnInstall}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" x:Name="OpenAfterSwitch" OnColor="{DynamicResource AccentColor}" Toggled="OnToggle" />
                        </Grid>
                        <Grid Style="{StaticResource ToggleRow}">
                            <Label Grid.Column="0" Text="{l:Localize lblKeepWGTFile}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" x:Name="KeepWgtSwitch" OnColor="{DynamicResource AccentColor}" Toggled="OnToggle" />
                        </Grid>
                        <Grid Style="{StaticResource ToggleRow}">
                            <Label Grid.Column="0" Text="{l:Localize lblShowAllJellyfinVersions}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" x:Name="ShowAllJfSwitch" OnColor="{DynamicResource AccentColor}" Toggled="OnToggle" />
                        </Grid>
                        <Grid Style="{StaticResource ToggleRow}">
                            <Label Grid.Column="0" Text="{l:Localize lblBetaUpdates}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" x:Name="BetaUpdatesSwitch" OnColor="{DynamicResource AccentColor}" Toggled="OnToggle" />
                        </Grid>
                        <Label Style="{StaticResource Hint}"
                               Text="{l:Localize hintBetaUpdates}" />
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <BoxView Style="{StaticResource Divider}" />

                <!-- Extra TV device IDs -->
                <controls:ExpanderSection Title="{l:Localize lblManualDuids}">
                    <VerticalStackLayout Spacing="8">
                        <Border Padding="8,4" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                                Stroke="{DynamicResource HairBrush}"
                                BackgroundColor="{DynamicResource Surface2Color}">
                            <Editor x:Name="DuidsEditor" HeightRequest="90" Placeholder="{l:Localize lblDuidsWatermark}"
                                    BackgroundColor="Transparent" Unfocused="OnDuidsUnfocused" />
                        </Border>
                        <Label Style="{StaticResource Hint}"
                               Text="{l:Localize hintManualDuids}" />
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <BoxView Style="{StaticResource Divider}" />

                <!-- TVApp channels (m3u8) -->
                <controls:ExpanderSection Title="{l:Localize lblTvAppChannels}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Hint}"
                               Text="{l:Localize hintTvAppChannels}" />
                        <VerticalStackLayout x:Name="ChannelsContainer" Spacing="8" />
                        <Button Text="{l:Localize lblAddChannel}" HorizontalOptions="Start"
                                BackgroundColor="Transparent" BorderWidth="1"
                                BorderColor="{DynamicResource HairColor}"
                                TextColor="{DynamicResource InkColor}"
                                Padding="14,8" Clicked="OnAddChannel" />
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <BoxView Style="{StaticResource Divider}" />

                <!-- ImmiTV: Immich server + login, pre-filled into the package's js/config.js -->
                <controls:ExpanderSection Title="ImmiTV">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Hint}"
                               Text="{l:Localize hintImmiTv}" />
                        <Border Padding="8,0" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                                Stroke="{DynamicResource HairBrush}"
                                BackgroundColor="{DynamicResource Surface2Color}">
                            <Entry x:Name="ImmiTvServerEntry" Placeholder="http://192.168.1.10:2283" Keyboard="Url"
                                   BackgroundColor="Transparent" Unfocused="OnImmiTvUnfocused" />
                        </Border>
                        <Border Padding="8,0" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                                Stroke="{DynamicResource HairBrush}"
                                BackgroundColor="{DynamicResource Surface2Color}">
                            <Entry x:Name="ImmiTvEmailEntry" Placeholder="{l:Localize lblImmiTvEmail}" Keyboard="Email"
                                   BackgroundColor="Transparent" Unfocused="OnImmiTvUnfocused" />
                        </Border>
                        <Grid ColumnDefinitions="*,44" ColumnSpacing="8">
                            <Border Grid.Column="0" Padding="8,0" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                                    Stroke="{DynamicResource HairBrush}"
                                    BackgroundColor="{DynamicResource Surface2Color}">
                                <Entry x:Name="ImmiTvPasswordEntry" IsPassword="True" Placeholder="{l:Localize lblImmiTvPassword}"
                                       BackgroundColor="Transparent" Unfocused="OnImmiTvUnfocused" />
                            </Border>
                            <Button Grid.Column="1" x:Name="ImmiTvEyeBtn" Text="👁" FontSize="16"
                                    BackgroundColor="Transparent" BorderWidth="1"
                                    BorderColor="{DynamicResource HairColor}"
                                    TextColor="{DynamicResource InkColor}"
                                    Padding="0" WidthRequest="44" HeightRequest="44" CornerRadius="6"
                                    Clicked="OnToggleImmiTvVisibility" />
                        </Grid>
                        <Border Padding="8,0" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                                Stroke="{DynamicResource HairBrush}"
                                BackgroundColor="{DynamicResource Surface2Color}">
                            <Entry x:Name="ImmiTvApiKeyEntry" IsPassword="True" Placeholder="{l:Localize lblImmiTvApiKey}"
                                   BackgroundColor="Transparent" Unfocused="OnImmiTvUnfocused" />
                        </Border>
                        <Label Style="{StaticResource Hint}"
                               Text="{l:Localize lblImmiTvApiKeyHint}" />
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <BoxView Style="{StaticResource Divider}" />

                <!-- Camera PiP: cameras + mosaic style + sound, written into the package's config.js -->
                <controls:ExpanderSection Title="{l:Localize lblCameraPip}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Hint}"
                               Text="{l:Localize hintCameraPip}" />
                        <VerticalStackLayout x:Name="CamerasContainer" Spacing="8" />
                        <Button x:Name="AddCameraBtn" Text="{l:Localize lblAddCamera}" HorizontalOptions="Start"
                                BackgroundColor="Transparent" BorderWidth="1"
                                BorderColor="{DynamicResource HairColor}"
                                TextColor="{DynamicResource InkColor}"
                                Padding="14,8" Clicked="OnAddCamera" />
                        <Label Style="{StaticResource Hint}"
                               Text="{l:Localize lblCameraPipUrlsHint}" />
                        <Grid Style="{StaticResource ToggleRow}">
                            <Label Grid.Column="0" Text="{l:Localize lblCameraPipMosaicStyle}" VerticalOptions="Center" />
                            <Picker Grid.Column="1" x:Name="CameraPipMosaicPicker" SelectedIndexChanged="OnCameraPipMosaicChanged"
                                    HorizontalOptions="End" WidthRequest="200" />
                        </Grid>
                        <Grid Style="{StaticResource ToggleRow}">
                            <Label Grid.Column="0" Text="{l:Localize lblCameraPipSound}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" x:Name="CameraPipSoundSwitch" OnColor="{DynamicResource AccentColor}" Toggled="OnCameraPipSoundToggled" />
                        </Grid>
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <BoxView Style="{StaticResource Divider}" />

                <!-- TizenTube Cobalt: opt-in proxy address rewrite (Tizen 9 "network error") -->
                <controls:ExpanderSection Title="{l:Localize lblTizenTubeProxy}">
                    <VerticalStackLayout Spacing="8">
                        <Grid Style="{StaticResource ToggleRow}">
                            <Label Grid.Column="0" Text="{l:Localize lblTizenTubeProxyOverride}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" x:Name="TizenTubeProxySwitch" OnColor="{DynamicResource AccentColor}" Toggled="OnTizenTubeProxyToggled" />
                        </Grid>
                        <Label Style="{StaticResource Hint}"
                               Text="{l:Localize hintTizenTubeProxyOverride}" />
                        <Border Padding="8,4" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                                IsEnabled="{Binding Source={x:Reference TizenTubeProxySwitch}, Path=IsToggled}"
                                Stroke="{DynamicResource HairBrush}"
                                BackgroundColor="{DynamicResource Surface2Color}">
                            <Entry x:Name="TizenTubeProxyHostEntry" Placeholder="{l:Localize lblTizenTubeProxyHostAuto}"
                                   Keyboard="Url" BackgroundColor="Transparent" Unfocused="OnTizenTubeProxyHostUnfocused" />
                        </Border>
                        <Label x:Name="TizenTubeProxyHostError" Style="{StaticResource Hint}" TextColor="{DynamicResource BadColor}"
                               Text="{l:Localize lblTizenTubeProxyHostInvalid}" IsVisible="False" />
                        <Label Style="{StaticResource Hint}"
                               Text="{l:Localize hintTizenTubeProxyHost}" />
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <BoxView Style="{StaticResource Divider}" />

                <!-- App icons -->
                <controls:ExpanderSection Title="{l:Localize lblAppIcons}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Hint}"
                               Text="{l:Localize hintManageAppIcons}" />
                        <Button Text="{l:Localize lblManageAppIcons}" HorizontalOptions="Start"
                                BackgroundColor="Transparent" BorderWidth="1" CornerRadius="6" Padding="14,8"
                                BorderColor="{DynamicResource HairColor}"
                                TextColor="{DynamicResource InkColor}"
                                Clicked="OnAppIconsClicked" />
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <BoxView Style="{StaticResource Divider}" />

                <!-- Certificate: pick the signing type, force a fresh login, and note on auto-provisioning. -->
                <controls:ExpanderSection Title="{l:Localize lblCertifcate}">
                    <VerticalStackLayout Spacing="8">
                        <Grid Style="{StaticResource ToggleRow}">
                            <Label Grid.Column="0" Text="{l:Localize lblCertificateType}" VerticalOptions="Center" />
                            <Picker Grid.Column="1" x:Name="CertificatePicker" SelectedIndexChanged="OnCertificateChanged"
                                    HorizontalOptions="End" MinimumWidthRequest="150" />
                        </Grid>
                        <Label Style="{StaticResource Hint}"
                               Text="{l:Localize hintCertificateType}" />
                        <Grid Style="{StaticResource ToggleRow}">
                            <Label Grid.Column="0" Text="{l:Localize lblForceSamsungLogin}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" x:Name="ForceLoginSwitch" OnColor="{DynamicResource AccentColor}" Toggled="OnToggle" />
                        </Grid>
                        <Label Style="{StaticResource Hint}"
                               Text="{l:Localize hintForceSamsungLogin}" />
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <BoxView Style="{StaticResource Divider}" />

                <!-- Backup -->
                <controls:ExpanderSection Title="{l:Localize lblBackup}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Hint}"
                               Text="{l:Localize hintBackup}" />
                        <Button Text="{l:Localize lblExportBackup}" HorizontalOptions="Start"
                                BackgroundColor="Transparent" BorderWidth="1" CornerRadius="6" Padding="14,8"
                                BorderColor="{DynamicResource HairColor}"
                                TextColor="{DynamicResource InkColor}"
                                Clicked="OnExportBackupClicked" />
                        <Button Text="{l:Localize lblImportBackup}" HorizontalOptions="Start"
                                BackgroundColor="Transparent" BorderWidth="1" CornerRadius="6" Padding="14,8"
                                BorderColor="{DynamicResource HairColor}"
                                TextColor="{DynamicResource InkColor}"
                                Clicked="OnImportBackupClicked" />
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <BoxView Style="{StaticResource Divider}" />

                <!-- Diagnostics -->
                <controls:ExpanderSection Title="{l:Localize lblDiagnostics}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Hint}"
                               Text="{l:Localize hintShareDebugLog}" />
                        <Button Text="{l:Localize lblShareDebugLog}" HorizontalOptions="Start"
                                BackgroundColor="Transparent" BorderWidth="1" CornerRadius="6" Padding="14,8"
                                BorderColor="{DynamicResource HairColor}"
                                TextColor="{DynamicResource InkColor}"
                                Clicked="OnShareLogClicked" />
                    </VerticalStackLayout>
                </controls:ExpanderSection>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
