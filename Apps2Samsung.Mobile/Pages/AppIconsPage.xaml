<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             xmlns:controls="clr-namespace:Apps2Samsung.Mobile.Controls"
             x:Class="Apps2Samsung.Mobile.Pages.AppIconsPage"
             Title="{l:Localize lblAppIcons}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgColor}">
    <!-- the top bar (#755): Back and the title -->
    <Grid RowDefinitions="Auto,*">
        <controls:TopBarView Grid.Row="0" Title="{l:Localize lblAppIcons}" BackText="{l:Localize lblRemoteBack}" BackTapped="OnBackClicked" />
        <ScrollView Grid.Row="1">
            <Border Margin="12" Padding="16" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Stroke="{DynamicResource HairBrush}"
                    BackgroundColor="{DynamicResource SurfaceColor}">
                <VerticalStackLayout Spacing="14">

                    <Label FontSize="12" Opacity="0.6"
                           Text="{l:Localize hintAppIconsPage}" />

                    <Label x:Name="StatusLabel" FontSize="12" Opacity="0.6" Text="{l:Localize lblLoadingAppList}" />

                    <VerticalStackLayout x:Name="IconsContainer" Spacing="10" />

                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
