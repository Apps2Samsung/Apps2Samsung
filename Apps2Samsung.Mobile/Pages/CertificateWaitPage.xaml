<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Apps2Samsung.Mobile.Pages.CertificateWaitPage"
             Title="Certificate isn't valid yet"
             BackgroundColor="{AppThemeBinding Light=#ECEFF1, Dark=#141414}">

    <Grid Padding="20" VerticalOptions="Center">
        <Border Padding="20" StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light=#E2E2E2, Dark=#333}"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">
            <VerticalStackLayout Spacing="14">

                <Label Text="⏳" FontSize="40" HorizontalOptions="Center" />

                <Label Text="Certificate isn't valid yet" FontSize="16" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" HorizontalOptions="Center" />

                <Label x:Name="MessageLabel" FontSize="14" HorizontalTextAlignment="Center" />

                <!-- The countdown. Monospaced so ticking seconds don't reflow the layout. -->
                <Label x:Name="CountdownLabel" FontSize="34" FontFamily="monospace"
                       FontAttributes="Bold" HorizontalOptions="Center" />

                <Label x:Name="CaptionLabel" Text="Time until your certificate becomes valid"
                       FontSize="12" Opacity="0.7"
                       HorizontalTextAlignment="Center" HorizontalOptions="Center" />

                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" Margin="0,8,0,0">
                    <Button x:Name="InstallNowBtn" Text="Install now" IsEnabled="False"
                            Clicked="OnInstallNowClicked" />
                    <Button Text="Cancel" WidthRequest="100" Clicked="OnCancelClicked" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
