<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             x:Class="Apps2Samsung.Mobile.Pages.TvToolboxPage"
             Title="{l:Localize lblToolbox}"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#ECEFF1, Dark=#141414}">

    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E2E2E2, Dark=#333}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1F1F1F}" />
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BackgroundColor" Value="#2C3E50" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style x:Key="Section" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="Hint" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <!-- Notices are read, not skimmed past, so they keep full opacity and get a border. -->
        <Style x:Key="Notice" TargetType="Border">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 6" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
        <Style x:Key="Step" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="12" RowSpacing="10">

        <!-- Header banner with a back affordance -->
        <Border Grid.Row="0" BackgroundColor="#2C3E50" Padding="12,18" StrokeThickness="0" StrokeShape="RoundRectangle 8">
            <Grid ColumnDefinitions="44,*,44" ColumnSpacing="4" VerticalOptions="Center">
                <Button Grid.Column="0" Text="‹" FontSize="26" TextColor="White"
                        BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                        WidthRequest="44" HeightRequest="44" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="{l:Localize lblToolbox}" TextColor="White" FontAttributes="Bold"
                       VerticalOptions="Center" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Button Grid.Column="2" Text="⟳" FontSize="18" TextColor="White"
                        BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                        WidthRequest="44" HeightRequest="44" Clicked="OnReloadClicked" />
            </Grid>
        </Border>

        <!-- Which TV, and whether the channel is up -->
        <Label Grid.Row="1" x:Name="StatusLabel" FontSize="12" Opacity="0.7"
               Text="{l:Localize lblRemoteConnecting}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="10">

                <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxOwnerNote}" />

                <!-- Only on a set the probe called hospitality: no Smart Hub, so no app store (#639) -->
                <Border x:Name="HospitalityNotice" Style="{StaticResource Notice}" Stroke="#C77700" IsVisible="False">
                    <Label FontSize="12" Text="{l:Localize lblToolboxHospitality}" />
                </Border>

                <!-- ============ Open an app ============ -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Section}" Text="{l:Localize lblToolboxApps}" />
                        <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxAppsHint}" />
                        <Label x:Name="OfflineHint" Style="{StaticResource Hint}" IsVisible="False"
                               Text="{l:Localize lblToolboxAppsOffline}" />

                        <SearchBar x:Name="AppSearch" Placeholder="{l:Localize lblToolboxFilter}"
                                   TextChanged="OnFilterChanged" />

                        <VerticalStackLayout x:Name="AppList" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10" Padding="0,4">
                                        <Image Grid.Column="0" WidthRequest="36" HeightRequest="36" Aspect="AspectFit"
                                               VerticalOptions="Center" Source="{Binding IconUrl}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Subtitle}" FontSize="11" Opacity="0.55"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Style="{StaticResource Action}" WidthRequest="88"
                                                Text="{l:Localize lblToolboxLaunch}"
                                                CommandParameter="{Binding}" Clicked="OnLaunchAppClicked" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- An ID from a forum post or a manual, for an app in neither list -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0" x:Name="ManualAppIdEntry" Keyboard="Text"
                                   Placeholder="{l:Localize lblToolboxManualPlaceholder}" />
                            <Button Grid.Column="1" Style="{StaticResource Action}" WidthRequest="88"
                                    Text="{l:Localize lblToolboxLaunch}" Clicked="OnLaunchManualClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ Hidden system apps ============ -->
                <!-- Not part of the list above: these are the TV's own menus, addressed by ID because
                     the key combination that used to open them has stopped answering. They launch
                     through the debug agent below (#34); without it the SDB attempt still runs so the
                     TV's own refusal is what the user reads (#641). -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Section}" Text="{l:Localize lblToolboxSystemApps}" />
                        <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxSystemAppsHint}" />

                        <VerticalStackLayout x:Name="SystemAppList" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,4">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14" />
                                            <Label Text="{Binding AppId}" FontSize="11" Opacity="0.55" />
                                            <Label Text="{Binding Description}" FontSize="11" Opacity="0.55" />
                                            <Label Text="{l:Localize lblToolboxSystemAppCaution}" FontSize="11"
                                                   TextColor="#C77700" IsVisible="{Binding IsCaution}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Style="{StaticResource Action}" WidthRequest="88"
                                                Text="{l:Localize lblToolboxLaunch}"
                                                CommandParameter="{Binding}" Clicked="OnLaunchSystemAppClicked" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ Debug agent ============ -->
                <!-- The route that reaches the rows above (#34): an app of ours on the TV, driven over
                     the web inspector, asking the platform's own application manager. Also the one
                     honest app list a hospitality set has. Needs Developer Mode. -->
                <Border x:Name="AgentCard" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Section}" Text="{l:Localize lblToolboxAgent}" />
                        <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxAgentHint}" />
                        <Label x:Name="AgentNeedsSdbHint" Style="{StaticResource Hint}" IsVisible="False"
                               Text="{l:Localize lblToolboxAgentNeedsSdb}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Grid.Column="0" x:Name="AttachAgentBtn" Style="{StaticResource Action}"
                                    Text="{l:Localize lblToolboxAgentAttach}" Clicked="OnAttachAgentClicked" />
                            <Button Grid.Column="1" x:Name="DetachAgentBtn" Style="{StaticResource Action}" WidthRequest="100"
                                    Text="{l:Localize lblToolboxAgentDetach}" Clicked="OnDetachAgentClicked" IsEnabled="False" />
                        </Grid>
                        <Label x:Name="AgentStatusLabel" FontSize="12" Opacity="0.8" />

                        <VerticalStackLayout x:Name="AgentSection" Spacing="8" IsVisible="False">
                            <Label Style="{StaticResource Section}" Text="{l:Localize lblToolboxAgentApps}" />
                            <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxAgentAppsHint}" />

                            <SearchBar x:Name="AgentSearch" Placeholder="{l:Localize lblToolboxFilter}"
                                       TextChanged="OnAgentFilterChanged" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" FontSize="12" Opacity="0.7" VerticalOptions="Center"
                                       Text="{l:Localize lblToolboxAgentHiddenOnly}" />
                                <Switch Grid.Column="1" x:Name="AgentHiddenOnly" Toggled="OnAgentFilterChanged" />
                            </Grid>

                            <VerticalStackLayout x:Name="AgentAppList" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Padding="0,4">
                                            <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Subtitle}" FontSize="11" Opacity="0.55"
                                                       LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Style="{StaticResource Action}" WidthRequest="80"
                                                    Text="{l:Localize lblToolboxLaunch}"
                                                    CommandParameter="{Binding}" Clicked="OnLaunchAgentAppClicked" />
                                            <Button Grid.Column="2" Style="{StaticResource Action}" WidthRequest="100"
                                                    Text="{l:Localize lblToolboxAgentAppControl}"
                                                    CommandParameter="{Binding}" Clicked="OnLaunchAgentAppControlClicked" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Anything not a button yet, straight into the agent -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Entry Grid.Column="0" x:Name="AgentExpression" Keyboard="Text"
                                       Placeholder="{l:Localize lblToolboxAgentEvaluatePlaceholder}" />
                                <Button Grid.Column="1" Style="{StaticResource Action}" WidthRequest="100"
                                        Text="{l:Localize lblToolboxAgentEvaluate}" Clicked="OnEvaluateAgentClicked" />
                            </Grid>
                            <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxAgentEvaluateHint}" />
                            <Label x:Name="AgentExpressionResult" FontSize="11" FontFamily="monospace" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ Service menu ============ -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Section}" Text="{l:Localize lblToolboxSequences}" />
                        <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxSequencesHint}" />

                        <VerticalStackLayout x:Name="SequenceList" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14" />
                                            <Label Text="{Binding Keys}" FontSize="11" Opacity="0.75" />
                                            <Label Text="{Binding Description}" FontSize="11" Opacity="0.55" />
                                            <Label Text="{Binding Caveat}" FontSize="11" Opacity="0.75"
                                                   IsVisible="{Binding HasCaveat}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Style="{StaticResource Action}" WidthRequest="88"
                                                VerticalOptions="Center" Text="{l:Localize lblToolboxSend}"
                                                CommandParameter="{Binding}" Clicked="OnSendSequenceClicked" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Timing is the whole reason for sending these over the network -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" FontSize="12" Opacity="0.7" VerticalOptions="Center"
                                   Text="{l:Localize lblToolboxGap}" />
                            <Slider Grid.Column="1" x:Name="GapSlider" Minimum="100" Maximum="600" Value="250"
                                    VerticalOptions="Center" />
                            <Label Grid.Column="2" FontSize="12" Opacity="0.8" VerticalOptions="Center"
                                   Text="{Binding Source={x:Reference GapSlider}, Path=Value, StringFormat='{0:0} ms'}" />
                        </Grid>
                        <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxGapHint}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ Combinations that start from standby ============ -->
                <!-- Printed rather than offered: a sleeping set serves no channel, so a button for one
                     of these could never fire. They are also the sequences most likely to rescue a
                     locked set, which is why they are here at all (#639). -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Section}" Text="{l:Localize lblToolboxStandbySequences}" />
                        <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxStandbyNote}" />

                        <VerticalStackLayout x:Name="StandbySequenceList" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14" />
                                        <Label Text="{Binding Keys}" FontSize="11" Opacity="0.75" />
                                        <Label Text="{Binding Description}" FontSize="11" Opacity="0.55" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label FontSize="12" Text="{l:Localize lblToolboxStandbyHowTo}" />
                        <VerticalStackLayout x:Name="StandbyStepList" Spacing="3">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label Style="{StaticResource Step}" Text="{Binding}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Border Style="{StaticResource Notice}" Stroke="#B3261E">
                            <Label FontSize="12" Text="{l:Localize lblToolboxStandbyWarning}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
