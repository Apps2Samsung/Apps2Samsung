<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             xmlns:controls="clr-namespace:Apps2Samsung.Mobile.Controls"
             x:Class="Apps2Samsung.Mobile.Pages.TvToolboxPage"
             Title="{l:Localize lblToolbox}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgColor}">

    <!-- The TV toolbox in the v3 language (#755): a page title with back and reload, the status line
         under it, then one grouped-list card per tool. The cards collapse (ExpanderSection), with
         "Open an app" open by default, so the page is a list of headings rather than a wall. Rows
         are the list idiom: name and subline on the left, a soft pill action on the right. The
         names and handlers are the ones the code-behind drives; only the drawing changed. -->
    <ContentPage.Resources>
        <!-- an input on the fill, like the search field on the Install tab -->
        <Style x:Key="Field" TargetType="Border">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="BackgroundColor" Value="{DynamicResource FillColor}" />
        </Style>
        <!-- what a section says about itself, under its title -->
        <Style x:Key="Hint" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{DynamicResource MutedColor}" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
        <!-- the status a tool reports back -->
        <Style x:Key="Report" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
        <!-- notices are read, not skimmed past: a soft tint with a border in the status colour -->
        <Style x:Key="Notice" TargetType="Border">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        </Style>
        <!-- one row of a tool's list; the hairline on top keeps rows apart inside the card -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="10" />
            <Setter Property="Padding" Value="0,10" />
            <Setter Property="MinimumHeightRequest" Value="48" />
        </Style>
        <Style x:Key="RowTitle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
        <Style x:Key="RowSub" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{DynamicResource MutedColor}" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
        <Style x:Key="Hairline" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="Color" Value="{DynamicResource HairColor}" />
        </Style>
        <Style x:Key="Step" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,10,16,0" RowSpacing="8">

        <!-- title row: back, title, reload -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,8,4,0">
            <Button Grid.Column="0" Text="‹" FontSize="22" Style="{StaticResource IconButton}" Clicked="OnBackClicked" />
            <Label Grid.Column="1" Text="{l:Localize lblToolbox}" Style="{StaticResource PageTitle}" />
            <Button Grid.Column="2" Text="⟳" Style="{StaticResource IconButton}" Clicked="OnReloadClicked" />
        </Grid>

        <!-- which TV, and whether the channel is up -->
        <Label Grid.Row="1" x:Name="StatusLabel" Style="{StaticResource Hint}" Margin="4,0"
               Text="{l:Localize lblRemoteConnecting}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="10" Padding="0,0,0,24">

                <Label Style="{StaticResource Footnote}" Text="{l:Localize lblToolboxOwnerNote}" LineBreakMode="WordWrap" />

                <!-- Only on a set the probe called hospitality: no Smart Hub, so no app store (#639) -->
                <Border x:Name="HospitalityNotice" Style="{StaticResource Notice}" IsVisible="False"
                        Stroke="{DynamicResource WarnBrush}" BackgroundColor="{DynamicResource WarnSoftColor}">
                    <Label FontSize="13" LineBreakMode="WordWrap" TextColor="{DynamicResource WarnColor}" Text="{l:Localize lblToolboxHospitality}" />
                </Border>
                <!-- The opposite case: an ordinary set with Smart Hub, on which the hospitality tools are
                     expected to open nothing. Said up front, so a dead Launch button isn't a mystery. -->
                <Border x:Name="ConsumerNotice" Style="{StaticResource Notice}" IsVisible="False"
                        Stroke="{DynamicResource AccentBrush}" BackgroundColor="{DynamicResource AccentSoftColor}">
                    <Label FontSize="13" LineBreakMode="WordWrap" Text="{l:Localize lblToolboxConsumer}" />
                </Border>

                <!-- ============ Open an app ============ -->
                <controls:ExpanderSection Title="{l:Localize lblToolboxApps}" IsExpanded="True">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxAppsHint}" />
                        <Label x:Name="OfflineHint" Style="{StaticResource Hint}" IsVisible="False"
                               Text="{l:Localize lblToolboxAppsOffline}" />

                        <Border Style="{StaticResource Field}">
                            <Entry x:Name="AppSearch" Placeholder="{l:Localize lblToolboxFilter}" BackgroundColor="Transparent"
                                   ReturnType="Search" TextChanged="OnFilterChanged" />
                        </Border>

                        <VerticalStackLayout x:Name="AppList" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="0">
                                        <BoxView Style="{StaticResource Hairline}" />
                                        <Grid Style="{StaticResource Row}" ColumnDefinitions="40,*,Auto">
                                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10" BackgroundColor="{DynamicResource FillColor}"
                                                    VerticalOptions="Center">
                                                <Image WidthRequest="40" HeightRequest="40" Aspect="AspectFit" Source="{Binding IconUrl}" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                                                <Label Style="{StaticResource RowSub}" LineBreakMode="TailTruncation" Text="{Binding Subtitle}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="2" Style="{StaticResource RowButton}" Text="{l:Localize lblToolboxLaunch}"
                                                    CommandParameter="{Binding}" Clicked="OnLaunchAppClicked" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- An ID from a forum post or a manual, for an app in neither list. Launch goes the
                             usual routes; "0 execute" is sdbd's other launcher verb, which answers in the
                             platform's own words - for a service, or an ID Smart Hub does not know. -->
                        <BoxView Style="{StaticResource Hairline}" />
                        <Border Style="{StaticResource Field}" Margin="0,6,0,0">
                            <Entry x:Name="ManualAppIdEntry" Keyboard="Text" BackgroundColor="Transparent"
                                   Placeholder="{l:Localize lblToolboxManualPlaceholder}" />
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Style="{StaticResource SoftButton}" HeightRequest="44" MinimumHeightRequest="44" Padding="12,0"
                                    Text="{l:Localize lblToolboxLaunch}" Clicked="OnLaunchManualClicked" />
                            <Button Grid.Column="1" x:Name="ExecuteManualBtn" Style="{StaticResource PlainButton}" HeightRequest="44" MinimumHeightRequest="44" Padding="12,0"
                                    Text="{l:Localize lblToolboxExecute}" Clicked="OnExecuteManualClicked" />
                        </Grid>
                        <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxExecuteHint}" />
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <!-- ============ Hidden system apps ============ -->
                <!-- The TV's own menus, addressed by ID because the key combination that used to open them
                     has stopped answering. They launch through the debug agent below (#34); without it the
                     SDB attempt still runs so the TV's own refusal is what the user reads (#641). -->
                <controls:ExpanderSection Title="{l:Localize lblToolboxSystemApps}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxSystemAppsHint}" />
                        <VerticalStackLayout x:Name="SystemAppList" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="0">
                                        <BoxView Style="{StaticResource Hairline}" />
                                        <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                                                <Label Style="{StaticResource RowSub}" Text="{Binding Description}" />
                                                <Label FontSize="12" TextColor="{DynamicResource MutedColor}" Text="{Binding AppId}" FontFamily="monospace" />
                                                <Label FontSize="12" TextColor="{DynamicResource WarnColor}" LineBreakMode="WordWrap"
                                                       Text="{l:Localize lblToolboxSystemAppCaution}" IsVisible="{Binding IsCaution}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Style="{StaticResource RowButton}" Text="{l:Localize lblToolboxLaunch}"
                                                    CommandParameter="{Binding}" Clicked="OnLaunchSystemAppClicked" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <!-- ============ Debug agent ============ -->
                <!-- The route that reaches the rows above (#34): an app of ours on the TV, driven over the
                     web inspector, asking the platform's own application manager. Also the one honest app
                     list a hospitality set has. Needs Developer Mode. -->
                <controls:ExpanderSection x:Name="AgentCard" Title="{l:Localize lblToolboxAgent}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxAgentHint}" />
                        <Label x:Name="AgentNeedsSdbHint" Style="{StaticResource Hint}" IsVisible="False"
                               Text="{l:Localize lblToolboxAgentNeedsSdb}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Grid.Column="0" x:Name="AttachAgentBtn" HeightRequest="44" MinimumHeightRequest="44"
                                    Text="{l:Localize lblToolboxAgentAttach}" Clicked="OnAttachAgentClicked" />
                            <Button Grid.Column="1" x:Name="DetachAgentBtn" Style="{StaticResource PlainButton}" HeightRequest="44" MinimumHeightRequest="44" Padding="16,0"
                                    Text="{l:Localize lblToolboxAgentDetach}" Clicked="OnDetachAgentClicked" IsEnabled="False" />
                        </Grid>
                        <Label x:Name="AgentStatusLabel" Style="{StaticResource Report}" />

                        <VerticalStackLayout x:Name="AgentSection" Spacing="8" IsVisible="False">
                            <BoxView Style="{StaticResource Hairline}" Margin="0,4" />
                            <Label Style="{StaticResource RowTitle}" Text="{l:Localize lblToolboxAgentApps}" />
                            <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxAgentAppsHint}" />

                            <Border Style="{StaticResource Field}">
                                <Entry x:Name="AgentSearch" Placeholder="{l:Localize lblToolboxFilter}" BackgroundColor="Transparent"
                                       ReturnType="Search" TextChanged="OnAgentFilterChanged" />
                            </Border>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Style="{StaticResource RowSub}" VerticalOptions="Center"
                                       Text="{l:Localize lblToolboxAgentHiddenOnly}" />
                                <Switch Grid.Column="1" x:Name="AgentHiddenOnly" Toggled="OnAgentFilterChanged" />
                            </Grid>

                            <VerticalStackLayout x:Name="AgentAppList" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="0">
                                            <BoxView Style="{StaticResource Hairline}" />
                                            <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                                    <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                                                    <Label Style="{StaticResource RowSub}" LineBreakMode="TailTruncation" Text="{Binding Subtitle}" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="1" Style="{StaticResource RowButton}" Text="{l:Localize lblToolboxLaunch}"
                                                        CommandParameter="{Binding}" Clicked="OnLaunchAgentAppClicked" />
                                                <Button Grid.Column="2" Style="{StaticResource RowButton}" BackgroundColor="{DynamicResource FillColor}" TextColor="{DynamicResource InkColor}"
                                                        Text="{l:Localize lblToolboxAgentAppControl}"
                                                        CommandParameter="{Binding}" Clicked="OnLaunchAgentAppControlClicked" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Anything not a button yet, straight into the agent -->
                            <BoxView Style="{StaticResource Hairline}" />
                            <Border Style="{StaticResource Field}" Margin="0,6,0,0">
                                <Entry x:Name="AgentExpression" Keyboard="Text" BackgroundColor="Transparent"
                                       Placeholder="{l:Localize lblToolboxAgentEvaluatePlaceholder}" />
                            </Border>
                            <Button Style="{StaticResource SoftButton}" HeightRequest="44" MinimumHeightRequest="44"
                                    Text="{l:Localize lblToolboxAgentEvaluate}" Clicked="OnEvaluateAgentClicked" />
                            <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxAgentEvaluateHint}" />
                            <Label x:Name="AgentExpressionResult" FontSize="12" FontFamily="monospace" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <!-- ============ Install leftovers ============ -->
                <!-- sdbd pushes every package to /home/owner/share/tmp/sdk_tools and leaves it there; its own
                     "0 rmfile" verb is accepted but deletes nothing on retail firmware. The agent runs as that
                     folder's owner, so it lists and clears the folder itself. Clear takes package files only;
                     any other file goes by its own ✕ (#681). Needs the agent attached. -->
                <controls:ExpanderSection x:Name="StagingCard" Title="{l:Localize lblToolboxStaging}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxStagingHint}" />
                        <Label x:Name="StagingNeedsAgentHint" Style="{StaticResource Hint}"
                               Text="{l:Localize lblToolboxStagingNeedsAgent}" />

                        <VerticalStackLayout x:Name="StagingSection" Spacing="8" IsVisible="False">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Button Grid.Column="0" x:Name="ClearStagingBtn" Style="{StaticResource DangerButton}" HeightRequest="44" MinimumHeightRequest="44"
                                        Text="{l:Localize lblToolboxStagingClear}" Clicked="OnClearStagingClicked" IsEnabled="False" />
                                <Button Grid.Column="1" x:Name="RefreshStagingBtn" Style="{StaticResource PlainButton}" HeightRequest="44" MinimumHeightRequest="44" Padding="16,0"
                                        Text="{l:Localize lblToolboxStagingRefresh}" Clicked="OnRefreshStagingClicked" />
                            </Grid>
                            <Label x:Name="StagingStatusLabel" Style="{StaticResource Report}" />

                            <VerticalStackLayout x:Name="StagedFileList" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="0">
                                            <BoxView Style="{StaticResource Hairline}" />
                                            <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto,Auto" Padding="0,6" MinimumHeightRequest="40">
                                                <Label Grid.Column="0" FontSize="13" LineBreakMode="TailTruncation" VerticalOptions="Center" Text="{Binding Name}" />
                                                <Label Grid.Column="1" Style="{StaticResource RowSub}" VerticalOptions="Center" Text="{Binding Detail}" />
                                                <Button Grid.Column="2" Text="✕" Style="{StaticResource IconButton}" WidthRequest="32" HeightRequest="32"
                                                        MinimumWidthRequest="32" MinimumHeightRequest="32" CornerRadius="16" FontSize="12"
                                                        TextColor="{DynamicResource BadColor}" IsVisible="{Binding CanDelete}"
                                                        SemanticProperties.Description="{l:Localize lblToolboxStagingDelete}"
                                                        CommandParameter="{Binding}" Clicked="OnDeleteStagedFileClicked" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <!-- ============ Service menu ============ -->
                <controls:ExpanderSection Title="{l:Localize lblToolboxSequences}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxSequencesHint}" />

                        <VerticalStackLayout x:Name="SequenceList" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="0">
                                        <BoxView Style="{StaticResource Hairline}" />
                                        <Grid Style="{StaticResource Row}" ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                                                <Label FontSize="13" FontFamily="monospace" Text="{Binding Keys}" />
                                                <Label Style="{StaticResource RowSub}" Text="{Binding Description}" />
                                                <Label FontSize="12" TextColor="{DynamicResource WarnColor}" LineBreakMode="WordWrap"
                                                       Text="{Binding Caveat}" IsVisible="{Binding HasCaveat}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Style="{StaticResource RowButton}" Text="{l:Localize lblToolboxSend}"
                                                    CommandParameter="{Binding}" Clicked="OnSendSequenceClicked" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Timing is the whole reason for sending these over the network -->
                        <BoxView Style="{StaticResource Hairline}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                            <Label Grid.Column="0" Style="{StaticResource RowSub}" VerticalOptions="Center" Text="{l:Localize lblToolboxGap}" />
                            <Slider Grid.Column="1" x:Name="GapSlider" Minimum="100" Maximum="600" Value="250" VerticalOptions="Center" />
                            <Label Grid.Column="2" FontSize="13" VerticalOptions="Center" FontFamily="monospace"
                                   Text="{Binding Source={x:Reference GapSlider}, Path=Value, StringFormat='{0:0} ms'}" />
                        </Grid>
                        <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxGapHint}" />
                    </VerticalStackLayout>
                </controls:ExpanderSection>

                <!-- ============ Combinations that start from standby ============ -->
                <!-- Printed rather than offered: a sleeping set serves no channel, so a button for one of
                     these could never fire. They are also the sequences most likely to rescue a locked
                     set, which is why they are here at all (#639). -->
                <controls:ExpanderSection Title="{l:Localize lblToolboxStandbySequences}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Hint}" Text="{l:Localize lblToolboxStandbyNote}" />

                        <VerticalStackLayout x:Name="StandbySequenceList" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="0">
                                        <BoxView Style="{StaticResource Hairline}" />
                                        <VerticalStackLayout Spacing="2" Padding="0,10">
                                            <Label Style="{StaticResource RowTitle}" Text="{Binding Name}" />
                                            <Label FontSize="13" FontFamily="monospace" Text="{Binding Keys}" />
                                            <Label Style="{StaticResource RowSub}" Text="{Binding Description}" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource Hairline}" />
                        <Label Style="{StaticResource RowTitle}" Margin="0,6,0,0" Text="{l:Localize lblToolboxStandbyHowTo}" />
                        <VerticalStackLayout x:Name="StandbyStepList" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label Style="{StaticResource Step}" Text="{Binding}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Border Style="{StaticResource Notice}" Stroke="{DynamicResource BadBrush}" BackgroundColor="{DynamicResource BadSoftColor}">
                            <Label FontSize="13" LineBreakMode="WordWrap" TextColor="{DynamicResource BadColor}" Text="{l:Localize lblToolboxStandbyWarning}" />
                        </Border>
                    </VerticalStackLayout>
                </controls:ExpanderSection>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
