<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             xmlns:controls="clr-namespace:Apps2Samsung.Mobile.Controls"
             x:Class="Apps2Samsung.Mobile.Pages.SettingsCameraPipPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgColor}">

    <!-- Settings > App customization > Camera PiP: cameras, mosaic style and sound, written into the package's config.js. -->
    <Grid RowDefinitions="Auto,*">
        <controls:TopBarView x:Name="TopBar" Grid.Row="0" BackText="{l:Localize lblAppCustomization}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,20" Spacing="8">
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource RowHint}"
                               Text="{l:Localize hintCameraPip}" />
                        <VerticalStackLayout x:Name="CamerasContainer" Spacing="8" />
                        <Button x:Name="AddCameraBtn" Text="{l:Localize lblAddCamera}" HorizontalOptions="Start" Style="{StaticResource SoftButton}"
                                Padding="14,8" Clicked="OnAddCamera" />
                        <Label Style="{StaticResource RowHint}"
                               Text="{l:Localize lblCameraPipUrlsHint}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{l:Localize lblCameraPipMosaicStyle}" VerticalOptions="Center" />
                            <Picker Grid.Column="1" x:Name="CameraPipMosaicPicker" SelectedIndexChanged="OnCameraPipMosaicChanged"
                                    HorizontalOptions="End" WidthRequest="200" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{l:Localize lblCameraPipSound}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" x:Name="CameraPipSoundSwitch" OnColor="{DynamicResource AccentColor}" Toggled="OnCameraPipSoundToggled" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
