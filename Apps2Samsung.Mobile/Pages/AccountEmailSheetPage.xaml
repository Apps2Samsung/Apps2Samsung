<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Apps2Samsung.Mobile.Pages.AccountEmailSheetPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgColor}">
    <!-- The Samsung account has no email address (#606, #755): what to do about it, and a button to
         the account page. -->
    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,24" Spacing="14">
            <BoxView WidthRequest="36" HeightRequest="5" CornerRadius="3" HorizontalOptions="Center"
                     Color="{DynamicResource HairColor}" />

            <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 11"
                        BackgroundColor="{DynamicResource WarnSoftColor}">
                    <shapes:Path Data="M4,6 L20,6 L20,18 L4,18 Z M4,7 L12,13 L20,7"
                                 Stroke="{DynamicResource WarnBrush}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeLineCap="Round"
                                 WidthRequest="22" HeightRequest="22" Aspect="Uniform"
                                 HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="{l:Localize lblSamsungAccountNoEmailTitle}" FontSize="17" FontAttributes="Bold"
                       VerticalOptions="Center" />
            </Grid>

            <Label Text="{l:Localize certNoEmailBody}" FontSize="14" LineHeight="1.3" />

            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource SurfaceColor}">
                <VerticalStackLayout x:Name="Steps" />
            </Border>

            <VerticalStackLayout Spacing="8">
                <Button Text="{l:Localize lblOpenSamsungAccount}" Style="{StaticResource PrimaryButton}"
                        CornerRadius="12" HeightRequest="50" Clicked="OnOpenAccountClicked" />
                <Button Text="{l:Localize btn_Close}" BackgroundColor="Transparent" TextColor="{DynamicResource InkColor}"
                        FontAttributes="Bold" HeightRequest="44" Clicked="OnCloseClicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
