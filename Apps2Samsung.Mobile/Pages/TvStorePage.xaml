<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             xmlns:controls="clr-namespace:Apps2Samsung.Mobile.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Apps2Samsung.Mobile.Pages.TvStorePage"
             Title="{l:Localize lblToolboxTvStore}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgColor}">

    <!-- The TV-Store tab (#1041, option A): the catalog on the TV, out of the toolbox. A glass card
         with what the TV said about TV-Store, the setup check that replaced the toolbox's long hint,
         the certificate hand-over (Arm), and what goes to TV-Store: signed repositories and a package.
         The check lines and the repository rows are filled in from code. -->
    <ContentPage.Resources>
        <Style x:Key="Report" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
        <Style x:Key="RowTitle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- The top bar (#755): the TV with ▾, what the check found, and ⟳ to check again -->
        <controls:TopBarView x:Name="TopBar" Grid.Row="0" TvTitle="True" Action="Glyph" Glyph="⟳"
                             TitleTapped="OnChangeTvClicked" GlyphTapped="OnCheckAgainClicked" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="10" Padding="16,4,16,24">

                <!-- What the TV said: name and version, the first check, and the way to the catalog
                     when TV-Store is missing or too old (#888) -->
                <Border StrokeThickness="6" Stroke="{DynamicResource BezelBrush}" StrokeShape="RoundRectangle 18"
                        BackgroundColor="{DynamicResource GlassColor}" Padding="16,14">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="48,*" ColumnSpacing="14">
                            <Border Grid.Column="0" WidthRequest="48" HeightRequest="48" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource TileMediaColor}" VerticalOptions="Center">
                                <shapes:Path Stroke="{DynamicResource GlassInkBrush}" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="24" HeightRequest="24"
                                      Data="M5,8 L19,8 L18,20 L6,20 Z M9,8 L9,6 A3,3 0 0 1 15,6 L15,8" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label x:Name="HeadlineLabel" Text="{l:Localize lblToolboxTvStore}" FontSize="21" FontFamily="OpenSansSemibold"
                                       TextColor="{DynamicResource GlassInkColor}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                    <shapes:Ellipse x:Name="Led" WidthRequest="8" HeightRequest="8" VerticalOptions="Center"
                                             Fill="{DynamicResource MutedBrush}" />
                                    <Label Grid.Column="1" x:Name="SublineLabel" FontSize="13" LineBreakMode="WordWrap"
                                           TextColor="{DynamicResource GlassMutedColor}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                        <Button x:Name="ShowInCatalogBtn" Style="{StaticResource ChipButtonSolid}" HorizontalOptions="Start" IsVisible="False"
                                Text="{l:Localize lblToolboxTvStoreShowInCatalog}" Clicked="OnShowInCatalogClicked" />
                    </VerticalStackLayout>
                </Border>

                <Label Style="{StaticResource Footnote}" LineBreakMode="WordWrap" Text="{l:Localize lblTvStoreIntro}" />

                <!-- ============ Setup check ============ -->
                <Label Style="{StaticResource GroupTitle}" Text="{l:Localize lblTvStoreSetupCheck}" />
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout x:Name="ChecksHost" Spacing="10" />
                        <Label Style="{StaticResource RowHint}" Text="{l:Localize lblTvStoreCheckNote}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ Certificate (Arm, #844) ============ -->
                <Label Style="{StaticResource GroupTitle}" Text="{l:Localize lblTvStoreCertificate}" />
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <VerticalStackLayout Spacing="10">
                        <Label Style="{StaticResource RowHint}" Text="{l:Localize lblTvStoreArmHint}" />
                        <Label x:Name="NeedsSdbHint" Style="{StaticResource RowHint}" TextColor="{DynamicResource WarnColor}" IsVisible="False"
                               Text="{l:Localize lblToolboxAgentNeedsSdb}" />
                        <Button x:Name="ArmBtn" Style="{StaticResource PrimaryButton}" HeightRequest="44" MinimumHeightRequest="44"
                                Text="{l:Localize lblToolboxTvStoreArm}" Clicked="OnArmClicked" />
                        <Label x:Name="ArmStatusLabel" Style="{StaticResource Report}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ Send to TV-Store ============ -->
                <Label Style="{StaticResource GroupTitle}" Text="{l:Localize lblTvStoreSendGroup}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="0">
                        <!-- Send sources to TV (#1018, TV-Store#82): the signed repositories of Your sources, with
                             the keys approved here; the TV asks before adding each. Unsigned ones never go. -->
                        <VerticalStackLayout Spacing="8" Padding="16,12">
                            <Label Style="{StaticResource RowTitle}" Text="{l:Localize lblToolboxSendSources}" />
                            <Label Style="{StaticResource RowHint}" Text="{l:Localize lblToolboxSendSourcesHint}" />
                            <Label x:Name="NoTvSourcesLabel" Style="{StaticResource RowHint}" Text="{l:Localize lblToolboxSendSourcesNone}" IsVisible="False" />
                            <VerticalStackLayout x:Name="TvSourceRows" Spacing="2" />
                            <Button x:Name="SendSourcesBtn" Style="{StaticResource SoftButton}" HeightRequest="44" MinimumHeightRequest="44"
                                    Text="{l:Localize lblToolboxSendSources}" Clicked="OnSendSourcesClicked" />
                            <Label x:Name="SourcesStatusLabel" Style="{StaticResource Report}" />
                        </VerticalStackLayout>
                        <BoxView Style="{StaticResource RowDivider}" />
                        <!-- A package of the user's own (#979): to TV-Store's upload page on the TV, which asks
                             on the screen and signs it itself. No developer connection on this side. -->
                        <VerticalStackLayout Spacing="8" Padding="16,12">
                            <Label Style="{StaticResource RowTitle}" Text="{l:Localize lblTvStoreSendPackage}" />
                            <Label Style="{StaticResource RowHint}" Text="{l:Localize lblTvStoreSendPackageHint}" />
                            <Button x:Name="SendPackageBtn" Style="{StaticResource SoftButton}" HeightRequest="44" MinimumHeightRequest="44"
                                    Text="{l:Localize lblToolboxSendToTvStore}" Clicked="OnSendPackageClicked" />
                            <Label x:Name="PackageStatusLabel" Style="{StaticResource Report}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
