<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             x:Class="Apps2Samsung.Mobile.Pages.RemotePage"
             Title="{l:Localize lblRemote}"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#ECEFF1, Dark=#141414}">

    <ContentPage.Resources>
        <!-- One look for every key: a round-cornered tile big enough to hit without looking. -->
        <Style x:Key="Key" TargetType="Button">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HeightRequest" Value="56" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1F1F1F}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#2C3E50, Dark=White}" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light=#E2E2E2, Dark=#333}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource Key}">
            <Setter Property="BackgroundColor" Value="#2C3E50" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="12" RowSpacing="10">

        <!-- Header banner with a back affordance -->
        <Border Grid.Row="0" BackgroundColor="#2C3E50" Padding="12,18" StrokeThickness="0" StrokeShape="RoundRectangle 8">
            <Grid ColumnDefinitions="44,*,44" ColumnSpacing="4" VerticalOptions="Center">
                <Button Grid.Column="0" Text="‹" FontSize="26" TextColor="White"
                        BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                        WidthRequest="44" HeightRequest="44" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="{l:Localize lblRemote}" TextColor="White" FontAttributes="Bold"
                       VerticalOptions="Center" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Button Grid.Column="2" Text="⏻" FontSize="18" TextColor="White"
                        BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                        WidthRequest="44" HeightRequest="44"
                        CommandParameter="KEY_POWER" Clicked="OnKeyClicked" />
            </Grid>
        </Border>

        <!-- Which TV, and whether the channel is up -->
        <Label Grid.Row="1" x:Name="StatusLabel" FontSize="12" Opacity="0.6" Text="{l:Localize lblRemoteConnecting}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="14">

                <!-- D-pad: the one control that has to be reachable with a thumb -->
                <Grid RowDefinitions="56,56,56" ColumnDefinitions="*,*,*" RowSpacing="8" ColumnSpacing="8">
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource Key}" Text="▲"
                            CommandParameter="KEY_UP" Clicked="OnKeyClicked" />
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource Key}" Text="◀"
                            CommandParameter="KEY_LEFT" Clicked="OnKeyClicked" />
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource Accent}" Text="{l:Localize lblRemoteOk}"
                            FontAttributes="Bold" CommandParameter="KEY_ENTER" Clicked="OnKeyClicked" />
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Key}" Text="▶"
                            CommandParameter="KEY_RIGHT" Clicked="OnKeyClicked" />
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource Key}" Text="▼"
                            CommandParameter="KEY_DOWN" Clicked="OnKeyClicked" />
                </Grid>

                <!-- Back / Home / Menu / Source -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Style="{StaticResource Key}" Text="↩" FontSize="20"
                            CommandParameter="KEY_RETURN" Clicked="OnKeyClicked" />
                    <Button Grid.Column="1" Style="{StaticResource Key}" Text="⌂" FontSize="20"
                            CommandParameter="KEY_HOME" Clicked="OnKeyClicked" />
                    <Button Grid.Column="2" Style="{StaticResource Key}" Text="☰" FontSize="18"
                            CommandParameter="KEY_MENU" Clicked="OnKeyClicked" />
                    <Button Grid.Column="3" Style="{StaticResource Key}" Text="⇄" FontSize="18"
                            CommandParameter="KEY_SOURCE" Clicked="OnKeyClicked" />
                </Grid>

                <!-- Playback: what the issue asked for first -->
                <Label Text="{l:Localize lblRemotePlayback}" FontSize="12" Opacity="0.6" Margin="2,4,0,0" />
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Style="{StaticResource Key}" Text="⏮"
                            CommandParameter="KEY_REWIND_" Clicked="OnKeyClicked" />
                    <Button Grid.Column="1" Style="{StaticResource Key}" Text="⏪"
                            CommandParameter="KEY_REWIND" Clicked="OnKeyClicked" />
                    <Button Grid.Column="2" Style="{StaticResource Accent}" Text="⏯"
                            Clicked="OnPlayPauseClicked" />
                    <Button Grid.Column="3" Style="{StaticResource Key}" Text="⏩"
                            CommandParameter="KEY_FF" Clicked="OnKeyClicked" />
                    <Button Grid.Column="4" Style="{StaticResource Key}" Text="⏭"
                            CommandParameter="KEY_FF_" Clicked="OnKeyClicked" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Style="{StaticResource Key}" Text="{l:Localize Key=lblRemoteStop, Format='⏹ {0}'}" FontSize="14"
                            CommandParameter="KEY_STOP" Clicked="OnKeyClicked" />
                    <Button Grid.Column="1" Style="{StaticResource Key}" Text="{l:Localize Key=lblRemoteMute, Format='🔇 {0}'}" FontSize="14"
                            CommandParameter="KEY_MUTE" Clicked="OnKeyClicked" />
                </Grid>

                <!-- Volume and channel -->
                <Label Text="{l:Localize lblRemoteVolumeChannel}" FontSize="12" Opacity="0.6" Margin="2,4,0,0" />
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Style="{StaticResource Key}" Text="{l:Localize lblRemoteVolumeUp}" FontSize="14"
                            CommandParameter="KEY_VOLUP" Clicked="OnKeyClicked" />
                    <Button Grid.Column="1" Style="{StaticResource Key}" Text="{l:Localize lblRemoteVolumeDown}" FontSize="14"
                            CommandParameter="KEY_VOLDOWN" Clicked="OnKeyClicked" />
                    <Button Grid.Column="2" Style="{StaticResource Key}" Text="{l:Localize lblRemoteChannelUp}" FontSize="14"
                            CommandParameter="KEY_CHUP" Clicked="OnKeyClicked" />
                    <Button Grid.Column="3" Style="{StaticResource Key}" Text="{l:Localize lblRemoteChannelDown}" FontSize="14"
                            CommandParameter="KEY_CHDOWN" Clicked="OnKeyClicked" />
                </Grid>

                <!-- Phone keyboard instead of the on-screen one. The TV's SendInputString replaces the
                     focused field's whole contents rather than appending to it, so mirroring the box as
                     it is typed - debounced, newest value wins - keeps the TV in step keystroke by
                     keystroke, backspace included. The button is no longer a Send: by the time it is
                     pressed the text is already on the TV, so all it does is commit it with Enter. -->
                <Label Text="{l:Localize lblRemoteTypeOnTv}" FontSize="12" Opacity="0.6" Margin="2,4,0,0" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" x:Name="TextEntry" Placeholder="{l:Localize lblRemoteTextLivePlaceholder}"
                           ReturnType="Done" TextChanged="OnTextChanged" Completed="OnSubmitClicked" />
                    <Button Grid.Column="1" Style="{StaticResource Accent}" Text="⏎" FontSize="20"
                            WidthRequest="64" Clicked="OnSubmitClicked"
                            SemanticProperties.Description="{l:Localize lblRemoteSubmit}" />
                </Grid>
                <Label x:Name="TextHintLabel" FontSize="11" Opacity="0.5"
                       Text="{l:Localize lblRemoteTextLiveHint}" />

                <!-- TV toolbox (#635): the two things a stuck remote can't do - a documented key
                     combination with exact timing, and launching an app the TV's launcher hides. The
                     phone is the better host for it: it is what you are holding when the remote died. -->
                <Border Margin="0,12,0,0" Padding="12" StrokeThickness="1" StrokeShape="RoundRectangle 10"
                        Stroke="{AppThemeBinding Light=#E2E2E2, Dark=#333}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}">
                    <VerticalStackLayout Spacing="8">

                        <Label Text="{l:Localize lblToolbox}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{l:Localize lblToolboxOwnerNote}" FontSize="11" Opacity="0.55" />
                        <Label x:Name="ToolboxStatusLabel" FontSize="12" Opacity="0.85" IsVisible="False" />

                        <!-- Service-menu combinations -->
                        <Label Text="{l:Localize lblToolboxSequences}" FontSize="12" Opacity="0.6" Margin="0,4,0,0" />
                        <VerticalStackLayout x:Name="SequenceList" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14" />
                                            <Label Text="{Binding Keys}" FontSize="11" Opacity="0.75" />
                                            <Label Text="{Binding Description}" FontSize="11" Opacity="0.55" />
                                            <Label Text="{Binding Caveat}" FontSize="11" Opacity="0.75"
                                                   IsVisible="{Binding HasCaveat}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Style="{StaticResource Accent}" FontSize="14"
                                                WidthRequest="84" HeightRequest="44" VerticalOptions="Center"
                                                Text="{l:Localize lblToolboxSend}"
                                                CommandParameter="{Binding}" Clicked="OnSendSequenceClicked" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Timing is the whole reason for doing this over the network, so it is adjustable -->
                        <Label Text="{l:Localize lblToolboxGap}" FontSize="12" Opacity="0.6" Margin="0,4,0,0" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Slider Grid.Column="0" x:Name="GapSlider" Minimum="100" Maximum="600" Value="250"
                                    VerticalOptions="Center" />
                            <Label Grid.Column="1" FontSize="12" Opacity="0.8" VerticalOptions="Center"
                                   Text="{Binding Source={x:Reference GapSlider}, Path=Value, StringFormat='{0:0} ms'}" />
                        </Grid>
                        <Label Text="{l:Localize lblToolboxGapHint}" FontSize="11" Opacity="0.5" />
                        <Label Text="{l:Localize lblToolboxStandbyNote}" FontSize="11" Opacity="0.5" />

                        <!-- Launch an app by ID -->
                        <Label Text="{l:Localize lblToolboxApps}" FontSize="12" Opacity="0.6" Margin="0,8,0,0" />
                        <Label Text="{l:Localize lblToolboxAppsHint}" FontSize="11" Opacity="0.5" />
                        <Button x:Name="LoadAppsBtn" Style="{StaticResource Accent}" FontSize="14"
                                HorizontalOptions="Start" WidthRequest="140"
                                Text="{l:Localize lblToolboxLoadApps}" Clicked="OnLoadAppsClicked" />

                        <VerticalStackLayout x:Name="ToolboxAppList" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                        <Image Grid.Column="0" WidthRequest="40" HeightRequest="40" Aspect="AspectFit"
                                               VerticalOptions="Center" Source="{Binding IconUrl}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding AppId}" FontSize="11" Opacity="0.55"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Origin}" FontSize="11" Opacity="0.55"
                                                   IsVisible="{Binding HasOrigin}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2" Style="{StaticResource Key}" FontSize="14"
                                                WidthRequest="84" HeightRequest="44" VerticalOptions="Center"
                                                Text="{l:Localize lblToolboxLaunch}"
                                                CommandParameter="{Binding}" Clicked="OnLaunchAppClicked" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- An ID from a forum post or a manual, for an app in neither list -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0" x:Name="ManualAppIdEntry" Keyboard="Text"
                                   Placeholder="{l:Localize lblToolboxManualPlaceholder}" />
                            <Button Grid.Column="1" Style="{StaticResource Accent}" FontSize="14"
                                    WidthRequest="84" Text="{l:Localize lblToolboxLaunch}"
                                    Clicked="OnLaunchManualClicked" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
