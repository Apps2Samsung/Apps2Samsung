<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             x:Class="Apps2Samsung.Mobile.Pages.RemotePage"
             Title="{l:Localize lblRemote}"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#ECEFF1, Dark=#141414}">

    <ContentPage.Resources>
        <!-- One look for every key: a round-cornered tile big enough to hit without looking. -->
        <Style x:Key="Key" TargetType="Button">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HeightRequest" Value="56" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1F1F1F}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#2C3E50, Dark=White}" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light=#E2E2E2, Dark=#333}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource Key}">
            <Setter Property="BackgroundColor" Value="#2C3E50" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="12" RowSpacing="10">

        <!-- Header banner with a back affordance -->
        <Border Grid.Row="0" BackgroundColor="#2C3E50" Padding="12,18" StrokeThickness="0" StrokeShape="RoundRectangle 8">
            <Grid ColumnDefinitions="44,*,44" ColumnSpacing="4" VerticalOptions="Center">
                <Button Grid.Column="0" Text="‹" FontSize="26" TextColor="White"
                        BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                        WidthRequest="44" HeightRequest="44" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="{l:Localize lblRemote}" TextColor="White" FontAttributes="Bold"
                       VerticalOptions="Center" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <Button Grid.Column="2" Text="⏻" FontSize="18" TextColor="White"
                        BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                        WidthRequest="44" HeightRequest="44"
                        CommandParameter="KEY_POWER" Clicked="OnKeyClicked" />
            </Grid>
        </Border>

        <!-- Which TV, and whether the channel is up -->
        <Label Grid.Row="1" x:Name="StatusLabel" FontSize="12" Opacity="0.6" Text="{l:Localize lblRemoteConnecting}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="14">

                <!-- D-pad: the one control that has to be reachable with a thumb -->
                <Grid RowDefinitions="56,56,56" ColumnDefinitions="*,*,*" RowSpacing="8" ColumnSpacing="8">
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource Key}" Text="▲"
                            CommandParameter="KEY_UP" Clicked="OnKeyClicked" />
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource Key}" Text="◀"
                            CommandParameter="KEY_LEFT" Clicked="OnKeyClicked" />
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource Accent}" Text="{l:Localize lblRemoteOk}"
                            FontAttributes="Bold" CommandParameter="KEY_ENTER" Clicked="OnKeyClicked" />
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Key}" Text="▶"
                            CommandParameter="KEY_RIGHT" Clicked="OnKeyClicked" />
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource Key}" Text="▼"
                            CommandParameter="KEY_DOWN" Clicked="OnKeyClicked" />
                </Grid>

                <!-- Back / Home / Menu / Source -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Style="{StaticResource Key}" Text="↩" FontSize="20"
                            CommandParameter="KEY_RETURN" Clicked="OnKeyClicked" />
                    <Button Grid.Column="1" Style="{StaticResource Key}" Text="⌂" FontSize="20"
                            CommandParameter="KEY_HOME" Clicked="OnKeyClicked" />
                    <Button Grid.Column="2" Style="{StaticResource Key}" Text="☰" FontSize="18"
                            CommandParameter="KEY_MENU" Clicked="OnKeyClicked" />
                    <Button Grid.Column="3" Style="{StaticResource Key}" Text="⇄" FontSize="18"
                            CommandParameter="KEY_SOURCE" Clicked="OnKeyClicked" />
                </Grid>

                <!-- Playback: what the issue asked for first -->
                <Label Text="{l:Localize lblRemotePlayback}" FontSize="12" Opacity="0.6" Margin="2,4,0,0" />
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Style="{StaticResource Key}" Text="⏮"
                            CommandParameter="KEY_REWIND_" Clicked="OnKeyClicked" />
                    <Button Grid.Column="1" Style="{StaticResource Key}" Text="⏪"
                            CommandParameter="KEY_REWIND" Clicked="OnKeyClicked" />
                    <Button Grid.Column="2" Style="{StaticResource Accent}" Text="⏯"
                            Clicked="OnPlayPauseClicked" />
                    <Button Grid.Column="3" Style="{StaticResource Key}" Text="⏩"
                            CommandParameter="KEY_FF" Clicked="OnKeyClicked" />
                    <Button Grid.Column="4" Style="{StaticResource Key}" Text="⏭"
                            CommandParameter="KEY_FF_" Clicked="OnKeyClicked" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Style="{StaticResource Key}" Text="{l:Localize Key=lblRemoteStop, Format='⏹ {0}'}" FontSize="14"
                            CommandParameter="KEY_STOP" Clicked="OnKeyClicked" />
                    <Button Grid.Column="1" Style="{StaticResource Key}" Text="{l:Localize Key=lblRemoteMute, Format='🔇 {0}'}" FontSize="14"
                            CommandParameter="KEY_MUTE" Clicked="OnKeyClicked" />
                </Grid>

                <!-- Volume and channel -->
                <Label Text="{l:Localize lblRemoteVolumeChannel}" FontSize="12" Opacity="0.6" Margin="2,4,0,0" />
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Style="{StaticResource Key}" Text="{l:Localize lblRemoteVolumeUp}" FontSize="14"
                            CommandParameter="KEY_VOLUP" Clicked="OnKeyClicked" />
                    <Button Grid.Column="1" Style="{StaticResource Key}" Text="{l:Localize lblRemoteVolumeDown}" FontSize="14"
                            CommandParameter="KEY_VOLDOWN" Clicked="OnKeyClicked" />
                    <Button Grid.Column="2" Style="{StaticResource Key}" Text="{l:Localize lblRemoteChannelUp}" FontSize="14"
                            CommandParameter="KEY_CHUP" Clicked="OnKeyClicked" />
                    <Button Grid.Column="3" Style="{StaticResource Key}" Text="{l:Localize lblRemoteChannelDown}" FontSize="14"
                            CommandParameter="KEY_CHDOWN" Clicked="OnKeyClicked" />
                </Grid>

                <!-- Phone keyboard instead of the on-screen one -->
                <Label Text="{l:Localize lblRemoteTypeOnTv}" FontSize="12" Opacity="0.6" Margin="2,4,0,0" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0" x:Name="TextEntry" Placeholder="{l:Localize lblRemoteTextPlaceholder}"
                           ReturnType="Send" Completed="OnSendTextClicked" />
                    <Button Grid.Column="1" Style="{StaticResource Accent}" Text="{l:Localize lblRemoteSend}" FontSize="14"
                            WidthRequest="88" Clicked="OnSendTextClicked" />
                </Grid>
                <Label x:Name="TextHintLabel" FontSize="11" Opacity="0.5"
                       Text="{l:Localize lblRemoteTextHint}" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
