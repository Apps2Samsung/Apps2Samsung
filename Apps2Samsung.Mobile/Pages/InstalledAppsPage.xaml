<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             xmlns:controls="clr-namespace:Apps2Samsung.Mobile.Controls"
             x:Class="Apps2Samsung.Mobile.Pages.InstalledAppsPage"
             Title="{l:Localize lblInstalledApps}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgColor}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- The top bar (#755): the TV with ▾, how many apps and how much space (or what is going on),
             and ⋯ with Refresh / TV information / Remove leftover. -->
        <controls:TopBarView x:Name="TopBar" Grid.Row="0" TvTitle="True" Action="More"
                             TitleTapped="OnChangeTvClicked" MoreTapped="OnMoreClicked" />

        <!-- The apps as a grouped list (#755): tile, name, version and size, a chevron; a row opens
             the app's sheet with Launch / Stop / Debug console / Uninstall. -->
        <Border Grid.Row="1" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource SurfaceColor}"
                VerticalOptions="Start" Margin="16,4,16,0">
            <RefreshView x:Name="Refresher" Refreshing="OnPulledToRefresh" RefreshColor="{DynamicResource AccentColor}">
            <CollectionView x:Name="AppsList" SelectionMode="None" VerticalScrollBarVisibility="Never">
                <CollectionView.EmptyView>
                    <Label x:Name="EmptyLabel" Text="{l:Localize lblNoAppsToShow}" Padding="16,14"
                           TextColor="{DynamicResource MutedColor}" LineBreakMode="WordWrap" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="0">
                            <BoxView HeightRequest="1" Margin="16,0,0,0" Color="{DynamicResource HairColor}" />
                            <Grid ColumnDefinitions="44,*,Auto,Auto" ColumnSpacing="12" Padding="16,11" MinimumHeightRequest="52">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRowTapped" />
                                </Grid.GestureRecognizers>
                                <Grid Grid.Column="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="{Binding FallbackColor}"
                                            IsVisible="{Binding MissingIcon}">
                                        <Label Text="{Binding Initials}" TextColor="{DynamicResource OnAccentColor}" FontSize="20" FontAttributes="Bold"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Image Source="{Binding IconUrl}" Aspect="AspectFill" IsVisible="{Binding HasIcon}">
                                        <Image.Clip>
                                            <RoundRectangleGeometry CornerRadius="11" Rect="0,0,44,44" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Subline}" FontSize="13" TextColor="{DynamicResource MutedColor}" LineBreakMode="TailTruncation" />
                                    <!-- What the catalog says about this app, when it is in there (#820). -->
                                    <Label Text="{Binding CatalogLine}" IsVisible="{Binding HasCatalogLine}" FontSize="12"
                                           TextColor="{DynamicResource MutedColor}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="{l:Localize lblUpdate}" IsVisible="{Binding HasUpdate}" Clicked="OnUpdateClicked"
                                        HeightRequest="32" MinimumHeightRequest="32" CornerRadius="16" Padding="12,0" FontSize="13" FontAttributes="Bold"
                                        BackgroundColor="{DynamicResource AccentColor}" TextColor="{DynamicResource OnAccentColor}" VerticalOptions="Center" />
                                <Path Grid.Column="3" Data="M1,1 L7,6.5 L1,12" Stroke="{DynamicResource InkBrush}" StrokeThickness="2"
                                      Opacity="0.35" WidthRequest="8" HeightRequest="13" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            </RefreshView>
        </Border>

        <!-- Busy overlay -->
        <ActivityIndicator Grid.Row="1" x:Name="Busy" IsRunning="False" IsVisible="False"
                           VerticalOptions="Center" HorizontalOptions="Center" Color="{DynamicResource AccentColor}" />

        <Label Grid.Row="2" Text="{l:Localize lblPullToRefresh}" Style="{StaticResource Footnote}"
               HorizontalOptions="Center" Margin="0,4,0,12" />

    </Grid>

</ContentPage>
