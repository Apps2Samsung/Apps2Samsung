<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             xmlns:controls="clr-namespace:Apps2Samsung.Mobile.Controls"
             x:Class="Apps2Samsung.Mobile.Pages.InstalledAppsPage"
             Title="{l:Localize lblInstalledApps}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgColor}">

    <ContentPage.Resources>
        <controls:IconSourceConverter x:Key="IconSource" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- The top bar (#755): the TV with ▾, how many apps and how much space (or what is going on),
             and ⋯ with Refresh / TV information / Remove leftover. -->
        <controls:TopBarView x:Name="TopBar" Grid.Row="0" TvTitle="True" Action="More"
                             TitleTapped="OnChangeTvClicked" MoreTapped="OnMoreClicked" />

        <!-- The apps as a grouped list (#755): tile, name, version and size, a chevron; a row opens
             the app's sheet with Launch / Stop / Debug console / Uninstall. -->
        <!-- apps on this TV that moved to their author's repository (#1018): filled in code, one card each -->
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <!-- Host PC IP 127.0.0.1 and TV-Store closed: the list comes through TV-Store's relay, so say
                 so and open TV-Store on the TV from here (#1041 follow-up) -->
            <Border x:Name="RelayNotice" IsVisible="False" Margin="16,4,16,0" Padding="14,12" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" Stroke="{DynamicResource WarnBrush}" BackgroundColor="{DynamicResource WarnSoftColor}">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="RelayNoticeLabel" FontSize="15" LineBreakMode="WordWrap" TextColor="{DynamicResource InkColor}"
                           Text="{l:Localize lblOnTvRelayClosed}" />
                    <Button x:Name="OpenTvStoreBtn" Style="{StaticResource PrimaryButton}" HeightRequest="44" MinimumHeightRequest="44"
                            Text="{l:Localize lblOpenTvStore}" Clicked="OnOpenTvStoreClicked" />
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout x:Name="MovedHost" Spacing="8" Margin="16,4,16,4" IsVisible="False" />
            <!-- Restore a TV (#1069): apps of this TV's saved list are gone, so offer them again. -->
            <Border x:Name="RestoreCard" IsVisible="False" Margin="16,4,16,0" Padding="16" StrokeThickness="5"
                    StrokeShape="RoundRectangle 18" Stroke="{DynamicResource BezelBrush}" BackgroundColor="{DynamicResource GlassColor}">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="RestoreTitle" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource GlassInkColor}" />
                    <Label x:Name="RestoreText" FontSize="13" LineBreakMode="WordWrap" TextColor="{DynamicResource GlassMutedColor}" />
                    <Label x:Name="RestoreNames" FontSize="13" LineBreakMode="WordWrap" TextColor="{DynamicResource GlassMutedColor}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="{l:Localize lblRestoreNotNow}" HeightRequest="44" MinimumHeightRequest="44" CornerRadius="12"
                                Padding="16,0" BackgroundColor="Transparent" BorderWidth="1" BorderColor="{DynamicResource GlassMutedColor}"
                                TextColor="{DynamicResource GlassInkColor}" Clicked="OnRestoreNotNowClicked" />
                        <Button x:Name="RestoreButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" HeightRequest="44"
                                MinimumHeightRequest="44" CornerRadius="12" Clicked="OnRestoreClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <!-- Update all (#1067): while apps have a newer version in the catalog. -->
            <Border x:Name="UpdatesCard" IsVisible="False" Margin="16,4,16,0" Padding="14,12" StrokeThickness="0"
                    StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource OkSoftColor}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label x:Name="UpdatesTitle" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource InkColor}" />
                        <Label x:Name="UpdatesNames" FontSize="13" LineBreakMode="WordWrap" TextColor="{DynamicResource MutedColor}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" HeightRequest="44" MinimumHeightRequest="44"
                            VerticalOptions="Center" Text="{l:Localize lblUpdateAll}" Clicked="OnUpdateAllClicked" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <Border Grid.Row="2" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource SurfaceColor}"
                VerticalOptions="Start" Margin="16,4,16,0">
            <RefreshView x:Name="Refresher" Refreshing="OnPulledToRefresh" RefreshColor="{DynamicResource AccentColor}">
            <CollectionView x:Name="AppsList" SelectionMode="None" VerticalScrollBarVisibility="Never">
                <CollectionView.EmptyView>
                    <Label x:Name="EmptyLabel" Text="{l:Localize lblNoAppsToShow}" Padding="16,14"
                           TextColor="{DynamicResource MutedColor}" LineBreakMode="WordWrap" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="0">
                            <BoxView HeightRequest="1" Margin="16,0,0,0" Color="{DynamicResource HairColor}" />
                            <Grid ColumnDefinitions="44,*,Auto,Auto" ColumnSpacing="12" Padding="16,11" MinimumHeightRequest="52">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRowTapped" />
                                </Grid.GestureRecognizers>
                                <Grid Grid.Column="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="{Binding FallbackColor}"
                                            IsVisible="{Binding MissingIcon}">
                                        <Label Text="{Binding Initials}" TextColor="{DynamicResource OnAccentColor}" FontSize="20" FontAttributes="Bold"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Image Source="{Binding IconUrl, Converter={StaticResource IconSource}}" Aspect="AspectFill" IsVisible="{Binding HasIcon}">
                                        <Image.Clip>
                                            <RoundRectangleGeometry CornerRadius="11" Rect="0,0,44,44" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Subline}" FontSize="13" TextColor="{DynamicResource MutedColor}" LineBreakMode="TailTruncation" />
                                    <!-- What the catalog says about this app, when it is in there (#820). -->
                                    <!-- Removed from the catalogue (#1033, direction C): the same quiet line with an amber mark; the sheet says why. -->
                                    <HorizontalStackLayout Spacing="5" IsVisible="{Binding HasCatalogLine}">
                                        <Grid WidthRequest="12" HeightRequest="12" VerticalOptions="Center" IsVisible="{Binding IsRemoved}">
                                            <Ellipse Stroke="{DynamicResource WarnBrush}" StrokeThickness="1.4" />
                                            <Label Text="!" FontSize="9" FontAttributes="Bold" TextColor="{DynamicResource WarnColor}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="{Binding CatalogLine}" FontSize="12"
                                               TextColor="{DynamicResource MutedColor}" LineBreakMode="TailTruncation" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="{l:Localize lblUpdate}" IsVisible="{Binding HasUpdate}" Clicked="OnUpdateClicked"
                                        HeightRequest="32" MinimumHeightRequest="32" CornerRadius="16" Padding="12,0" FontSize="13" FontAttributes="Bold"
                                        BackgroundColor="{DynamicResource AccentColor}" TextColor="{DynamicResource OnAccentColor}" VerticalOptions="Center" />
                                <Path Grid.Column="3" Data="M1,1 L7,6.5 L1,12" Stroke="{DynamicResource InkBrush}" StrokeThickness="2"
                                      Opacity="0.35" WidthRequest="8" HeightRequest="13" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            </RefreshView>
        </Border>

        <!-- Busy overlay -->
        <ActivityIndicator Grid.Row="2" x:Name="Busy" IsRunning="False" IsVisible="False"
                           VerticalOptions="Center" HorizontalOptions="Center" Color="{DynamicResource AccentColor}" />

        <Label Grid.Row="3" Text="{l:Localize lblPullToRefresh}" Style="{StaticResource Footnote}"
               HorizontalOptions="Center" Margin="0,4,0,12" />

    </Grid>

</ContentPage>
