<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             x:Class="Apps2Samsung.Mobile.Pages.InstalledAppsPage"
             Title="{l:Localize lblInstalledApps}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgColor}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,10,16,0" RowSpacing="8">

        <!-- A tab root (#755): page title, its actions as round icon buttons -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="4,8,4,0">
            <Label Grid.Column="0" Text="{l:Localize lblOnTheTv}" Style="{StaticResource PageTitle}" />
            <Button Grid.Column="1" x:Name="RemoveLeftoverBtn" Text="{l:Localize lblRemoveLeftover}" FontSize="12"
                    Style="{StaticResource IconButton}" WidthRequest="-1" MinimumWidthRequest="36" Padding="12,0" CornerRadius="18"
                    Clicked="OnRemoveLeftoverClicked" />
            <Button Grid.Column="2" x:Name="RefreshBtn" Text="⟳" Style="{StaticResource IconButton}" Clicked="OnRefreshClicked" />
        </Grid>

        <!-- which TV, how many apps, or what went wrong -->
        <Label Grid.Row="1" x:Name="CountLabel" Style="{StaticResource Footnote}" Text="{l:Localize lblLoading}" LineBreakMode="WordWrap" />

        <!-- The apps as a grouped list (#755): tile, name, version and size, a chevron; a row opens
             the app's sheet with Launch / Stop / Debug console / Uninstall. -->
        <Border Grid.Row="2" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource SurfaceColor}"
                VerticalOptions="Start" Margin="0,0,0,16">
            <CollectionView x:Name="AppsList" SelectionMode="None" VerticalScrollBarVisibility="Never">
                <CollectionView.EmptyView>
                    <Label x:Name="EmptyLabel" Text="{l:Localize lblNoAppsToShow}" Padding="16,14"
                           TextColor="{DynamicResource MutedColor}" LineBreakMode="WordWrap" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="0">
                            <BoxView HeightRequest="1" Margin="16,0,0,0" Color="{DynamicResource HairColor}" />
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12" Padding="16,11" MinimumHeightRequest="52">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRowTapped" />
                                </Grid.GestureRecognizers>
                                <Grid Grid.Column="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="{Binding FallbackColor}"
                                            IsVisible="{Binding MissingIcon}">
                                        <Label Text="{Binding Initials}" TextColor="{DynamicResource OnAccentColor}" FontSize="20" FontAttributes="Bold"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Image Source="{Binding IconUrl}" Aspect="AspectFill" IsVisible="{Binding HasIcon}">
                                        <Image.Clip>
                                            <RoundRectangleGeometry CornerRadius="11" Rect="0,0,44,44" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Subline}" FontSize="13" TextColor="{DynamicResource MutedColor}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Path Grid.Column="2" Data="M1,1 L7,6.5 L1,12" Stroke="{DynamicResource InkBrush}" StrokeThickness="2"
                                      Opacity="0.35" WidthRequest="8" HeightRequest="13" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- Busy overlay -->
        <ActivityIndicator Grid.Row="2" x:Name="Busy" IsRunning="False" IsVisible="False"
                           VerticalOptions="Center" HorizontalOptions="Center" Color="{DynamicResource AccentColor}" />

    </Grid>

</ContentPage>
