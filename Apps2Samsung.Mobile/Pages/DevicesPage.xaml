<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Apps2Samsung.Mobile.Pages"
             x:Class="Apps2Samsung.Mobile.Pages.DevicesPage"
             Title="Apps2Samsung">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="14">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Install to a TV" Style="{StaticResource Headline}" />
            <Label Text="Pick a Samsung TV on your Wi-Fi. Enable Developer Mode on the TV first."
                   Style="{StaticResource SubHeadline}" />
        </VerticalStackLayout>

        <Button Grid.Row="1" x:Name="ScanBtn" Text="Scan again" Clicked="OnScanClicked" HorizontalOptions="Fill" />

        <RefreshView Grid.Row="2" x:Name="Refresh" Refreshing="OnRefreshing">
            <CollectionView x:Name="DevicesView" SelectionMode="Single" SelectionChanged="OnDeviceSelected">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="0,50" Spacing="8">
                        <Label x:Name="EmptyLabel" Text="No TVs found yet." HorizontalOptions="Center" Opacity="0.7" />
                        <Label Text="Pull down or tap “Scan again”." HorizontalOptions="Center" FontSize="13" Opacity="0.5" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:DeviceItem">
                        <Border Margin="0,5" Padding="16" StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#E2E2E2, Dark=#3A3A3A}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0" Grid.Row="0" Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                                <Label Grid.Column="0" Grid.Row="1" Text="{Binding IpAddress}" FontSize="13" Opacity="0.6" />
                                <Label Grid.Column="1" Grid.RowSpan="2" Text="{Binding Badge}"
                                       TextColor="{Binding BadgeColor}" VerticalOptions="Center" FontSize="13" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
