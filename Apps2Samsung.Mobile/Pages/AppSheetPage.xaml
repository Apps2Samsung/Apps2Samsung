<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             x:Class="Apps2Samsung.Mobile.Pages.AppSheetPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BgColor}">
    <!-- The app sheet (#755): preview, description (#835), category line, the version or variant to install, Install.
         A modal page drawn as a bottom sheet: grabber, title with a close button, grouped content. -->
    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,24" Spacing="10">
            <BoxView WidthRequest="36" HeightRequest="5" CornerRadius="3" HorizontalOptions="Center"
                     Color="{DynamicResource HairColor}" />
            <Grid ColumnDefinitions="*,Auto,32,32" ColumnSpacing="8" Margin="0,6,0,0">
                <Label x:Name="TitleLabel" FontSize="20" FontAttributes="Bold" LineBreakMode="WordWrap" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <!-- adult-only (#850) -->
                    <Border x:Name="AdultBadge" IsVisible="False" StrokeThickness="1" StrokeShape="RoundRectangle 7"
                            Stroke="{DynamicResource WarnBrush}" BackgroundColor="{DynamicResource WarnSoftColor}" Padding="7,2" VerticalOptions="Center">
                        <Label Text="{l:Localize lblAdultBadge}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource WarnColor}" />
                    </Border>
                    <!-- gains root on the TV: the install asks first -->
                    <Border x:Name="RootBadge" IsVisible="False" StrokeThickness="1" StrokeShape="RoundRectangle 7"
                            Stroke="{DynamicResource WarnBrush}" BackgroundColor="{DynamicResource WarnSoftColor}" Padding="7,2" VerticalOptions="Center">
                        <Label Text="{l:Localize lblRootBadge}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource WarnColor}" />
                    </Border>
                    <!-- the Tizen the selected build asks for (TV-Store#47); warning colours when this TV is too old for it -->
                    <Border x:Name="TizenBadge" IsVisible="False" StrokeThickness="1" StrokeShape="RoundRectangle 7"
                            Stroke="{DynamicResource HairBrush}" BackgroundColor="{DynamicResource FillColor}" Padding="7,2" VerticalOptions="Center">
                        <Label x:Name="TizenBadgeLabel" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource MutedColor}" />
                    </Border>
                </HorizontalStackLayout>
                <!-- the star: a favorite leads the Install tab's list -->
                <Button Grid.Column="2" x:Name="FavoriteBtn" Text="☆" FontSize="18" WidthRequest="32" HeightRequest="32" CornerRadius="16" Padding="0"
                        MinimumWidthRequest="32" MinimumHeightRequest="32"
                        BackgroundColor="{DynamicResource FillColor}" TextColor="{DynamicResource InkColor}" Clicked="OnFavoriteClicked" />
                <Button Grid.Column="3" Text="✕" FontSize="13" WidthRequest="32" HeightRequest="32" CornerRadius="16" Padding="0"
                        MinimumWidthRequest="32" MinimumHeightRequest="32"
                        BackgroundColor="{DynamicResource FillColor}" TextColor="{DynamicResource InkColor}" Clicked="OnCloseClicked" />
            </Grid>

            <Border x:Name="PreviewFrame" IsVisible="False" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                    BackgroundColor="{DynamicResource FillColor}" HeightRequest="190">
                <Image x:Name="PreviewImage" Aspect="AspectFill" />
            </Border>

            <!-- what the app is, from the catalog (#835); then the category line the list row shows -->
            <Label x:Name="DescriptionLabel" TextColor="{DynamicResource InkColor}" LineBreakMode="WordWrap" IsVisible="False" />
            <Label x:Name="SublineLabel" TextColor="{DynamicResource MutedColor}" LineBreakMode="WordWrap" />
            <!-- who makes it and where its source, releases and licence live (#820) -->
            <Label x:Name="SourceLabel" FontSize="13" TextColor="{DynamicResource MutedColor}" IsVisible="False" />

            <Border x:Name="PartnerNotice" IsVisible="False" StrokeThickness="1" StrokeShape="RoundRectangle 10"
                    Stroke="{DynamicResource WarnBrush}" BackgroundColor="{DynamicResource WarnSoftColor}" Padding="12,10">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{l:Localize lblPartnerNeededTitle}" FontAttributes="Bold" TextColor="{DynamicResource WarnColor}" />
                    <Label Text="{l:Localize lblPartnerNeededBody}" FontSize="13" TextColor="{DynamicResource WarnColor}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- another package id on this TV (#839), for a set that has this app's own id blocked -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4,4,4,0">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{l:Localize lblNewPackageId}" FontSize="13" />
                    <Label Text="{l:Localize lblNewPackageIdHint}" FontSize="12" TextColor="{DynamicResource MutedColor}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" x:Name="NewIdSwitch" OnColor="{DynamicResource AccentColor}" VerticalOptions="Center" Toggled="OnNewIdToggled" />
            </Grid>

            <!-- back to the package's own id (#839): only for an app that was renamed on a TV before -->
            <Grid x:Name="OwnIdRow" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4,4,4,0" IsVisible="False">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{l:Localize lblOwnPackageId}" FontSize="13" />
                    <Label Text="{l:Localize lblOwnPackageIdHint}" FontSize="12" TextColor="{DynamicResource MutedColor}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
                <Switch Grid.Column="1" x:Name="OwnIdSwitch" OnColor="{DynamicResource AccentColor}" VerticalOptions="Center" Toggled="OnOwnIdToggled" />
            </Grid>

            <!-- the Version header; "Show all versions" on the right for an app that has older
                 releases to offer (it reloads the catalog, so it is remembered as a setting) -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="4,10,4,0">
                <Label x:Name="VersionsTitle" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource MutedColor}"
                       VerticalOptions="Center" />
                <Label Grid.Column="1" x:Name="PublishedLabel" FontSize="15" TextColor="{DynamicResource MutedColor}"
                       VerticalOptions="Center" />
                <Label Grid.Column="1" x:Name="ShowAllLabel" Text="{l:Localize lblShowAllJellyfinVersions}" FontSize="13"
                       VerticalOptions="Center" IsVisible="False" />
                <Switch Grid.Column="2" x:Name="ShowAllSwitch" OnColor="{DynamicResource AccentColor}" VerticalOptions="Center"
                        IsVisible="False" Toggled="OnShowAllToggled" />
            </Grid>
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource SurfaceColor}">
                <VerticalStackLayout x:Name="Versions" />
            </Border>

            <!-- why Install is off: this TV is too old for the selected build (TV-Store#47) -->
            <Border x:Name="TizenHintFrame" IsVisible="False" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                    BackgroundColor="{DynamicResource WarnSoftColor}" Padding="12,8">
                <Label x:Name="TizenHint" FontSize="13" LineBreakMode="WordWrap" TextColor="{DynamicResource WarnColor}" />
            </Border>
            <Button x:Name="InstallBtn" Clicked="OnInstallClicked" CornerRadius="12" HeightRequest="50" Margin="0,6,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
